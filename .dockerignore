!Utils/**

# Throwaway test Identity Server (name ends in "Test", so it needs an explicit
# override to escape the "**/*Test/" rule above).
!Servers/IdentityServer/DevTest/
!Servers/IdentityServer/DevTest/**

# Last-match-wins: !project/** above would otherwise re-include host bin/obj
