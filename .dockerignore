!Servers/ConnectomeDataModelCore/**
!gRPCAnnotationServiceTypes/
!gRPCAnnotationServiceTypes/**
!Geometry.Core/
!Geometry.Core/**
!GeometrySqlTypeMapper/
!GeometrySqlTypeMapper/**
