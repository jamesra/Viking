<Project Sdk="Microsoft.NET.Sdk">

  <!-- Client stubs only, protocol V2: Viking (net48) calls the section-correction service. Package versions match gRPCAnnotationServiceTypes. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Viking.SectionCorrectionServiceTypes.gRPC.V2</RootNamespace>
    <AssemblyName>SectionCorrectionServiceTypes.gRPC</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.19.1" />
    <PackageReference Include="Grpc.Core.Api" Version="2.43.0" />
    <PackageReference Include="Grpc.Tools" Version="2.43.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\gRPC_Protos\SectionCorrection\section_correction_v2.proto" GrpcServices="Client" />
  </ItemGroup>

</Project>
