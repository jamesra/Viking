<Project Sdk="Microsoft.NET.Sdk">

  <!--
    net10.0 builds client and server stubs for GrpcSectionCorrectionService.
    netstandard2.0 builds the client only, so the net48 Viking client can call the service.
    section_correction_v2.proto imports Common/geometry.proto through ProtoRoot; GeometryTypes.gRPC compiles it, not here.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Viking.SectionCorrectionServiceTypes.gRPC.V2</RootNamespace>
    <AssemblyName>SectionCorrectionServiceTypes.gRPC</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\gRPCGeometryTypes\GeometryTypes.gRPC.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
    <Protobuf Include="..\gRPC_Protos\SectionCorrection\section_correction_v2.proto" ProtoRoot="..\gRPC_Protos" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Grpc.Core.Api" Version="2.38.0" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <Protobuf Include="..\gRPC_Protos\SectionCorrection\section_correction_v2.proto" ProtoRoot="..\gRPC_Protos" GrpcServices="Client" />
  </ItemGroup>

</Project>
