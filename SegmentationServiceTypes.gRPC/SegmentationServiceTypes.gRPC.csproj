<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
    <RootNamespace>Viking.SegmentationServiceTypes.gRPC.V1</RootNamespace>
    <AssemblyName>SegmentationServiceTypes.gRPC</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="..\gRPC_Protos\Segmentation\SAM2\segmentation.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.17.2" />
    <PackageReference Include="Grpc.Core" Version="2.38.0" />
    <PackageReference Include="Grpc.Tools" Version="2.38.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\gRPCGeometryTypes\GeometryTypes.gRPC.csproj" />
  </ItemGroup>

  <!-- Common/geometry.proto is imported through ProtoRoot and compiled by GeometryTypes.gRPC, not here. -->
  <ItemGroup>
    <Protobuf Include="..\gRPC_Protos\Segmentation\SAM2\segmentation.proto" ProtoRoot="..\gRPC_Protos" GrpcServices="Client" />
  </ItemGroup>

</Project>
