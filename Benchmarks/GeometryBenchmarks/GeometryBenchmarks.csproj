<Project Sdk="Microsoft.NET.Sdk">
  <!-- BenchmarkDotNet micro-benchmarks for transforms, the RTree and polygons. Uses the RC2 files that
       VikingVolumeBench prime saved, so run that first. See ..\VikingVolumeBench\README.md. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Viking.Benchmarks.Geometry</RootNamespace>
    <AssemblyName>GeometryBenchmarks</AssemblyName>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>x64</PlatformTarget>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Geometry.Core\Geometry.Core.csproj" />
    <ProjectReference Include="..\..\Geometry\Geometry.csproj" />
    <ProjectReference Include="..\..\RTree\RTree.csproj" />
  </ItemGroup>
</Project>
