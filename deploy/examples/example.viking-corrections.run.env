# viking-corrections run env -> <root>/Run/viking-corrections/viking-corrections.run.env  (web host)
# Used both for compose interpolation and as the container environment. TLS_CERT_NAME comes from host.env.

# OPTIONAL  Run a prebuilt image from GHCR instead of building on this host.
# Default viking-corrections:latest, built locally.
#SECTION_CORRECTION_IMAGE=ghcr.io/jamesra/viking-corrections:latest

# REQUIRED  Identity issuer and permissions WebApi, both on 443 through viking-proxy (WebApi under /webapi/).
IdentityServer__Endpoint=https://identity.connectomes.pitt.edu/
# OPTIONAL  Defaults to the Endpoint above.
IdentityServer__ApiEndpoint=https://identity.connectomes.pitt.edu/webapi/
# OPTIONAL  Identity client id; keep "correction".
IdentityServer__ClientId=correction
# REQUIRED  Generate locally; must equal CORRECTION_SERVICE_CLIENT_SECRET in the viking-identity run env.
IdentityServer__ClientSecret=REPLACE_WITH_GENERATED_SECRET
# REQUIRED  Name of the CorrectionService resource created in the Identity management site.
CorrectionService__Name=REPLACE_WITH_CORRECTION_SERVICE_NAME

# OPTIONAL  Direct SQL per annotation database (faster than the OData fallback). SQL login from the
# SQL Server administrator.
#AnnotationConnections__RC1=Server=sql.internal.example,1433;Database=RC1;User ID=REPLACE_WITH_SQL_LOGIN;Password=REPLACE_WITH_SQL_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true
# OPTIONAL  Fallback for databases missing above; {VolumeName} is replaced.
#AnnotationConnectionTemplate=Server=sql.internal.example,1433;Database={VolumeName};User ID=REPLACE_WITH_SQL_LOGIN;Password=REPLACE_WITH_SQL_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true

# OPTIONAL  Rebuild schedule (5-field cron, UTC) and options.
Rebuild__RunOnStartup=true
Rebuild__Cron=0 2 * * 0
Rebuild__Force=false
Rebuild__SkipQuiver=false
Rebuild__MinLocations=3

# OPTIONAL  Development keeps today's container behaviour.
ASPNETCORE_ENVIRONMENT=Development
# OPTIONAL  Host ports (VIKING_UPSTREAM_CORRECTIONS points at the TLS one).
#SECTION_CORRECTION_HTTP_PORT=41080
#SECTION_CORRECTION_HTTPS_PORT=41443
# OPTIONAL  Host folders holding corrections/ and cache/. Default <STACK_DATA_DIR>.
#GRPC_ANNOTATION_CORRECTIONS_PATH=
#SECTION_CORRECTION_CONFIG_PATH=
