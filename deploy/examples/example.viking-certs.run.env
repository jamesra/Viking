# viking-certs run env -> <root>/Run/viking-certs/viking-certs.run.env
# Web host: letsencrypt or acme-eab. Compute host: manual (fed a copy of the web host's Certs/).
# TLS_CERT_NAME and the hostnames come from host.env.

# OPTIONAL  Run a prebuilt image from GHCR instead of building on this host.
# Default viking-certs:latest, built locally.
#VIKING_CERTS_IMAGE=ghcr.io/jamesra/viking-certs:latest

# REQUIRED  letsencrypt | acme-eab | manual. Switching: Documentation/source/deployment/tls.rst.
TLS_MODE=letsencrypt

# REQUIRED for letsencrypt/acme-eab  Contact address for expiry notices (a Pitt group mailbox).
TLS_EMAIL=viking-admins@example.edu

# OPTIONAL  Comma list of names on the certificate. Empty = every VIKING_HOSTNAME_* in host.env.
# With HTTP-01 every listed name must already resolve to the web host, or the whole order fails.
TLS_HOSTNAMES=

# OPTIONAL  1 = Let's Encrypt staging (untrusted certificate, no rate limits) while testing.
TLS_STAGING=0

# OPTIONAL  Hours between renewal checks.
TLS_RENEW_INTERVAL_HOURS=12

# OPTIONAL  Password for cert.pfx (IIS import). Empty = no password.
TLS_PFX_PASSWORD=

# acme-eab only: see example.tls-eab.env for TLS_ACME_SERVER, TLS_EAB_KID, TLS_EAB_HMAC_KEY.

# OPTIONAL  rsa | ecdsa. Keep rsa while the legacy IIS/WCF host uses the certificate.
#TLS_KEY_TYPE=rsa
# OPTIONAL  manual mode: seconds between checks for new PEM files.
#TLS_MANUAL_POLL_SECONDS=300
# OPTIONAL  Host folder of the HTTP-01 webroot (shared with viking-proxy). Default <STACK_DATA_DIR>/webroot.
#VIKING_ACME_WEBROOT=
# OPTIONAL  Docker socket used to restart viking.tls-reload containers.
#DOCKER_SOCKET_PATH=/var/run/docker.sock
