# viking-certs run env -> <root>/Run/viking-certs/viking-certs.run.env
# Web host: letsencrypt or acme-eab. Compute host: manual (fed a copy of the web host's Certs/).
# The certificate itself is set host-wide in host.env, because `stack.ps1 certs` reads it too:
# TLS_MODE, TLS_EMAIL, TLS_CERT_NAME, TLS_HOSTNAMES, TLS_STAGING, TLS_PFX_PASSWORD, TLS_ACME_SERVER,
# and VIKING_ACME_WEBROOT. (Values set here still win over host.env.) This file holds the renewer's own settings.

# OPTIONAL  Run a prebuilt image from GHCR instead of building on this host.
# Default viking-certs:latest, built locally.
#VIKING_CERTS_IMAGE=ghcr.io/jamesra/viking-certs:latest

# OPTIONAL  Hours between renewal checks.
TLS_RENEW_INTERVAL_HOURS=12

# acme-eab only: see example.tls-eab.env for TLS_EAB_KID, TLS_EAB_HMAC_KEY.

# OPTIONAL  rsa | ecdsa. Keep rsa while the legacy IIS/WCF host uses the certificate.
#TLS_KEY_TYPE=rsa
# OPTIONAL  manual mode: seconds between checks for new PEM files.
#TLS_MANUAL_POLL_SECONDS=300
# OPTIONAL  Docker socket used to restart viking.tls-reload containers.
#DOCKER_SOCKET_PATH=/var/run/docker.sock
