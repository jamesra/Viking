# viking-proxy run env -> <root>/Run/viking-proxy/viking-proxy.run.env  (web host)
# Hostnames, VIKING_COMPUTE_HOST and VIKING_IIS_HOST come from host.env (example.viking-host.env).
# Every key here is optional: the defaults route web-host services to host.docker.internal,
# segmentation to VIKING_COMPUTE_HOST and websvc to VIKING_IIS_HOST.

# OPTIONAL  Per-service upstream override, host:port of the service's own TLS port.
#VIKING_UPSTREAM_IDENTITY=host.docker.internal:5001
#VIKING_UPSTREAM_ANNOTATION=host.docker.internal:5011
#VIKING_UPSTREAM_CORRECTIONS=host.docker.internal:41443
#VIKING_UPSTREAM_GALLERY=host.docker.internal:8442
#VIKING_UPSTREAM_TEM_GALLERY=host.docker.internal:8442
#VIKING_UPSTREAM_SEM_GALLERY=host.docker.internal:8442
#VIKING_UPSTREAM_SEGMENTATION=compute.internal.example:40443
#VIKING_UPSTREAM_SEGMENTATIONDEMO=compute.internal.example:40444
#VIKING_UPSTREAM_SEG_V3=compute.internal.example:40445
#VIKING_UPSTREAM_SEG_V4=compute.internal.example:40446
#VIKING_UPSTREAM_SEG_SEM_V1=compute.internal.example:40447
#VIKING_UPSTREAM_WEBSVC=iis.internal.example:443
# OPTIONAL  Where TLS for an unknown SNI name goes. Default: the IIS host on 443.
#VIKING_UPSTREAM_DEFAULT=iis.internal.example:443

# OPTIONAL  host:port for plain HTTP to IIS (e.g. iis.internal.example:80). Set it while Viking
# clients still use http:// websvc URLs; empty redirects websvc on port 80 to https like every other name.
VIKING_HTTP_UPSTREAM_WEBSVC=

# OPTIONAL  Host ports (change only on a dev box where 80/443 are taken).
#PROXY_HTTP_PORT=80
#PROXY_HTTPS_PORT=443
# OPTIONAL  nginx image tag.
#PROXY_NGINX_TAG=stable
# OPTIONAL  DNS resolver for upstream names. Docker's embedded DNS by default.
#PROXY_RESOLVER=127.0.0.11
# OPTIONAL  Host folder of the HTTP-01 webroot. Default <root>/Data/viking-certs/webroot.
#VIKING_ACME_WEBROOT=
