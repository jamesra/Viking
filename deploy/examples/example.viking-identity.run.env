# viking-identity run env -> <root>/Run/viking-identity/viking-identity.run.env  (web host)
# Used both for compose interpolation and as the container environment.
# Also needed in Run/viking-identity/secrets/:
#   secrets.json        from deploy/examples/example.secrets.json (SMTP settings)
#   Duende_License.key  Duende IdentityServer license, from your account at duendesoftware.com
# VIKING_HOSTNAME_IDENTITY and TLS_CERT_NAME come from host.env.

# OPTIONAL  Run a prebuilt image from GHCR instead of building on this host.
# Default viking-identity:latest, built locally.
#VIKING_IDENTITY_IMAGE=ghcr.io/jamesra/viking-identity:latest

# REQUIRED  Production on the server; Development turns on the remote debugger and PII logging.
ASPNETCORE_ENVIRONMENT=Production
# OPTIONAL  Picks appsettings.<HOSTING_ENVIRONMENT>.json; keep Docker.
HOSTING_ENVIRONMENT=Docker
# OPTIONAL  Release or Debug build of the image.
BUILD_CONFIGURATION=Release
# OPTIONAL  true opens the VS remote debugger on REMOTE_DEBUG_PORT (loopback only by default).
IDENTITY_ENABLE_REMOTE_DEBUG=false

# --- SQL Server (identity databases; external server, see deployment/sql) ---
# REQUIRED  SQL Server host as the container reaches it (DNS name or IP).
SQL_SERVER_HOST=sql.internal.example
# OPTIONAL  SQL Server port.
SQL_SERVER_PORT=1433
# REQUIRED  SQL login with rights on the three databases below.
SQL_SERVER_USER=REPLACE_WITH_SQL_LOGIN
# REQUIRED  Password of that login (from the SQL Server administrator).
SQL_SERVER_PASSWORD=REPLACE_WITH_SQL_PASSWORD
# REQUIRED  Database names; use the names of the existing identity databases.
SQL_SERVER_IDENTITY_DB=IdentityViking
SQL_SERVER_CONFIG_DB=IdentityConfig
SQL_SERVER_GRANTS_DB=IdentityGrants
# OPTIONAL  Seconds to wait for SQL at start (the DB VM may boot later than this host).
SQL_WAIT_TIMEOUT_SECONDS=900

# --- OIDC client secrets: generate locally, one per client, never reuse (e.g. openssl rand -base64 32) ---
# REQUIRED  Viking desktop client.
IDENTITY_SERVER_SECRET=REPLACE_WITH_GENERATED_SECRET
# REQUIRED  WebApi client.
IDENTITY_SERVER_API_SECRET=REPLACE_WITH_GENERATED_SECRET
# REQUIRED  Management site (mvc) client; also its introspection secret.
IDENTITY_SERVER_MVC_SECRET=REPLACE_WITH_GENERATED_SECRET
# REQUIRED  ro.viking (resource-owner) client.
IDENTITY_SERVER_RO_VIKING_SECRET=REPLACE_WITH_GENERATED_SECRET
# OPTIONAL  sbfsem-tools web client; empty leaves it unregistered. Share with the sbfsem-tools operators.
SBFSEM_TOOLS_CLIENT_SECRET=
# OPTIONAL  "correction" client; must equal IdentityServer__ClientSecret in the viking-corrections run env.
CORRECTION_SERVICE_CLIENT_SECRET=
# OPTIONAL  "segmentation" client; must equal IdentityServer__ClientSecret in the viking-segmentation run env.
SEGMENTATION_SERVICE_CLIENT_SECRET=
# OPTIONAL  SAM2 gallery clients (sam2-gallery stack); empty disables them.
GALLERY_TEM_CLIENT_SECRET=
GALLERY_SEM_CLIENT_SECRET=

# --- Public URLs (defaults derive from VIKING_HOSTNAME_IDENTITY; set only to differ) ---
# OPTIONAL  OIDC issuer/authority. Default: the host-wide VIKING_IDENTITY_URL, itself
#           https://<VIKING_HOSTNAME_IDENTITY>/ (443 through viking-proxy). Every identity client uses
#           VIKING_IDENTITY_URL, so change it in host.env rather than here.
#IDENTITY_AUTHORITY=https://identity.connectomes.pitt.edu/
# OPTIONAL  Management site URL (login page, e-mail links). Default https://<VIKING_HOSTNAME_IDENTITY>/manage/
#IDENTITY_MANAGEMENT_PUBLIC_URL=
# OPTIONAL  WebApi base URL. Default: the host-wide VIKING_IDENTITY_API_URL (https://<VIKING_HOSTNAME_IDENTITY>/webapi/).
#IDENTITY_WEBAPI_PUBLIC_URL=
# OPTIONAL  Path prefixes the proxy routes (set both empty only when using direct-port URLs above).
#IDENTITY_MANAGEMENT_PATH_BASE=/manage
#IDENTITY_WEBAPI_PATH_BASE=/webapi
# OPTIONAL  SAM2 gallery OIDC callbacks (defaults name the old codepharm hosts).
VikingIdentityServerOptions__GalleryTemRedirectUris__0=https://gallery-tem.connectomes.pitt.edu/callback
VikingIdentityServerOptions__GallerySemRedirectUris__0=https://gallery-sem.connectomes.pitt.edu/callback

# --- Ports (host = container; keep them unique on the host) ---
IDENTITY_STANDALONE_HTTPS_PORT=5001
IDENTITY_WEBAPI_HTTPS_PORT=6001
IDENTITY_MANAGEMENT_HTTPS_PORT=4001
IDENTITY_STANDALONE_CONTAINER_HTTP_PORT=5000
IDENTITY_STANDALONE_CONTAINER_HTTPS_PORT=5001
IDENTITY_WEBAPI_CONTAINER_HTTP_PORT=6000
IDENTITY_WEBAPI_CONTAINER_HTTPS_PORT=6001
IDENTITY_MANAGEMENT_CONTAINER_HTTP_PORT=4000
IDENTITY_MANAGEMENT_CONTAINER_HTTPS_PORT=4001

# OPTIONAL  Keep an existing key ring (copy the old Servers/IdentityServer/DataProtectionKeys/*.xml
# here). Default <STACK_DATA_DIR>/DataProtectionKeys.
#IDENTITY_DATA_PROTECTION_KEYS_DIR=
# OPTIONAL  Duende license elsewhere than Run/viking-identity/secrets/Duende_License.key.
#DUENDE_KEY_PATH=
