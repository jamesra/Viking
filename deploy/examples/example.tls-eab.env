# ACME with External Account Binding (InCommon / Sectigo through Pitt IT).
# Append to <root>/Run/viking-certs/viking-certs.run.env and set TLS_MODE=acme-eab there.
# Obtain the server URL, Key ID and HMAC key from Pitt IT (InCommon certificate service ACME
# enrollment for the connectomes.pitt.edu names). Treat the HMAC key as a secret.

# REQUIRED  ACME directory URL from Pitt IT (InCommon/Sectigo).
TLS_ACME_SERVER=https://acme.sectigo.example/v2/InCommonRSAOV
# REQUIRED  EAB Key ID from Pitt IT.
TLS_EAB_KID=REPLACE_WITH_EAB_KEY_ID
# REQUIRED (or TLS_EAB_HMAC_KEY_FILE)  EAB HMAC key from Pitt IT.
TLS_EAB_HMAC_KEY=REPLACE_WITH_EAB_HMAC_KEY
# OPTIONAL  Instead of the key above: a file in Run/viking-certs/secrets/, seen in the container as
# /run/secrets/viking-certs/<file>. Used only when TLS_EAB_HMAC_KEY is empty.
#TLS_EAB_HMAC_KEY_FILE=/run/secrets/viking-certs/eab_hmac_key
