# viking-iis run env -> <root>/Run/viking-iis/viking-iis.run.env
# Read by deploy/Deploy-VikingIis.ps1 (stack.ps1 exports it). VIKING_HOSTNAME_WEBSVC comes from host.env.
# No secrets: SQL connection strings stay in the IIS application settings on the IIS host.

# REQUIRED  Deployment root on the IIS host holding Release\AnnotationService and Release\Export.
# Local path when run on the IIS host, UNC path when run from the build machine.
VIKING_IIS_DEPLOY_ROOT=\\iis-host\C$\Services
# OPTIONAL  Volume folders to (re)deploy DataExport into, comma separated.
VIKING_IIS_VOLUMES=RC1,RC2
# OPTIONAL  IIS root holding the volume folders. Empty = the Default Web Site root.
VIKING_IIS_SITE_ROOT=
# OPTIONAL  Public base URL. Default https://<VIKING_HOSTNAME_WEBSVC>/
#VIKING_IIS_URL_BASE=
# OPTIONAL  Published DataExport folder. Default <VIKING_IIS_DEPLOY_ROOT>\Release\Export
#VIKING_IIS_EXPORT_SOURCE=
# OPTIONAL  ConfigureIIS.ps1 web root and site.
#VIKING_IIS_WEBROOT=C:\inetpub\wwwroot
#VIKING_IIS_SITE_NAME=Default Web Site
# OPTIONAL  cert.pfx copied from the web host's Certs/<TLS_CERT_NAME>/ for -Action Certificate.
#VIKING_IIS_PFX_PATH=C:\certs\viking\cert.pfx
