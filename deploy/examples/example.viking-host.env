# Viking keys for <root>/Run/_host/host.env (shared by every stack on a host).
# The same keys are already in nornir-docker/deploy/examples/example.host.env, which
# Initialize-DockerHost.ps1 copies; this file documents them for Viking-only readers.
# Use the same values on the web, compute and Windows dev hosts. No secrets belong here.

# REQUIRED  Parent domain. Every default hostname below is <label>.${VIKING_DOMAIN}.
VIKING_DOMAIN=connectomes.pitt.edu

# REQUIRED  Certificate directory name under DOCKER_CERTS_DIR (<root>/Certs/<name>/fullchain.pem ...).
TLS_CERT_NAME=connectomes.pitt.edu

# Public hostnames, one per service. All single-label so one *.${VIKING_DOMAIN} certificate covers them.
# Each must have a DNS record pointing at the web host (the proxy routes them by SNI).
# REQUIRED  Identity on 443: issuer at /, management site at /manage/, permissions WebApi at /webapi/.
VIKING_HOSTNAME_IDENTITY=identity.connectomes.pitt.edu
# REQUIRED  Legacy IIS (WCF annotation, OData, DataExport, tiles).
VIKING_HOSTNAME_WEBSVC=websvc.connectomes.pitt.edu
# REQUIRED  gRPC annotation service.
VIKING_HOSTNAME_ANNOTATION=annotation.connectomes.pitt.edu
# REQUIRED  gRPC section-correction service.
VIKING_HOSTNAME_CORRECTIONS=corrections.connectomes.pitt.edu
# REQUIRED  Default segmentation model.
VIKING_HOSTNAME_SEGMENTATION=segmentation.connectomes.pitt.edu
# OPTIONAL  Segmentation demo page (only when SEGMENTATION_DEMO_SITE=1).
VIKING_HOSTNAME_SEGMENTATIONDEMO=segmentationdemo.connectomes.pitt.edu
# OPTIONAL  Docker network shared by viking-proxy and the segmentation model servers on THIS host. With it the
#           proxy reaches the servers by container name and nothing is published (add
#           stacks/viking-proxy/compose.backend.yaml of connectomes-deploy to the proxy's STACK_COMPOSE_OVERLAYS).
#VIKING_BACKEND_NETWORK=viking-backend
# OPTIONAL  SAM2 galleries (sam2-gallery stack, outside this repo).
VIKING_HOSTNAME_GALLERY=gallery.connectomes.pitt.edu
VIKING_HOSTNAME_TEM_GALLERY=gallery-tem.connectomes.pitt.edu
VIKING_HOSTNAME_SEM_GALLERY=gallery-sem.connectomes.pitt.edu

# REQUIRED (web host)  LAN address or DNS name of the GPU compute host, as the proxy reaches it.
VIKING_COMPUTE_HOST=compute.internal.example
# REQUIRED (web host)  LAN address or DNS name of the legacy Windows IIS host.
VIKING_IIS_HOST=iis.internal.example
