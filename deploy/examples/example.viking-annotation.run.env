# viking-annotation run env -> <root>/Run/viking-annotation/viking-annotation.run.env  (web host)
# Used both for compose interpolation and as the gRPC service's container environment
# (ASP.NET Core reads Section__Key as Section:Key). TLS_CERT_NAME comes from host.env.

# OPTIONAL  Run a prebuilt image from GHCR instead of building on this host.
# Default viking-annotation:latest, built locally.
#VIKING_ANNOTATION_IMAGE=ghcr.io/jamesra/viking-annotation:latest

# REQUIRED  Annotation SQL Server. SQL auth: the Linux container has no Windows/Kerberos identity.
# External server (production):
ConnectionStrings__AnnotationConnection=Server=sql.internal.example,1433;Database=REPLACE_WITH_ANNOTATION_DB;User ID=REPLACE_WITH_SQL_LOGIN;Password=REPLACE_WITH_SQL_PASSWORD;MultipleActiveResultSets=true;TrustServerCertificate=True
# Local test SQL (profile local-sql) instead:
#ConnectionStrings__AnnotationConnection=Server=annotation-sql,1433;Database=AnnotationTest;User ID=sa;Password=REPLACE_WITH_SA_PASSWORD;MultipleActiveResultSets=true;TrustServerCertificate=True

# OPTIONAL  Identity issuer the tokens come from. Default: the host-wide VIKING_IDENTITY_URL
#           (https://<VIKING_HOSTNAME_IDENTITY>/ on 443 through viking-proxy). Set only to differ.
#IdentityServer__Endpoint=https://identity.connectomes.pitt.edu/
# REQUIRED  Confidential client registered in Identity with introspection rights for Viking.Annotation.
IdentityServer__ClientId=REPLACE_WITH_INTROSPECTION_CLIENT_ID
# REQUIRED  That client's secret: generate locally and enter the same value in the Identity management site.
IdentityServer__ClientSecret=REPLACE_WITH_GENERATED_SECRET
# OPTIONAL  true only for a plain-HTTP test issuer.
IdentityServer__AllowHttpMetadata=false

# OPTIONAL  Development keeps today's container behaviour (appsettings.Development.json).
ASPNETCORE_ENVIRONMENT=Development
# OPTIONAL  Host ports: h2c and TLS (VIKING_UPSTREAM_ANNOTATION points at the TLS one).
GRPC_ANNOTATION_HTTP_PORT=5010
GRPC_ANNOTATION_HTTPS_PORT=5011
# The corrections folder it mounts is the host-wide VIKING_CORRECTIONS_DIR (host.env).

# --- profile local-sql only ---
# OPTIONAL  sa password for the throwaway SQL container (generate locally; 8+ chars, mixed classes).
MSSQL_SA_PASSWORD=REPLACE_WITH_GENERATED_SA_PASSWORD
# OPTIONAL  Container name and host port of that SQL container.
#ANNOTATION_SQL_CONTAINER_NAME=viking-annotation-sql
#ANNOTATION_SQL_HOST_PORT=1433
