# viking-segmentation run env -> <root>/Run/viking-segmentation/viking-segmentation.run.env  (compute host)
# TLS_CERT_NAME comes from host.env. The compute host's Certs/ must hold the shared certificate:
# copy it from the web host and run viking-certs there with TLS_MODE=manual (see deployment/tls).
# No secrets in this stack.

# OPTIONAL  Host folder with the weights and their <stem>.model.json manifests (read-only /models).
# Default <STACK_DATA_DIR>/models.
#SEGMENTATION_MODEL_HOST=
# OPTIONAL  Host folder for the per-model inductor and embedding caches. Default <STACK_DATA_DIR>/cache.
#SEGMENTATION_CACHE_DIR=

# OPTIONAL  Weights per container (paths inside /models).
SAM2_CHECKPOINT=/models/best_TEM_model.pt
SEG_V3_CHECKPOINT=/models/sam2_em_v3_epoch_9.pt
SEG_V4_CHECKPOINT=/models/v4.epoch0.pt
SEG_SEM_V1_CHECKPOINT=/models/sem-v1.5.pt

# OPTIONAL  Demo page on the default model (VIKING_HOSTNAME_SEGMENTATIONDEMO, HTTPS on host 40444).
SEGMENTATION_DEMO_SITE=0
# OPTIONAL  0.0.0.0 inside the container to expose it; then set a token (the page has no login).
#SEGMENTATION_DEMO_BIND=0.0.0.0
# OPTIONAL  Host bind of port 40444; 0.0.0.0 so the proxy on the web host can reach it.
#SEGMENTATION_DEMO_HOST_BIND=0.0.0.0
# OPTIONAL  Demo page token: generate locally.
#SEGMENTATION_DEMO_TOKEN=
# OPTIONAL  The extra models' plain-HTTP demo pages (host ports 40545-40547) stay on loopback unless set.
#SEGMENTATION_MODEL_DEMO_HOST_BIND=127.0.0.1

# OPTIONAL  Diagnostics.
SEGMENTATION_DEBUG_DUMP=
SEGMENTATION_BOX_MULTIMASK=0
# OPTIONAL  Embedding cache cap in bytes (0 = none; server default 32 GiB).
#SEGMENTATION_EMBEDDING_CACHE_MAX_BYTES=34359738368
# OPTIONAL  Host memory for uploaded tile bytes, so dropped tiles are rebuilt without a client (0 = none; default 2 GiB).
#SEGMENTATION_TILE_RAM_BYTES=2147483648
# OPTIONAL  Disk cap for those tiles under the embedding cache (0 = none; default 8 GiB).
#SEGMENTATION_TILE_CACHE_MAX_BYTES=8589934592
# OPTIONAL  Seconds to wait for the certificate files before exiting (restart retries).
#SEGMENTATION_TLS_WAIT_SECONDS=120
