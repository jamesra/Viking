# viking-segmentation run env -> <root>/Run/viking-segmentation/viking-segmentation.run.env  (compute host)
# TLS_CERT_NAME comes from host.env. The compute host's Certs/ must hold the shared certificate:
# copy it from the web host and run viking-certs there with TLS_MODE=manual (see deployment/tls).
# One secret: SEGMENTATION_SERVICE_CLIENT_SECRET, when the servers read tilesets themselves (below).

# OPTIONAL  Run a prebuilt image from GHCR instead of building on this host (deployment/segmentation,
# "Prebuilt image"). Default viking-segmentation-server:latest, built locally. (SEGMENTATION_IMAGE,
# the older name, is still read.)
#VIKING_SEGMENTATION_IMAGE=ghcr.io/jamesra/viking-segmentation-server:latest

# OPTIONAL  Host folder with the weights and their <stem>.model.json manifests (read-only /models).
# Default <STACK_DATA_DIR>/models.
#SEGMENTATION_MODEL_HOST=
# OPTIONAL  Host folder for the per-model inductor and embedding caches. Default <STACK_DATA_DIR>/cache.
#SEGMENTATION_CACHE_DIR=

# OPTIONAL  Weights of the default server (segmentation.<domain>), a path inside /models.
SAM2_CHECKPOINT=/models/best_TEM_model.pt
# Every other model is a row of Run/viking-segmentation/models.json (copied here from
# deploy/examples/example.viking-segmentation.models.json when the host is set up):
#   stack.ps1 viking-segmentation model v3 sam2_em_v3_epoch_9.pt     add or change a server and start it
#   stack.ps1 viking-segmentation model v3                            recreate it
#   stack.ps1 viking-segmentation model -Remove v3                    delete it
# Each row becomes <prefix>.segmentation.<domain> (under VIKING_HOSTNAME_SEGMENTATION). Two labels: the
# certificate needs *.segmentation.<domain> (or each name listed).
# Row fields: prefix, model, port, hostname, network (backend | published | macvlan), mac, ip,
# dhcpHostname, serviceName, cacheMaxMemoryBytes. Documentation/source/deployment/segmentation.rst.

# OPTIONAL  TLS files of your own instead of the certificate manager (viking-certs): a host folder holding
#           fullchain.pem and privkey.pem. Default Certs/<TLS_CERT_NAME>/. Restart the servers after renewing.
#SEGMENTATION_CERT_DIR=/etc/ssl/segmentation

# OPTIONAL  How the model servers are reached. With VIKING_BACKEND_NETWORK in host.env (viking-proxy on this
#           host, on the same Docker network) rows default to network backend: nothing is published. Otherwise
#           rows default to published: host port <port>, reached as SEGMENTATION_UPSTREAM_HOST:<port>
#           (default VIKING_COMPUTE_HOST).
#SEGMENTATION_UPSTREAM_HOST=
# OPTIONAL  Where the model script writes what the other stacks read, when they run on this host: viking-proxy's
#           host name -> upstream lines and viking-certs' extra certificate names. On another host, copy
#           Data/viking-segmentation/proxy-models.map and cert-names.names there instead.
#SEGMENTATION_PROXY_MAP_DIR=/srv/docker/Data/viking-proxy/models.d
#SEGMENTATION_CERT_NAMES_DIR=/srv/docker/Data/viking-certs/names.d

# OPTIONAL  Read the tilesets of local annotation contexts here instead of asking clients for every cell.
# Each container names its SegmentationService resource in Identity; that resource's Local resources (contexts,
# groups, organizational units) are the contexts it reads. The secret must equal SEGMENTATION_SERVICE_CLIENT_SECRET
# in the viking-identity run env. An empty secret or service name leaves every cell to the clients.
# The issuer and WebApi URLs default to the host-wide VIKING_IDENTITY_URL / VIKING_IDENTITY_API_URL; set
# SEGMENTATION_IDENTITY_* only to differ.
#SEGMENTATION_IDENTITY_ENDPOINT=
#SEGMENTATION_IDENTITY_API_ENDPOINT=
#SEGMENTATION_SERVICE_CLIENT_SECRET=
# (The model servers set their own: serviceName in their models.json row.)
#SEGMENTATION_SERVICE_NAME=

# OPTIONAL  Demo page on the default model (VIKING_HOSTNAME_SEGMENTATIONDEMO, HTTPS on host 40444).
SEGMENTATION_DEMO_SITE=0
# OPTIONAL  0.0.0.0 inside the container to expose it; then set a token (the page has no login).
#SEGMENTATION_DEMO_BIND=0.0.0.0
# OPTIONAL  Host bind of port 40444; 0.0.0.0 so the proxy on the web host can reach it.
#SEGMENTATION_DEMO_HOST_BIND=0.0.0.0
# OPTIONAL  Demo page token: generate locally.
#SEGMENTATION_DEMO_TOKEN=
# OPTIONAL  The model servers' plain-HTTP demo pages (published rows: host port <port> + 100) stay on loopback unless set.
#SEGMENTATION_MODEL_DEMO_HOST_BIND=127.0.0.1

# OPTIONAL  Diagnostics.
SEGMENTATION_DEBUG_DUMP=
SEGMENTATION_BOX_MULTIMASK=0
# OPTIONAL  Embedding cache cap in bytes (0 = none; server default 32 GiB).
#SEGMENTATION_EMBEDDING_CACHE_MAX_BYTES=34359738368
# OPTIONAL  Host memory for uploaded tile bytes, so dropped tiles are rebuilt without a client (0 = none; default 2 GiB).
#SEGMENTATION_TILE_RAM_BYTES=2147483648
# OPTIONAL  Disk cap for those tiles under the embedding cache (0 = none; default 8 GiB).
#SEGMENTATION_TILE_CACHE_MAX_BYTES=8589934592
# OPTIONAL  Seconds to wait for the certificate files before exiting (restart retries).
#SEGMENTATION_TLS_WAIT_SECONDS=120

# --- Own MAC address and IP (Linux hosts; deployment/segmentation, "Own MAC address and IP") ---
# OPTIONAL  Run segmentation-server on its own MAC and IP on the LAN (Docker macvlan) and keep a DHCP
#           lease for that MAC. Needs connectomes-deploy's stack.ps1 (it adds the overlay below).
#STACK_COMPOSE_OVERLAYS=stacks/viking-segmentation/compose.macvlan.yaml
#           Wired host NIC on that LAN (`ip -br link`), and the LAN's subnet and gateway.
#           On a VLAN, name the tagged sub-interface instead (eno1.1811 for VLAN 1811): Docker creates it,
#           the switch port must carry that VLAN tagged, and the subnet and gateway are the VLAN's.
#SEGMENTATION_MACVLAN_PARENT=eno1
#SEGMENTATION_LAN_SUBNET=10.20.30.0/24
#SEGMENTATION_LAN_GATEWAY=10.20.30.1
#           The MAC the DHCP reservation is for, and the IP it reserves. A locally administered MAC
#           (not 02:42:..., which Docker uses): printf 02; od -An -N5 -tx1 /dev/urandom | tr ' ' ':'
#SEGMENTATION_MAC_ADDRESS=02:5e:10:00:00:01
#SEGMENTATION_LAN_IP=10.20.30.40
#           0 = no DHCP client (the reserved IP is used statically). Hostname sent with the request.
#SEGMENTATION_DHCP=1
#SEGMENTATION_DHCP_HOSTNAME=segmentation
