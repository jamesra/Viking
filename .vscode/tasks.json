{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-viking",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Clients/Viking/Viking/Viking.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "build-docs-html",
      "type": "shell",
      "command": ".\\make.bat",
      "args": ["html"],
      "options": {
        "cwd": "${workspaceFolder}/Documentation"
      },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "build",
      "dependsOn": ["build-viking", "build-docs-html"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "build-and-run-viking",
      "command": "powershell",
      "type": "shell",
      "args": [
        "-Command",
        "dotnet build '${workspaceFolder}/Clients/Viking/Viking/Viking.csproj'; if ($LASTEXITCODE -eq 0) { Start-Process '${workspaceFolder}/Clients/Viking/Viking/bin/Debug/net48/Viking.exe' }"
      ],
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "rebuild-viking",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Clients/Viking/Viking/Viking.csproj",
        "--no-incremental",
        "/property:GenerateFullPaths=true"
      ],
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "build-jotunn",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Clients/Jotunn/Jotunn/Jotunn.csproj",
        "-f",
        "net10.0-windows",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": false },
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "build-monogame-testbed",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Clients/MonogameTestbed/MonogameTestbed.csproj",
        "/p:Configuration=Debug",
        "/p:Platform=x64",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": false },
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "build-monogame-testbed-release",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Clients/MonogameTestbed/MonogameTestbed.csproj",
        "/p:Configuration=Release",
        "/p:Platform=x64",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": false },
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "build-grpc-section-correction-service",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Servers/GrpcSectionCorrectionService/GrpcSectionCorrectionService.csproj",
        "/p:Configuration=Debug",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": false },
      "presentation": { "reveal": "silent" }
    }
  ]
}
