<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>9.0</LangVersion>
		<NoWarn>$(NoWarn);CS0436;CA1014;CS3009;CS3001;CS3002;CS3003;CS3008</NoWarn>
		<UseWindowsForms>true</UseWindowsForms>
		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
		<!-- Disable default embedded resource items to avoid duplicates -->
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<Optimize>false</Optimize> 
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants>TRACE</DefineConstants>
		<Optimize>true</Optimize> 
		<DebugType>pdbonly</DebugType>
	</PropertyGroup>
	<ItemGroup> 
		<None Include="**\*.config" /> 
	</ItemGroup>
	<PropertyGroup>
		<ModulesDir>..\Viking\Modules</ModulesDir>
		<ProjectModulesDir>$(ModulesDir)\$(MSBuildProjectName)</ProjectModulesDir>
	</PropertyGroup>
	
	<!-- Post-build event to copy output to Modules folder -->
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">


		<!-- Create Modules directory if it doesn't exist -->
		<Exec Command="if not exist &quot;$(ModulesDir)&quot; mkdir &quot;$(ModulesDir)&quot;" />

		<!-- Create project-specific directory if it doesn't exist -->
		<Exec Command="if not exist &quot;$(ProjectModulesDir)&quot; mkdir &quot;$(ProjectModulesDir)&quot;" />

		<!-- Copy project output to Modules folder (only newer files) -->
		<ItemGroup>
			<FilesToCopy Include="$(TargetDir)**\*.*" />
		</ItemGroup>
		<Message Text="Copying $(TargetDir)**\*.* to $(ProjectModulesDir)\$(TargetFramework)\" Importance="high" />
		
		<Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(ProjectModulesDir)\$(TargetFramework)\%(RecursiveDir)" SkipUnchangedFiles="true" />
	</Target>

	<!-- Clean target to remove copied files when build is cleaned -->
	<Target Name="CleanModules" AfterTargets="Clean">

		<!-- Remove the project-specific target framework folder -->
		<RemoveDir Directories="$(ProjectModulesDir)\$(TargetFramework)" ContinueOnError="true" />

		<!-- Remove the project-specific folder if it's empty -->
		<RemoveDir Directories="$(ProjectModulesDir)" Condition="!Exists('$(ProjectModulesDir)\*')" ContinueOnError="true" />

		<!-- Remove the Modules folder if it's empty -->
		<RemoveDir Directories="$(ModulesDir)" Condition="!Exists('$(ModulesDir)\*')" ContinueOnError="true" />

		<!-- Clean content compilation output -->
		<RemoveDir Directories="$(ProjectContentOutputDir)\bin" ContinueOnError="true" />
		<RemoveDir Directories="$(ProjectContentOutputDir)\obj" ContinueOnError="true" />
		<RemoveDir Directories="$(ProjectContentOutputDir)\bin" Condition="!Exists('$(ProjectContentOutputDir)\bin\*')" ContinueOnError="true" />
		<RemoveDir Directories="$(ProjectContentOutputDir)\obj" Condition="!Exists('$(ProjectContentOutputDir)\obj\*')" ContinueOnError="true" />

	</Target>
	
	<!-- Include Windows Forms resource files -->
	<ItemGroup>
		<EmbeddedResource Include="Properties\Resources.resx" />
		<EmbeddedResource Include="UI\FindStructureNumberForm.resx" />
		<EmbeddedResource Include="UI\MergeStructuresForm.resx" />
