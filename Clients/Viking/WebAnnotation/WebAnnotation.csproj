<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>9.0</LangVersion>
		<UseWindowsForms>true</UseWindowsForms>
		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
		<!-- Disable default embedded resource items to avoid duplicates -->
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<Optimize>false</Optimize>
		<OutputPath>..\Viking\bin\Debug\Modules\WebAnnotation\</OutputPath>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants>TRACE</DefineConstants>
		<Optimize>true</Optimize>
		<OutputPath>..\Viking\bin\Release\Modules\WebAnnotation\</OutputPath>
		<DebugType>pdbonly</DebugType>
	</PropertyGroup>
	<ItemGroup> 
		<None Include="**\*.config" /> 
	</ItemGroup>
	
	<!-- Include Windows Forms resource files -->
	<ItemGroup>
		<EmbeddedResource Include="Properties\Resources.resx" />
		<EmbeddedResource Include="UI\FindStructureNumberForm.resx" />
		<EmbeddedResource Include="UI\MergeStructuresForm.resx" />
		<EmbeddedResource Include="UI\SplitStructuresForm.resx" />
		<EmbeddedResource Include="UI\StructureChildStructuresPage.resx" />
		<EmbeddedResource Include="UI\StructureExtendedPropertiesPage.resx" />
		<EmbeddedResource Include="UI\StructureGeneralPage.resx" />
		<EmbeddedResource Include="UI\StructureLocationsChangeLogPropertiesPage.resx" />
		<EmbeddedResource Include="UI\StructureLocationsPage.resx" />
		<EmbeddedResource Include="UI\StructureNotesPage.resx" />
		<EmbeddedResource Include="UI\StructureTypeGeneralPage.resx" />
		<EmbeddedResource Include="UI\StructureTypesRelationsPage.resx" />
		<EmbeddedResource Include="UI\StructureTypesTree.resx" />
		<EmbeddedResource Include="UI\StructureTypeStructuresPage.resx" />
		<EmbeddedResource Include="UI\Controls\ListLocations.resx" />
		<EmbeddedResource Include="UI\Controls\ListStructures.resx" />
		<EmbeddedResource Include="UI\Forms\PenAnnotationViewForm.resx" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\..\AnnotationInterfaces\AnnotationInterfaces.csproj" />
		<ProjectReference Include="..\..\..\AnnotationServiceTypes\AnnotationServiceTypes.WCF.csproj" />
		<ProjectReference Include="..\..\..\RTree\RTree.csproj" />
		<ProjectReference Include="..\..\..\SqlGeometryAnnotationExtensions\SqlGeometryAnnotationExtensions.csproj" />
		<ProjectReference Include="..\..\..\SqlGeometryUtils\SqlGeometryUtils.csproj" />
		<ProjectReference Include="..\..\..\Triangle.NET\Triangle\Triangle.csproj" />
		<ProjectReference Include="..\..\..\UnitsAndScale\UnitsAndScale.csproj" />
		<ProjectReference Include="..\..\..\Utils\Utils.csproj" />
		<ProjectReference Include="..\..\Common\Common.csproj" />
		<ProjectReference Include="..\..\..\Geometry\Geometry.csproj" />
		<ProjectReference Include="..\..\Monographics\Monographics.csproj" Condition="'$(TargetFramework)' == 'net9.0-windows'" />
		<ProjectReference Include="..\..\VikingXNAGraphics\VikingXNAGraphics.csproj" Condition="'$(TargetFramework)' == 'net48'" />
		<ProjectReference Include="..\..\VolumeModel\VolumeModel.csproj" />
		<ProjectReference Include="..\..\WebAnnotationModel\WebAnnotationModel.csproj" />
		<ProjectReference Include="..\..\WebAnnotationViewModels\WebAnnotationViewModels.csproj" />
		<ProjectReference Include="..\..\WebAnnotationWPFControls\WebAnnotationWPFControls.csproj" />
		<ProjectReference Include="..\NGVV\VikingCore.csproj" />
		<ProjectReference Include="..\VikingXNAWinForms\VikingXNAWinForms.csproj" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="EntityFramework" Version="6.5.1" />
		<PackageReference Include="log4net" Version="2.0.13" />
		<PackageReference Include="MathNet.Numerics" Version="5.0.0" /> 
		<PackageReference Include="NETStandard.Library" Version="2.0.3" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="protobuf-net" Version="3.0.62" />
		<PackageReference Include="protobuf-net.ServiceModel" Version="3.0.62" />
		<PackageReference Include="System.Net.Http" Version="4.3.4" />
		<PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
		<PackageReference Include="System.Security.Cryptography.Algorithms" Version="4.3.1" />
		<PackageReference Include="System.Security.Cryptography.X509Certificates" Version="4.3.2" />
		<PackageReference Include="System.Text.Encodings.Web" Version="9.0.7" />
		<PackageReference Include="System.ValueTuple" Version="4.6.1" />
		<PackageReference Include="Thinktecture.IdentityModel.Client" Version="4.0.1" Condition="'$(TargetFramework)' == 'net48'" />
		<PackageReference Include="System.Memory" Version="4.6.3" />
		<PackageReference Include="LinqToXsd" Version="2.0.2" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="WindowsBase" />
		<Reference Include="System.Xml.Linq" />
		<Reference Include="System.ComponentModel.DataAnnotations" />
		<Reference Include="System.Data.Linq" />
		<Reference Include="System.Xaml" />
		<Reference Include="PresentationCore" />
		<Reference Include="PresentationFramework" />
		<Reference Include="System.Windows.Forms.Integration" />
		<Reference Include="WindowsFormsIntegration">
			<HintPath>C:\Windows\Microsoft.NET\Framework64\v4.0.30319\WindowsFormsIntegration.dll</HintPath>
		</Reference>
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<PackageReference Include="Microsoft.SqlServer.Types" Version="14.0.1016.290" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Duende.IdentityModel" Version="7.1.0" />
		<PackageReference Include="Microsoft.SqlServer.Types" Version="160.1000.6" />
	</ItemGroup>
	<PropertyGroup>
		<PostBuildEvent>
			mkdir $(SolutionDir)Clients\Viking\Viking\bin\Debug\net48\Modules\WebAnnotation
			copy $(TargetDir)* $(SolutionDir)Clients\Viking\Viking\bin\Debug\net48\Modules\WebAnnotation /Y
		</PostBuildEvent>
	</PropertyGroup>
</Project>
