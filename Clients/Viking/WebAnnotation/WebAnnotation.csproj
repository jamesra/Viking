<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);CS0436;CA1014;CS3009;CS3001;CS3002;CS3003;CS3008</NoWarn>
		<UseWPF>true</UseWPF>
		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
	</PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<Optimize>false</Optimize> 
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants></DefineConstants>
		<Optimize>true</Optimize> 
		<DebugType>pdbonly</DebugType>
	</PropertyGroup>
	<ItemGroup> 
		<None Include="**\*.config" /> 
	</ItemGroup>
	<PropertyGroup>
		<ModulesDir>..\Viking\Modules</ModulesDir>
		<ProjectModulesDir>$(ModulesDir)\$(MSBuildProjectName)</ProjectModulesDir>
	</PropertyGroup>
	
	<!-- Post-build event to copy output to Modules folder -->
		<!-- Post-build event to copy output to Modules folder -->
	<Target Name="PostBuild" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net48'">
		<PropertyGroup>
			<OutputDirectory>$(OutDir)</OutputDirectory>
			<OutputDirectory Condition="'$(OutputDirectory)' == ''">$(OutputPath)</OutputDirectory>
		</PropertyGroup>

		<!-- Create Modules directory if it doesn't exist -->
		<MakeDir Directories="$(ModulesDir)" Condition="!Exists('$(ModulesDir)')" />
		<MakeDir Directories="$(ProjectModulesDir)" Condition="!Exists('$(ProjectModulesDir)')" />
		<MakeDir Directories="$(ProjectModulesDir)\$(Configuration)" Condition="!Exists('$(ProjectModulesDir)\$(Configuration)')" />
		<MakeDir Directories="$(ProjectModulesDir)\$(Configuration)\$(TargetFramework)" Condition="!Exists('$(ProjectModulesDir)\$(Configuration)\$(TargetFramework)')" />

		<!-- Copy project output to Modules folder -->
		<ItemGroup>
			<FilesToCopy Include="$(OutputDirectory)**\*.*" Exclude="$(OutputDirectory)**\*.pdb" />
		</ItemGroup>
		<Message Text="Copying from $(OutputDirectory) to $(ProjectModulesDir)\$(Configuration)\$(TargetFramework)\" Importance="high" />
		<Message Text="Files to copy: @(FilesToCopy-&gt;Count())" Importance="normal" />
		
		<Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(ProjectModulesDir)\$(Configuration)\$(TargetFramework)\%(RecursiveDir)" SkipUnchangedFiles="false" />
	</Target>

	<!-- Clean target to remove copied files when build is cleaned -->
	<Target Name="CleanModules" AfterTargets="Clean">

		<!-- Remove the project-specific target framework folder -->
		<RemoveDir Directories="$(ProjectModulesDir)\$(Configuration)\$(TargetFramework)" ContinueOnError="true" />

		<!-- Remove the project-specific configuration folder if it's empty -->
		<RemoveDir Directories="$(ProjectModulesDir)\$(Configuration)" Condition="!Exists('$(ProjectModulesDir)\$(Configuration)\*')" ContinueOnError="true" />

		<!-- Remove the project-specific folder if it's empty -->
		<RemoveDir Directories="$(ProjectModulesDir)" Condition="!Exists('$(ProjectModulesDir)\*')" ContinueOnError="true" />

		<!-- Remove the Modules folder if it's empty -->
		<RemoveDir Directories="$(ModulesDir)" Condition="!Exists('$(ModulesDir)\*')" ContinueOnError="true" />

		<!-- Clean content compilation output -->
		<RemoveDir Directories="$(ProjectContentOutputDir)\bin" ContinueOnError="true" />
		<RemoveDir Directories="$(ProjectContentOutputDir)\obj" ContinueOnError="true" />
		<RemoveDir Directories="$(ProjectContentOutputDir)\bin" Condition="!Exists('$(ProjectContentOutputDir)\bin\*')" ContinueOnError="true" />
		<RemoveDir Directories="$(ProjectContentOutputDir)\obj" Condition="!Exists('$(ProjectContentOutputDir)\obj\*')" ContinueOnError="true" />

	</Target>
	
