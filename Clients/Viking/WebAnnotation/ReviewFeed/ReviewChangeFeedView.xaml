<UserControl x:Class="WebAnnotation.ReviewFeed.ReviewChangeFeedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1E1E1E">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="8,6,8,0">
      <DockPanel LastChildFill="True">
        <Button x:Name="FilterToggleButton"
                DockPanel.Dock="Right"
                Padding="8,2"
                Margin="8,0,0,0"
                Content="Filter"
                Click="FilterToggleButton_OnClick"
                ToolTip="Hide deleted locations, hide your own changes, watch specific users, or filter by cell/label" />
        <TextBlock Foreground="#FFCCCCCC"
                   FontSize="11"
                   Text="Recent changes in the volume. Click a card to go there."
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
      </DockPanel>
      <TextBlock x:Name="SeedStatusText"
                 Margin="0,4,0,0"
                 Foreground="#FFFFB74D"
                 FontSize="11"
                 TextWrapping="Wrap"
                 Visibility="Collapsed" />
    </StackPanel>

    <Border x:Name="FilterPanel"
            DockPanel.Dock="Top"
            Margin="8,6,8,0"
            Padding="8"
            Background="#FF2A2A2E"
            CornerRadius="4"
            Visibility="Collapsed">
      <StackPanel>
        <CheckBox x:Name="HideDeletedCheck"
                  Foreground="#FFE8E8E8"
                  Content="Hide deleted locations"
                  IsChecked="True"
                  Margin="0,0,0,6" />
        <CheckBox x:Name="HideOwnCheck"
                  Foreground="#FFE8E8E8"
                  Content="Hide my own changes"
                  Margin="0,0,0,6" />
        <TextBlock Foreground="#FFCCCCCC" FontSize="11" Text="Watch users (comma-separated; empty = all)" />
        <TextBox x:Name="WatchedUsersBox"
                 Margin="0,2,0,6"
                 Padding="2"
                 ToolTip="Only show changes from these usernames. Leave empty to watch everyone." />
        <TextBlock Foreground="#FFCCCCCC" FontSize="11" Text="Structure ID or label" />
        <TextBox x:Name="StructureOrLabelBox"
                 Margin="0,2,0,6"
                 Padding="2"
                 ToolTip="Same cell/label filter other tools use: id, id substring, or label substring." />
        <TextBlock Foreground="#FFCCCCCC" FontSize="11"
                   Text="Sections (blank = whole volume). Example: 1-100, 250, 400-410" />
        <TextBox x:Name="SectionsBox"
                 Margin="0,2,0,2"
                 Padding="2"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="40"
                 ToolTip="Same section-range syntax as Update Volume Positions. Leave blank for all sections."
                 TextChanged="SectionsBox_OnTextChanged" />
        <TextBlock x:Name="SectionsInterpretation"
                   Foreground="#FF9A9A9A"
                   FontSize="10"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Text="All sections" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Apply" Padding="10,2" Margin="0,0,6,0" Click="FilterApplyButton_OnClick" />
          <Button Content="Clear" Padding="10,2" Click="FilterClearButton_OnClick" />
        </StackPanel>
      </StackPanel>
    </Border>

    <ListBox x:Name="FeedList"
             Background="Transparent"
             BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             SizeChanged="FeedList_OnSizeChanged"
             MouseDoubleClick="FeedList_OnMouseDoubleClick"
             KeyDown="FeedList_OnKeyDown">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Padding" Value="0" />
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Margin="4,4,4,0"
                  Padding="4"
                  Background="#FF2A2A2E"
                  CornerRadius="4"
                  Cursor="Hand"
                  HorizontalAlignment="Stretch">
            <Grid>
              <!-- Deleted: one compact text row, no image -->
              <TextBlock Text="{Binding DeletedRowText}"
                         Foreground="#FFB0B0B0"
                         FontSize="11"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis"
                         Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVis}}" />

              <!-- Active change card -->
              <StackPanel>
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <DockPanel LastChildFill="True" Margin="0,0,0,2">
                  <TextBlock DockPanel.Dock="Right"
                             Foreground="#FF9A9A9A"
                             FontSize="10"
                             Text="{Binding TimeLabel}"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center" />
                  <TextBlock Foreground="#FF7EC8FF"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Text="{Binding UsernameLabel}"
                             TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Image Source="{Binding Thumbnail}"
                       Width="{Binding CardThumbSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Height="{Binding CardThumbSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#FFE8E8E8"
                           FontSize="11"
                           Text="{Binding Caption}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
