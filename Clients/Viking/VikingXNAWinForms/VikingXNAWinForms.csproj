<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFrameworks>net48;net9.0-windows</TargetFrameworks>
		<RootNamespace>VikingXNAWinForms</RootNamespace>
		<AssemblyName>VikingXNAWinForms</AssemblyName>
		<UseWindowsForms>true</UseWindowsForms>
		<MonoGamePlatform>Windows</MonoGamePlatform>
		<!-- Disable default embedded resource items to avoid duplicates -->
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
	</PropertyGroup>
	
	<!-- .NET Framework 4.8 specific properties -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	
	<!-- .NET 9.0-windows specific properties -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
		<TargetFrameworkMoniker>.NETCoreApp,Version%3Dv9.0</TargetFrameworkMoniker>
		<NuGetTargetMoniker>.NETCoreApp,Version=v9.0</NuGetTargetMoniker>
	</PropertyGroup>
	
	<!-- No direct MonoGame reference for net48; use VikingXNAGraphics instead -->
	<ItemGroup>
		<ProjectReference Include="..\..\..\Geometry\Geometry.csproj" />
		<ProjectReference Include="..\..\Monographics\Monographics.csproj" Condition="'$(TargetFramework)' == 'net9.0-windows'" />
		<ProjectReference Include="..\..\VikingXNAGraphics\MonographicsNet48.csproj" Condition="'$(TargetFramework)' == 'net48'" />
	</ItemGroup>
	<ItemGroup>
		<None Include="app.config" />
	</ItemGroup>
	
	<!-- Include Windows Forms resource files -->
	<ItemGroup>
		<EmbeddedResource Include="GraphicsDeviceControl.resx" />
		<EmbeddedResource Include="ViewerControl.resx" />
	</ItemGroup>
</Project>