<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Viking</RootNamespace>
    <AssemblyName>Viking</AssemblyName>
    <ApplicationIcon>Viking.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <SignAssembly>False</SignAssembly>
    <ProductName>Viking</ProductName>
    <PublisherName>Marc Lab</PublisherName>
    <ApplicationVersion>1.2.52.0</ApplicationVersion>
    <FileVersion>1.2.52.0</FileVersion>
    <AssemblyVersion>1.2.52.0</AssemblyVersion>
    <Deterministic>True</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0436;CA1014;CS3009</NoWarn>
    <!-- Enable automatic binding redirects -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="EntityFramework" Version="6.5.1" />
    <PackageReference Include="Microsoft.SqlServer.Types" Version="160.1000.6" />
    <PackageReference Include="System.Buffers" Version="4.6.1" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="LinqToXsd" Version="2.0.2" />
    <PackageReference Include="protobuf-net" Version="3.2.56" />
    <PackageReference Include="protobuf-net.ServiceModel" Version="3.2.52" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NGVV\VikingCore.csproj" />
    <ProjectReference Include="..\..\..\SqlServerTypesLoader\SqlServerTypesLoader.csproj" />
    <ProjectReference Include="..\..\Viking.UI.WPF\Viking.UI.WPF.csproj" />
    <!-- Ensure MGCB content is built before Viking copies graphics assets to output -->
    <ProjectReference Include="..\..\VikingXNAGraphics\MonographicsNet48.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <!-- Module projects - built as plugins, not direct references -->
    <ProjectReference Include="..\WebAnnotation\WebAnnotation.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\LocalBookmarks\LocalBookmarks.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\MeasurementExtension\Measurement.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="app.config" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Modules\**\System.Memory.dll" />
    <None Remove="System.Memory.4.6.3\**" />
    <None Remove="System.Runtime.CompilerServices.Unsafe.6.1.2\**" />
    <None Remove="System.Numerics.Vectors.4.6.1\**" />
    <None Remove="System.Buffers.4.6.1\**" />
  </ItemGroup>
  <!-- Ensure native SQL Server Types DLLs are copied to output -->
  <ItemGroup>
    <None Include="SqlServerTypes\x64\msvcr120.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="SqlServerTypes\x64\SqlServerSpatial140.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="SqlServerTypes\x64\SqlServerSpatial160.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="SqlServerTypes\x86\msvcr120.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="SqlServerTypes\x86\SqlServerSpatial140.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="SqlServerTypes\x86\SqlServerSpatial160.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="build.log">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <!--

	<PropertyGroup>

		<TargetDir>$(MSBuildProjectDirectory)\bin\$(\$(OutputPath)</TargetDir>

	</PropertyGroup>

	-->
  <!-- Post-build event to create debug output file -->
  <Target Name="CreateDebugOutputFile" AfterTargets="Build">
    <WriteLinesToFile File="$(OutputPath)debug_output.txt" Lines="Debug output will be captured here when Viking runs" Overwrite="true" />
  </Target>
  <PropertyGroup>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Title>Viking</Title>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <IsPublishable>True</IsPublishable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <IsPublishable>True</IsPublishable>
  </PropertyGroup>
  <Target Name="CopyGraphicsContent"
          AfterTargets="Build"
          BeforeTargets="PrepareForRun"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_GraphicsBuildConfig Condition="'$(Configuration)' != ''">$(Configuration)</_GraphicsBuildConfig>
      <_GraphicsBuildConfig Condition="'$(_GraphicsBuildConfig)' == ''">Debug</_GraphicsBuildConfig>
      <_GraphicsContentSourceDir>$(MSBuildThisFileDirectory)..\..\VikingXNAGraphics\bin\$(_GraphicsBuildConfig)\net48\Content\</_GraphicsContentSourceDir>
      <_GraphicsContentFallbackDir>$(MSBuildThisFileDirectory)..\..\VikingXNAGraphics\Content\bin\Windows\</_GraphicsContentFallbackDir>
      <_GraphicsContentDestDir>$(OutputPath)Content\</_GraphicsContentDestDir>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(_GraphicsContentSourceDir)')">
      <GraphicsContent Include="$(_GraphicsContentSourceDir)**\*.xnb" />
    </ItemGroup>
    <ItemGroup Condition="'@(GraphicsContent)' == '' and Exists('$(_GraphicsContentFallbackDir)')">
      <GraphicsContent Include="$(_GraphicsContentFallbackDir)*.xnb" />
    </ItemGroup>
    <MakeDir Directories="$(_GraphicsContentDestDir)" />
    <Copy SourceFiles="@(GraphicsContent)"
          DestinationFolder="$(_GraphicsContentDestDir)%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Message Text="Copied @(GraphicsContent-&gt;Count()) graphics content file(s) to $(_GraphicsContentDestDir)" Importance="high" />
    <Error Text="No graphics content (.xnb) was copied to Viking output. Build Clients\VikingXNAGraphics\MonographicsNet48.csproj and ensure MGCB is installed at '$(MGCBPath)'."
           Condition="'@(GraphicsContent)' == ''" />
  </Target>
  <!-- Define the list of modules to process -->
  <ItemGroup>
    <ModuleToCopy Include="LocalBookmarks" />
    <ModuleToCopy Include="Measurement" />
    <ModuleToCopy Include="WebAnnotation" />
  </ItemGroup>
  <!-- Main target that processes each module using item batching -->
  <!-- Run after Build and ensure project references are built first -->
  <Target Name="CopyModules" AfterTargets="Build">
    <!-- Process each module by calling CopySingleModule with the module name -->
    <MSBuild Projects="$(MSBuildProjectFile)" Targets="CopySingleModule" Properties="ModuleName=%(ModuleToCopy.Identity)" />
    <!-- Copy shared DLLs once after all modules are processed -->
    <PropertyGroup>
      <ModulesSourceDir>$(MSBuildProjectDirectory)\Modules</ModulesSourceDir>
    </PropertyGroup>
    <!-- Copy Xml.Schema.Linq.dll to main output directory if it exists in any module -->
    <ItemGroup>
      <XmlSchemaLinqFiles Include="$(ModulesSourceDir)\**\Xml.Schema.Linq.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(XmlSchemaLinqFiles)" DestinationFolder="$(TargetDir)" Condition="'@(XmlSchemaLinqFiles)' != ''" />
    <Message Text="Copied Xml.Schema.Linq.dll to main output directory" Importance="normal" Condition="'@(XmlSchemaLinqFiles)' != ''" />
    <!-- Copy System.Memory.dll to main output directory if it exists in any module -->
    <ItemGroup>
      <SystemMemoryFiles Include="$(ModulesSourceDir)\**\System.Memory.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SystemMemoryFiles)" DestinationFolder="$(TargetDir)" Condition="'@(SystemMemoryFiles)' != ''" />
    <Message Text="Copied System.Memory.dll to main output directory" Importance="normal" Condition="'@(SystemMemoryFiles)' != ''" />
    <!-- Remove duplicate shared DLLs from modules (once after all modules) -->
    <CallTarget Targets="RemoveDuplicateDlls" />
  </Target>
  <!-- Target to copy a single module's files -->
  <Target Name="CopySingleModule">
    <PropertyGroup>
      <ModulesSourceDir>$(MSBuildProjectDirectory)\Modules</ModulesSourceDir>
      <ModulesTargetDir>$(TargetDir)\Modules</ModulesTargetDir>
      <SourcePath>$(ModulesSourceDir)\$(ModuleName)\$(Configuration)\$(TargetFramework)</SourcePath>
      <TargetPath>$(ModulesTargetDir)\$(ModuleName)</TargetPath>
    </PropertyGroup>
    <Message Text="Processing module: $(ModuleName)" Importance="high" />
    <Message Text="Source: $(SourcePath) -&gt; Target: $(TargetPath)" Importance="high" />
    <!-- Check if module source exists -->
    <Message Text="Warning: $(ModuleName) module not found at $(SourcePath)" Importance="high" Condition="!Exists('$(SourcePath)')" />
    <!-- Copy module files -->
    <ItemGroup Condition="Exists('$(SourcePath)')">
      <ModuleFilesToCopy Include="$(SourcePath)\**\*" Exclude="$(SourcePath)\**\*.pdb" />
    </ItemGroup>
    <Message Text="Found @(ModuleFilesToCopy-&gt;Count()) files for $(ModuleName)" Importance="high" Condition="Exists('$(SourcePath)')" />
    <MakeDir Directories="$(TargetPath)" Condition="Exists('$(SourcePath)')" />
    <RemoveDir Directories="$(TargetPath)\$(TargetFramework)\Modules" ContinueOnError="true" Condition="Exists('$(SourcePath)')" />
    <Copy SourceFiles="@(ModuleFilesToCopy)" DestinationFolder="$(TargetPath)\%(RecursiveDir)" Condition="'@(ModuleFilesToCopy)' != ''" SkipUnchangedFiles="true" />
    <!-- Copy module content files -->
    <ItemGroup Condition="Exists('$(SourcePath)\Content')">
      <ModuleContentToCopy Include="$(SourcePath)\Content\**" />
    </ItemGroup>
    <Message Text="Copying $(SourcePath)\Content to $(TargetDir)\Content" Importance="high" Condition="Exists('$(SourcePath)\Content')" />
    <Copy SourceFiles="@(ModuleContentToCopy)" DestinationFolder="$(TargetDir)\Content" Condition="'@(ModuleContentToCopy)' != ''" />
    <Message Text="Copied $(ModuleName) module files" Importance="normal" Condition="Exists('$(SourcePath)')" />
  </Target>
  <!-- Target to remove duplicate DLLs from modules -->
  <Target Name="RemoveDuplicateDlls" AfterTargets="CopyModules">
    <PropertyGroup>
      <ModulesDir>$(TargetDir)\Modules</ModulesDir>
    </PropertyGroup>
    <!-- Get all DLLs from the main TargetDir -->
    <ItemGroup>
      <MainAppDlls Include="$(TargetDir)*.dll" />
      <MainAppPdbs Include="$(TargetDir)*.pdb" />
      <MainAppConfigs Include="$(TargetDir)*.dll.config" />
    </ItemGroup>
    <!-- First, collect all DLLs in modules -->
    <ItemGroup>
      <AllModuleDlls Include="$(ModulesDir)\**\*.dll" />
      <AllModulePdbs Include="$(ModulesDir)\**\*.pdb" />
      <AllModuleConfigs Include="$(ModulesDir)\**\*.dll.config" />
    </ItemGroup>
    <!-- Filter to find only those that exist in main app directory -->
    <ItemGroup>
      <DuplicateDlls Include="@(AllModuleDlls)" Condition="Exists('$(TargetDir)%(Filename)%(Extension)')" />
      <DuplicatePdbs Include="@(AllModulePdbs)" Condition="Exists('$(TargetDir)%(Filename)%(Extension)')" />
      <DuplicateConfigs Include="@(AllModuleConfigs)" Condition="Exists('$(TargetDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Message Text="Found @(MainAppDlls-&gt;Count()) DLLs in main app directory $(TargetDir)" Importance="high" />
    <Message Text="Found @(DuplicateDlls-&gt;Count()) duplicate DLLs in modules to remove in $(ModulesDir)" Importance="high" />
    <!-- Delete all duplicate DLLs from modules -->
    <Delete Files="@(DuplicateDlls)" Condition="'@(DuplicateDlls)' != ''" ContinueOnError="true" />
    <Message Text="Removed @(DuplicateDlls-&gt;Count()) duplicate DLLs from modules" Importance="high" />
    <Delete Files="@(DuplicatePdbs)" Condition="'@(DuplicatePdbs)' != ''" ContinueOnError="true" />
    <Message Text="Removed @(DuplicatePdbs-&gt;Count()) duplicate PDBs from modules" Importance="high" />
    <Delete Files="@(DuplicateConfigs)" Condition="'@(DuplicateConfigs)' != ''" ContinueOnError="true" />
    <Message Text="Removed @(DuplicateConfigs-&gt;Count()) duplicate DLL.CONFIGs from modules" Importance="high" />
  </Target>
  <Target Name="CleanModules" AfterTargets="Clean">
    <PropertyGroup>
      <ModulesDir>$(TargetDir)\Modules</ModulesDir>
    </PropertyGroup>
    <!-- Remove the project-specific target framework folder -->
    <RemoveDir Directories="$(ModulesDir)" ContinueOnError="true" />
  </Target>
</Project>