<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Viking.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false"/>
    </sectionGroup>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
      <section name="Viking.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <runtime> 
  </runtime>
  <userSettings>
    <Viking.Properties.Settings>
      <setting name="LastTileExportDirectory" serializeAs="String">
        <value>%UserProfile%</value>
      </setting>
      <setting name="LastExportRangeStart" serializeAs="String">
        <value>1</value>
      </setting>
      <setting name="LastExportRangeEnd" serializeAs="String">
        <value>1</value>
      </setting>
      <setting name="ExportAllChecked" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="LastTileExportDownsampleLevel" serializeAs="String">
        <value>1</value>
      </setting>
      <setting name="LastFrameCaptureExportDirectory" serializeAs="String">
        <value>%UserProfile%</value>
      </setting>
      <setting name="FrameCaptureDefaultPrefix" serializeAs="String">
        <value />
      </setting>
      <setting name="ExportFramesIncludeOverlays" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="ExportFramesFirstFrameNumber" serializeAs="String">
        <value>1</value>
      </setting>
      <setting name="LastGotoX" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="LastGotoY" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="LastGotoZ" serializeAs="String">
        <value>1</value>
      </setting>
      <setting name="LastDownsample" serializeAs="String">
        <value>16</value>
      </setting>
      <setting name="LastScreenshotPath" serializeAs="String">
        <value>%UserProfile%\Pictures</value>
      </setting>
      <setting name="LastScreenshotIncludeOverlays" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="LastScreenshotUseViewersDownsampleLevel" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="CachedUsername" serializeAs="String">
        <value />
      </setting>
      <setting name="ShowCommandHelp" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="VolumeURLs" serializeAs="Xml">
        <value>
          <ArrayOfString xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
          </ArrayOfString>
        </value>
      </setting>
      <setting name="FrameExportPrefix" serializeAs="String">
        <value />
      </setting>
      <setting name="FrameExportPath" serializeAs="String">
        <value />
      </setting>
      <setting name="ScreenShotFilePrefix" serializeAs="String">
        <value>ScreenShot</value>
      </setting>
      <setting name="ScreenShotNumber" serializeAs="String">
        <value>1</value>
      </setting>
      <setting name="ServerURLs" serializeAs="Xml">
        <value>
          <ArrayOfString xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <string>http://storage1.connectomes.utah.edu/</string>
            <string>http://internal.connectomes.utah.edu/</string>
            <string>http://openconnecto.me/ocp/ca/</string>
            <string>http://v2486.host.s.uw.edu/</string>
            <string>http://connectomes.utah.edu/</string>
            <string>http://storage2.connectomes.utah.edu/</string>
          </ArrayOfString>
        </value>
      </setting>
      <setting name="SectionNumberOverlayEnabled" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="SectionNumberOverlayCount" serializeAs="String">
        <value>4</value>
      </setting>
      <setting name="SectionNumberOverlayAcceleration" serializeAs="String">
        <value>0.1</value>
      </setting>
      <setting name="SectionNumberOverlayEdge" serializeAs="String">
        <value>Left</value>
      </setting>
      <setting name="SectionNumberOverlayOpacity" serializeAs="String">
        <value>0.7</value>
      </setting>
      <setting name="SectionNumberOverlayMinOpacityNonCenter" serializeAs="String">
        <value>0.5</value>
      </setting>
      <setting name="SectionNumberOverlayCenterMagnification" serializeAs="String">
        <value>3</value>
      </setting>
      <setting name="SectionNumberOverlayPidProportionalGain" serializeAs="String">
        <value>4.0</value>
      </setting>
      <setting name="SectionNumberOverlayPidDerivativeGain" serializeAs="String">
        <value>1.0</value>
      </setting>
      <setting name="SectionNumberOverlayPidIntegralGain" serializeAs="String">
        <value>0.01</value>
      </setting>
      <setting name="SectionNumberOverlayPidVelocityThreshold" serializeAs="String">
        <value>0.5</value>
      </setting>
      <setting name="SectionNumberOverlayPidPositionThreshold" serializeAs="String">
        <value>0.5</value>
      </setting>
    </Viking.Properties.Settings>
  </userSettings>
</configuration>
