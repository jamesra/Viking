<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <AssemblyName>VikingCoreTests</AssemblyName>
    <RootNamespace>VikingCoreTests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FsCheck" Version="2.16.3" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.9.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.9.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <!-- GraphicsDeviceSmokeTests load the content Viking ships for this framework (MonoGame 3.7 for net48, 3.8 for net10). -->
  <Target Name="CopyGraphicsContentForTests" AfterTargets="Build">
    <PropertyGroup>
      <_TestGraphicsContentDir Condition="'$(TargetFramework)' == 'net48'">$(MSBuildThisFileDirectory)..\..\VikingXNAGraphics\bin\$(Configuration)\net48\Content\</_TestGraphicsContentDir>
      <_TestGraphicsContentDir Condition="'$(TargetFramework)' != 'net48'">$(MSBuildThisFileDirectory)..\..\Monographics\bin\MonoGame\$(Configuration)\$(TargetFramework)\Content\</_TestGraphicsContentDir>
    </PropertyGroup>
    <ItemGroup>
      <_TestGraphicsContent Include="$(_TestGraphicsContentDir)*.xnb" />
    </ItemGroup>
    <Copy SourceFiles="@(_TestGraphicsContent)" DestinationFolder="$(OutDir)Content" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\MeasurementExtension\Measurement.csproj" />
    <ProjectReference Include="..\NGVV\VikingCore.csproj" />
    <ProjectReference Include="..\..\Viking.Scene\Viking.Scene.csproj" />
  </ItemGroup>

</Project>
