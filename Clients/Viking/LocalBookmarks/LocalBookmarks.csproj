<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
	<LangVersion>12.0</LangVersion>
	<Nullable>enable</Nullable>
    <!-- Disable default embedded resource items to avoid duplicates -->
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <MonoGamePlatform>Windows</MonoGamePlatform>
    <NoWarn>$(NoWarn);CS0436;CA1014;CS3009</NoWarn>
    <!-- Disable auto-generated assembly info to use manual AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <PropertyGroup>
      <ModulesDir>..\Viking\Modules</ModulesDir>
      <ProjectModulesDir>$(ModulesDir)\$(MSBuildProjectName)</ProjectModulesDir>
	  <ProjectContentDir>$(ProjectDir)\Content\</ProjectContentDir>
	  <ProjectContentOutputDir>$(TargetDir)\Content\</ProjectContentOutputDir>
  </PropertyGroup>
  <!-- Post-build event to copy output to Modules folder -->
  <Target Name="PostBuild" AfterTargets="Build">
    <PropertyGroup>
      <OutputDirectory>$(OutDir)</OutputDirectory>
      <OutputDirectory Condition="'$(OutputDirectory)' == ''">$(OutputPath)</OutputDirectory>
    </PropertyGroup>

    <!-- Create Modules directory if it doesn't exist -->
    <MakeDir Directories="$(ModulesDir)" Condition="!Exists('$(ModulesDir)')" />
    <MakeDir Directories="$(ProjectModulesDir)" Condition="!Exists('$(ProjectModulesDir)')" />
    <MakeDir Directories="$(ProjectModulesDir)\$(Configuration)" Condition="!Exists('$(ProjectModulesDir)\$(Configuration)')" />
    <MakeDir Directories="$(ProjectModulesDir)\$(Configuration)\$(TargetFramework)" Condition="!Exists('$(ProjectModulesDir)\$(Configuration)\$(TargetFramework)')" />
    
    <!-- Ensure Content directory exists in target -->
    <MakeDir Directories="$(ProjectModulesDir)\$(Configuration)\$(TargetFramework)\Content" Condition="!Exists('$(ProjectModulesDir)\$(Configuration)\$(TargetFramework)\Content')" />
    
    <!-- Copy project output to Modules folder -->
    <ItemGroup>
      <FilesToCopy Include="$(OutputDirectory)**\*.*" Exclude="$(OutputDirectory)**\*.pdb" />
    </ItemGroup>
    <Message Text="Copying from $(OutputDirectory) to $(ProjectModulesDir)\$(Configuration)\$(TargetFramework)\" Importance="high" />
    <Message Text="Files to copy: @(FilesToCopy->Count())" Importance="normal" />
  
    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(ProjectModulesDir)\$(Configuration)\$(TargetFramework)\%(RecursiveDir)" SkipUnchangedFiles="false" />
  </Target>
  
  <!-- Clean target to remove copied files when build is cleaned -->
  <!-- Note: We don't remove modules during clean because they're intermediate files that will be regenerated on build -->
  <!-- If you need to clean modules, do it manually or use a separate clean target -->
  <Target Name="CleanModules" AfterTargets="Clean"> 
    
    <!-- Only clean if explicitly requested via CleanModules property -->
    <!-- This prevents modules from being removed during Rebuild operations -->
    <RemoveDir Directories="$(ProjectModulesDir)\$(Configuration)\$(TargetFramework)" Condition="'$(CleanModules)' == 'true'" ContinueOnError="true" />
    <RemoveDir Directories="$(ProjectModulesDir)\$(Configuration)" Condition="'$(CleanModules)' == 'true' AND !Exists('$(ProjectModulesDir)\$(Configuration)\*')" ContinueOnError="true" />
    <RemoveDir Directories="$(ProjectModulesDir)" Condition="'$(CleanModules)' == 'true' AND !Exists('$(ProjectModulesDir)\*')" ContinueOnError="true" />
    
    <!-- Clean content compilation output (always clean these) -->
    <RemoveDir Directories="$(ProjectContentOutputDir)\bin" ContinueOnError="true" />
    <RemoveDir Directories="$(ProjectContentOutputDir)\obj" ContinueOnError="true" />
    <RemoveDir Directories="$(ProjectContentOutputDir)\bin" Condition="!Exists('$(ProjectContentOutputDir)\bin\*')" ContinueOnError="true" />
    <RemoveDir Directories="$(ProjectContentOutputDir)\obj" Condition="!Exists('$(ProjectContentOutputDir)\obj\*')" ContinueOnError="true" />
    <!-- Remove the Content folder if it's empty -->
    <RemoveDir Directories="$(ProjectContentOutputDir)" Condition="!Exists('$(ProjectContentOutputDir)\*')" ContinueOnError="true" />
	  
  </Target>

  <!-- Compile MonoGame content (only for net48) -->
  <Target Name="CompileContent" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net48'" Inputs="Content\Content.mgcb;Content\Arrow.png;Content\Ring.png;Content\Star.png" Outputs="$(TargetDir)\Content\Arrow.xnb;$(TargetDir)\Content\Ring.xnb;$(TargetDir)\Content\Star.xnb">
	  <Message Text="Compiling MonoGame content for $(TargetFramework)..." Importance="normal" />
	  <Exec Command="&quot;C:\Program Files (x86)\MSBuild\MonoGame\v3.0\Tools\MGCB.exe&quot; /@:&quot;Content.mgcb&quot; /platform:Windows /outputDir:&quot;$(TargetDir)\Content&quot; /intermediateDir:&quot;$(MSBuildThisFileDirectory)Content\obj\$(TargetFramework)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)Content" StandardOutputImportance="high" ConsoleToMSBuild="true" />
	   
	  <Message Text="MonoGame content compilation completed." Importance="normal" />
  </Target>

  <!-- Include compiled MonoGame content -->
  <ItemGroup>
	  <Content Include="$(TargetDir)\Content\*.xnb">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		  <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
  </ItemGroup>

  <!-- Hide bin and obj folders from Visual Studio -->
  <ItemGroup>
	  <Folder Include="Content" />
  </ItemGroup>

	<ItemGroup>
    <Compile Remove="Content\bin\**" />
    <Compile Remove="Content\obj\**" />
    <None Remove="Content\bin\**" />
    <None Remove="Content\obj\**" />
    <Page Remove="Content\bin\**" />
    <Page Remove="Content\obj\**" />
  </ItemGroup>
  
  <ItemGroup>
    
    <PackageReference Include="LinqToXsd" Version="2.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Geometry\Geometry.csproj" />
    <ProjectReference Include="..\NGVV\VikingCore.csproj" />
    <ProjectReference Include="..\..\Viking.UI.WPF\Viking.UI.WPF.csproj" />
    <ProjectReference Include="..\..\WCFTokenInjector\WCFTokenInjector.csproj" />
  </ItemGroup>
  
  <!-- Use VikingXNAGraphics for net48 and Monographics for net9.0 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
	<PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.7.1.189" />
    <ProjectReference Include="..\..\VikingXNAGraphics\MonographicsNet48.csproj" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8" />
    <ProjectReference Include="..\..\Monographics\Monographics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.config" />
  </ItemGroup>
  
  <!-- Include Windows Forms resource files -->
  <ItemGroup>
    <EmbeddedResource Include="BookmarkGeneralPage.resx" />
    <EmbeddedResource Include="FolderGeneralPage.resx" />
    <EmbeddedResource Include="FolderTreeControl.resx" />
  </ItemGroup>
  
  
</Project>