<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
	<LangVersion>9.0</LangVersion>
    <!-- Disable default embedded resource items to avoid duplicates -->
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <MonoGamePlatform>Windows</MonoGamePlatform>
    <NoWarn>$(NoWarn);CS0436;CA1014;CS3009</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
      <ModulesDir>..\Viking\Modules</ModulesDir>
      <ProjectModuleDir>$(ModulesDir)\$(MSBuildProjectName)</ProjectModuleDir>
	  <ProjectContentDir>$(ProjectDir)\Content\</ProjectContentDir>
	  <ProjectContentOutputDir>$(TargetDir)\Content\</ProjectContentOutputDir>
  </PropertyGroup>
  <!-- Post-build event to copy output to Modules folder -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
     
    <!-- Create Modules directory if it doesn't exist -->
    <Exec Command="if not exist &quot;$(ModulesDir)&quot; mkdir &quot;$(ModulesDir)&quot;" />
    
    <!-- Create project-specific directory if it doesn't exist -->
    <Exec Command="if not exist &quot;$(ProjectModuleDir)&quot; mkdir &quot;$(ProjectModuleDir)&quot;" />
    
    <!-- Ensure Content directory exists in target -->
    <Exec Command="if not exist &quot;$(ProjectModuleDir)\$(TargetFramework)\Content&quot; mkdir &quot;$(ProjectModuleDir)\$(TargetFramework)\Content&quot;" />
    
	  <!-- Copy project output to Modules folder (only newer files) -->
    <ItemGroup>
	    <FilesToCopy Include="$(TargetDir)**\*.*" />
    </ItemGroup>
	  
    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(ProjectModuleDir)\$(TargetFramework)\%(RecursiveDir)" SkipUnchangedFiles="true" />
	
  </Target>
  
  <!-- Clean target to remove copied files when build is cleaned -->
  <Target Name="CleanModules" AfterTargets="Clean"> 
    
    <!-- Remove the project-specific target framework folder -->
    <RemoveDir Directories="$(ProjectModuleDir)\$(TargetFramework)" ContinueOnError="true"/>
    
    <!-- Remove the project-specific folder if it's empty -->
    <RemoveDir Directories="$(ProjectModuleDir)" Condition="!Exists('$(ProjectModuleDir)\*')" ContinueOnError="true"/>
    
    <!-- Clean content compilation output -->
    <RemoveDir Directories="$(ProjectContentOutputDir)\bin" ContinueOnError="true"/>
    <RemoveDir Directories="$(ProjectContentOutputDir)\obj" ContinueOnError="true"/>
    <RemoveDir Directories="$(ProjectContentOutputDir)\bin" Condition="!Exists('$(ProjectContentOutputDir)\bin\*')" ContinueOnError="true"/>
    <RemoveDir Directories="$(ProjectContentOutputDir)\obj" Condition="!Exists('$(ProjectContentOutputDir)\obj\*')" ContinueOnError="true"/>
    <!-- Remove the Content folder if it's empty -->
    <RemoveDir Directories="$(ProjectContentOutputDir)" Condition="!Exists('$(ProjectContentOutputDir)\*')" ContinueOnError="true"/>
	  
  </Target>

  <!-- Compile MonoGame content (only for net48) -->
  <Target Name="CompileContent"
          AfterTargets="Build" 
          Condition="'$(TargetFramework)' == 'net48'"
          Inputs="Content\Content.mgcb;Content\Arrow.png;Content\Ring.png;Content\Star.png"
          Outputs="$(TargetDir)\Content\Arrow.xnb;$(TargetDir)\Content\Ring.xnb;$(TargetDir)\Content\Star.xnb">
	  <Message Text="Compiling MonoGame content for $(TargetFramework)..." Importance="normal" />
	  <Exec Command="&quot;C:\Program Files (x86)\MSBuild\MonoGame\v3.0\Tools\MGCB.exe&quot; /@:&quot;Content.mgcb&quot; /platform:Windows /outputDir:&quot;$(TargetDir)\Content&quot; /intermediateDir:&quot;$(MSBuildThisFileDirectory)Content\obj\$(TargetFramework)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)Content" StandardOutputImportance="high" ConsoleToMSBuild="true" />
	   
	  <Message Text="MonoGame content compilation completed." Importance="normal" />
  </Target>

  <!-- Include compiled MonoGame content -->
  <ItemGroup>
	  <Content Include="$(TargetDir)\Content\*.xnb">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		  <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
  </ItemGroup>

  <!-- Hide bin and obj folders from Visual Studio -->
  <ItemGroup>
	  <Folder Include="Content"/>
  </ItemGroup>

	<ItemGroup>
    <Compile Remove="Content\bin\**" />
    <Compile Remove="Content\obj\**" />
    <None Remove="Content\bin\**" />
    <None Remove="Content\obj\**" />
    <Page Remove="Content\bin\**" />
    <Page Remove="Content\obj\**" />
  </ItemGroup>
  
  <ItemGroup>
    
    <PackageReference Include="LinqToXsd" Version="2.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Geometry\Geometry.csproj" />
    <ProjectReference Include="..\NGVV\VikingCore.csproj" />
    <ProjectReference Include="..\..\VikingWPFUserControls\VikingWPFUserControls.csproj" />
    <ProjectReference Include="..\..\WCFTokenInjector\WCFTokenInjector.csproj" />
  </ItemGroup>
  
  <!-- Use VikingXNAGraphics for net48 and Monographics for net9.0 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
	<PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.7.1.189" />
    <ProjectReference Include="..\..\VikingXNAGraphics\VikingXNAGraphics.csproj" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8" />
    <ProjectReference Include="..\..\Monographics\Monographics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.config" />
  </ItemGroup>
  
  <!-- Include Windows Forms resource files -->
  <ItemGroup>
    <EmbeddedResource Include="BookmarkGeneralPage.resx" />
    <EmbeddedResource Include="FolderGeneralPage.resx" />
    <EmbeddedResource Include="FolderTreeControl.resx" />
  </ItemGroup>
  
  
</Project>