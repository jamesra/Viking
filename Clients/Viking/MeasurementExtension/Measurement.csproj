<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<UseWPF>true</UseWPF>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<!-- Disable default embedded resource items to avoid duplicates -->
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
		<!-- Disable auto-generated assembly info to use manual AssemblyInfo.cs -->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
	</PropertyGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.7.1.189" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
		<PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8" />
	</ItemGroup>
	<PropertyGroup>
		<ModulesDir>..\Viking\Modules</ModulesDir>
		<ProjectModulesDir>$(ModulesDir)\$(MSBuildProjectName)</ProjectModulesDir>
	</PropertyGroup>
	<!-- Post-build event to copy output to Modules folder -->
	<!-- Always run to ensure modules are copied, even on incremental builds -->
	<Target Name="PostBuild" AfterTargets="Build">
		<PropertyGroup>
			<OutputDirectory>$(OutDir)</OutputDirectory>
			<OutputDirectory Condition="'$(OutputDirectory)' == ''">$(OutputPath)</OutputDirectory>
		</PropertyGroup>

		<!-- Create Modules directory if it doesn't exist -->
		<MakeDir Directories="$(ModulesDir)" Condition="!Exists('$(ModulesDir)')" />
		<MakeDir Directories="$(ProjectModulesDir)" Condition="!Exists('$(ProjectModulesDir)')" />
		<MakeDir Directories="$(ProjectModulesDir)\$(Configuration)" Condition="!Exists('$(ProjectModulesDir)\$(Configuration)')" />
		<MakeDir Directories="$(ProjectModulesDir)\$(Configuration)\$(TargetFramework)" Condition="!Exists('$(ProjectModulesDir)\$(Configuration)\$(TargetFramework)')" />

		<!-- Copy project output to Modules folder -->
		<ItemGroup>
			<FilesToCopy Include="$(OutputDirectory)**\*.*" Exclude="$(OutputDirectory)**\*.pdb" />
		</ItemGroup>
		<Message Text="Copying from $(OutputDirectory) to $(ProjectModulesDir)\$(Configuration)\$(TargetFramework)\" Importance="high" />
		<Message Text="Files to copy: @(FilesToCopy->Count())" Importance="normal" />

		<Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(ProjectModulesDir)\$(Configuration)\$(TargetFramework)\%(RecursiveDir)" SkipUnchangedFiles="false" />
	</Target>

	<!-- Clean target to remove copied files when build is cleaned -->
	<!-- Note: We don't remove modules during clean because they're intermediate files that will be regenerated on build -->
	<!-- If you need to clean modules, do it manually or use a separate clean target -->
	<Target Name="CleanModules" AfterTargets="Clean">
		<!-- Only clean if explicitly requested via CleanModules property -->
		<!-- This prevents modules from being removed during Rebuild operations -->
		<RemoveDir Directories="$(ProjectModulesDir)\$(Configuration)\$(TargetFramework)" Condition="'$(CleanModules)' == 'true'" />
		<RemoveDir Directories="$(ProjectModulesDir)\$(Configuration)" Condition="'$(CleanModules)' == 'true' AND !Exists('$(ProjectModulesDir)\$(Configuration)\*')" />
		<RemoveDir Directories="$(ProjectModulesDir)" Condition="'$(CleanModules)' == 'true' AND !Exists('$(ProjectModulesDir)\*')" />
		<RemoveDir Directories="$(ModulesDir)" Condition="'$(CleanModules)' == 'true' AND !Exists('$(ModulesDir)\*')" />
	</Target>
	<ItemGroup> 
		
		<ProjectReference Include="..\..\..\Geometry\Geometry.csproj" />
		<ProjectReference Include="..\..\..\SIMeasurement\SIMeasurement.csproj" />
		<ProjectReference Include="..\..\Common\Common.csproj" />
		<ProjectReference Include="..\..\VolumeModel\VolumeModel.csproj" />
		<ProjectReference Include="..\NGVV\VikingCore.csproj" />
		<ProjectReference Include="..\VikingXNAWinForms\VikingXNAWinForms.csproj" />
		<ProjectReference Include="..\..\VikingXNAGraphics\MonographicsNet48.csproj" Condition=" '$(TargetFramework)' == 'net48' " />
		<ProjectReference Include="..\..\Monographics\Monographics.csproj" Condition=" '$(TargetFramework)' == 'net9.0-windows' " />
	</ItemGroup>
	<ItemGroup>
		<None Include="app.config" />
	</ItemGroup>

	<!-- Include Windows Forms resource files -->
	<ItemGroup>
		<EmbeddedResource Include="ScaleForm.resx" />
	</ItemGroup>
</Project>