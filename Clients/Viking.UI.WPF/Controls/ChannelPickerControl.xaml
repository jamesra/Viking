<UserControl x:Class="Viking.UI.WPF.Controls.ChannelPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="70"
             d:DesignWidth="600">
    <Border BorderBrush="#FFD5D5D5"
            BorderThickness="1"
            CornerRadius="4"
            Padding="6"
            Margin="0,0,0,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Channel"
                       FontWeight="Bold"
                       Grid.Row="0"
                       Grid.Column="0"
                       Visibility="{Binding LabelsVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <TextBlock Text="Section"
                       FontWeight="Bold"
                       Grid.Row="0"
                       Grid.Column="1"
                       Visibility="{Binding LabelsVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <TextBlock Text="Fixed #"
                       FontWeight="Bold"
                       Grid.Row="0"
                       Grid.Column="2"
                       Visibility="{Binding LabelsVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <TextBlock Text="Color"
                       FontWeight="Bold"
                       Grid.Row="0"
                       Grid.Column="3"
                       Visibility="{Binding LabelsVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <TextBlock Text="Preview"
                       FontWeight="Bold"
                       Grid.Row="0"
                       Grid.Column="4"
                       Visibility="{Binding LabelsVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}" />

            <ComboBox x:Name="ChannelCombo"
                      Grid.Row="1"
                      Grid.Column="0"
                      Margin="0,4,6,0"
                      IsEditable="False" />

            <ComboBox x:Name="SectionCombo"
                      Grid.Row="1"
                      Grid.Column="1"
                      Margin="0,4,6,0"
                      SelectionChanged="SectionCombo_OnSelectionChanged" />

            <TextBox x:Name="FixedSectionTextBox"
                     Grid.Row="1"
                     Grid.Column="2"
                     Margin="0,4,6,0"
                     MinWidth="60"
                     VerticalContentAlignment="Center" />

            <ComboBox x:Name="ColorCombo"
                      Grid.Row="1"
                      Grid.Column="3"
                      Margin="0,4,6,0"
                      SelectionChanged="ColorCombo_OnSelectionChanged" />

            <Border x:Name="ColorPreview"
                    Grid.Row="1"
                    Grid.Column="4"
                    Width="36"
                    Height="24"
                    Margin="0,4,6,0"
                    BorderBrush="#FF8C8C8C"
                    BorderThickness="1"
                    Background="White" />

            <Button x:Name="DeleteButton"
                    Grid.Row="1"
                    Grid.Column="5"
                    Content="Delete"
                    Width="70"
                    Margin="0,4,0,0"
                    Click="DeleteButton_OnClick" />
        </Grid>
    </Border>
</UserControl>

