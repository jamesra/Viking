<UserControl x:Class="Viking.UI.WPF.Controls.AnnotationServerSelectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Viking.UI.WPF.Converters"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600"
             Background="White">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Select Annotation Server"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,8"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Foreground="Gray"
                   HorizontalAlignment="Center"/>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Servers}"
                 SelectedItem="{Binding SelectedServer}"
                 MouseDoubleClick="Servers_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text=" (default)" Foreground="DarkGreen" Margin="6,0,0,0"
                                       Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AnnotationEndpoint}" FontFamily="Consolas" FontSize="11" Foreground="DimGray"/>
                        <TextBlock Text="{Binding BaseUrl}" FontFamily="Consolas" FontSize="10" Foreground="Gray"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3"
                   Text="Viking will request volume permissions for the selected annotation server."
                   Margin="0,12,0,8"
                   TextWrapping="Wrap"
                   Foreground="Gray"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="100" Margin="0,0,10,0" Command="{Binding CancelCommand}"/>
            <Button Content="Continue" Width="120" IsDefault="True" Command="{Binding SelectCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
