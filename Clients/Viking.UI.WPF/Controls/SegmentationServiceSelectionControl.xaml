<UserControl x:Class="Viking.UI.WPF.Controls.SegmentationServiceSelectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Viking.UI.WPF.ViewModels"
             xmlns:converters="clr-namespace:Viking.UI.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="600"
             Background="White">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="Select Segmentation Service" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center"/>

        <!-- Services Tree (Left Side) -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                       Text="Available Services: name, model, load (preferred first)" 
                       FontSize="14" 
                       FontWeight="Bold" 
                       Margin="0,0,0,10"/>

            <TreeView Grid.Row="1" 
                      Name="treeServices"
                      Grid.IsSharedSizeScope="True"
                      ItemsSource="{Binding ServiceNodes}"
                      SelectedItemChanged="treeServices_SelectedItemChanged"
                      MouseDoubleClick="treeServices_MouseDoubleClick">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Foreground" Value="#222222"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Service.IsUnreachable}" Value="True">
                                <Setter Property="Foreground" Value="#888888"/>
                                <Setter Property="Opacity" Value="0.55"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.Resources>
                    <!-- Name | Model | Load. Shared size groups line the columns up across rows; the model and load
                         come from the server itself (GetServerStatus), so they stay right when an Identity name is stale. -->
                    <HierarchicalDataTemplate DataType="{x:Type local:SegmentationServiceTreeNode}" 
                                              ItemsSource="{Binding Children}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ServiceName"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ServiceModel"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ServiceLoad"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}" 
                                       FontWeight="{Binding IsCategory, Converter={StaticResource BoolToFontWeightConverter}}"
                                       Margin="0,2"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Service.ModelSummary}"
                                       ToolTip="{Binding Service.ModelToolTip}"
                                       Margin="16,2,0,2"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Service.LoadSummary}"
                                       ToolTip="{Binding Service.LoadToolTip}"
                                       Margin="16,2,0,2"
                                       FontSize="11"
                                       Foreground="#666666"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>
        </Grid>

        <!-- Recent Services (Right Side) -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                       Text="Recent Services" 
                       FontSize="14" 
                       FontWeight="Bold" 
                       Margin="0,0,0,10"/>

            <ListBox Grid.Row="1" 
                     Name="lstRecentServices"
                     ItemsSource="{Binding RecentServices}"
                     DisplayMemberPath="Name"
                     SelectionChanged="lstRecentServices_SelectionChanged"
                     MouseDoubleClick="lstRecentServices_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="ToolTip" Value="{Binding Endpoint}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>

        <!-- Selected Service Endpoint Display -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                Margin="0,15,0,0"
                Padding="8"
                Background="#F5F5F5"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="3"
                Visibility="{Binding SelectedServiceEndpoint, Converter={StaticResource StringToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Selected Endpoint:" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="#666666"
                           FontSize="11"/>

                <TextBox Grid.Column="1" 
                         Text="{Binding SelectedServiceEndpoint, Mode=OneWay}"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         Focusable="True"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalAlignment="Center"
                         FontSize="11"
                         Foreground="#333333"
                         Padding="0">
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>

                <Button Grid.Column="2" 
                        Command="{Binding CopyEndpointCommand}"
                        ToolTip="Copy endpoint to clipboard"
                        Width="24"
                        Height="24"
                        Margin="5,0,0,0"
                        Padding="2"
                        Background="Transparent"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="16" Height="16">
                            <Rectangle Canvas.Left="4" Canvas.Top="0" Width="9" Height="11" 
                                       Stroke="#555555" StrokeThickness="1.2" Fill="Transparent"/>
                            <Rectangle Canvas.Left="0" Canvas.Top="4" Width="9" Height="11" 
                                       Stroke="#555555" StrokeThickness="1.2" Fill="White"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <!-- Manual Entry Expander (Bottom) -->
        <Expander Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                  Header="Advanced: Enter Segmentation Service Endpoint Manually"
                  Margin="0,15,0,10"
                  IsExpanded="{Binding ShowManualEntry}">
            <Grid Margin="10,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Endpoint:"
                           Margin="0,0,0,5"/>
                <TextBox Grid.Row="1" 
                         Text="{Binding ManualServiceEndpoint, UpdateSourceTrigger=PropertyChanged}"
                         Padding="5"
                         FontSize="12"/>
            </Grid>
        </Expander>

        <!-- Status Message -->
        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="{Binding StatusMessage}" 
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="0,5,0,10"
                   MinHeight="20"/>

        <!-- Buttons: None on the left so click-through from Login/Volume (Select in the same
             right-hand slot) keeps the last-used service instead of hitting None. -->
        <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
              Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="None"
                    Command="{Binding NoneCommand}"
                    Width="100"
                    Height="35"
                    FontSize="14"/>

            <Button Grid.Column="2"
                    Content="Select"
                    Command="{Binding SelectCommand}"
                    Width="100"
                    Height="35"
                    FontSize="14"
                    IsDefault="True"/>

            <Button Grid.Column="4"
                    Content="Back"
                    Command="{Binding CancelCommand}"
                    Width="100"
                    Height="35"
                    FontSize="14"
                    IsCancel="True"/>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="6" Grid.ColumnSpan="3"
              Background="#80FFFFFF"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Loading segmentation services..." 
                           FontSize="16" 
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>
                <ProgressBar IsIndeterminate="True" 
                             Width="200" 
                             Height="20"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>


