<UserControl x:Class="Viking.UI.WPF.Controls.LoginControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Viking.UI.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="500"
             Background="White">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="Viking Login" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center"/>

        <!-- Username -->
        <Label Grid.Row="1" 
               Content="Username:" 
               Margin="0,5,0,5"/>
        <TextBox Grid.Row="2" 
                 Name="txtUsername"
                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                 Padding="5"
                 FontSize="14"
                 Margin="0,0,0,10"/>

        <!-- Password -->
        <Label Grid.Row="3" 
               Content="Password:" 
               Margin="0,5,0,5"/>
        <PasswordBox Grid.Row="4" 
                     Name="txtPassword"
                     Padding="5"
                     FontSize="14"
                     Margin="0,0,0,10"
                     PasswordChanged="txtPassword_PasswordChanged"/>

        <!-- Identity Server URL -->
        <Label Grid.Row="5" 
               Content="Identity Server URL:" 
               Margin="0,5,0,5"/>
        <TextBox Grid.Row="6" 
                 Name="txtIdentityServerUrl"
                 Text="{Binding IdentityServerUrl, UpdateSourceTrigger=PropertyChanged}" 
                 Padding="5"
                 FontSize="14"
                 Margin="0,0,0,10"/>

        <!-- Remember Credentials -->
        <CheckBox Grid.Row="7" 
                  Content="Remember my credentials" 
                  IsChecked="{Binding RememberCredentials}"
                  Margin="0,10,0,10"
                  VerticalAlignment="Top"/>

        <!-- Status Message -->
        <TextBlock Grid.Row="8" 
                   Text="{Binding StatusMessage}" 
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="0,10,0,10"
                   MinHeight="20"/>

        <!-- Buttons -->
        <Grid Grid.Row="9" 
              Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" 
                    Content="Login" 
                    Command="{Binding LoginCommand}"
                    Width="100"
                    Height="35"
                    FontSize="14"
                    IsDefault="True"/>

            <Button Grid.Column="3" 
                    Content="Anonymous" 
                    Command="{Binding AnonymousCommand}"
                    Width="100"
                    Height="35"
                    FontSize="14"/>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="10"
              Background="#80FFFFFF"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Authenticating..." 
                           FontSize="16" 
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>
                <ProgressBar IsIndeterminate="True" 
                             Width="200" 
                             Height="20"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

