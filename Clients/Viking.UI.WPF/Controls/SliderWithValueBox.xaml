<UserControl x:Class="Viking.UI.WPF.Controls.SliderWithValueBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="30"
             d:DesignWidth="210">
    <!-- Slider and box are driven from code-behind, not bound, so a slider coercing its value while a bound
         Minimum or Maximum is still loading never writes that coerced value back to the preference. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Slider x:Name="PART_Slider"
                Grid.Column="0"
                Margin="5"
                VerticalAlignment="Center"
                PreviewMouseLeftButtonDown="OnSliderPreviewMouseLeftButtonDown"
                ValueChanged="OnSliderValueChanged"/>
        <TextBox x:Name="PART_ValueBox"
                 Grid.Column="1"
                 Margin="5,0,0,0"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Left"
                 PreviewKeyDown="OnValueBoxPreviewKeyDown"
                 GotKeyboardFocus="OnValueBoxGotKeyboardFocus"
                 LostKeyboardFocus="OnValueBoxLostKeyboardFocus"/>
    </Grid>
</UserControl>
