<Window x:Class="Viking.UI.WPF.SegmentationServiceSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Viking.UI.WPF.Controls"
        Title="Viking - Select Segmentation Service"
        Height="560"
        Width="680"
        MinHeight="420"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <DockPanel>
        <Border x:Name="errorBanner"
                DockPanel.Dock="Top"
                Visibility="Collapsed"
                Background="#FFFDECEA"
                BorderBrush="#FFC80000"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <TextBlock x:Name="errorText"
                       Foreground="#FFC80000"
                       TextWrapping="Wrap"/>
        </Border>
        <controls:SegmentationServiceSelectionControl x:Name="segmentationSelectionControl"/>
    </DockPanel>
</Window>
