<Window x:Class="Viking.UI.WPF.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command Help" Width="460" Height="520" MinWidth="240" MinHeight="160"
        ShowInTaskbar="False" UseLayoutRounding="True" WindowStartupLocation="Manual"
        ResizeMode="CanResize" FontSize="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,8,10,8">
        <!-- One star column per column of help rows; HelpWindow.Layout fills it. -->
        <Grid x:Name="Columns" />
    </ScrollViewer>
</Window>
