<UserControl x:Class="Viking.UI.WPF.HelpBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Viking.UI.WPF"
             mc:Ignorable="d"
             d:DesignHeight="50" d:DesignWidth="300"
             IsTabStop="False"
             Focusable="False"
             Margin="0" Padding="0">
    <UserControl.Resources>
        <local:HelpRowConverter x:Key="HelpRow" />
    </UserControl.Resources>
    <Grid>
    <!-- The combo box draws the strip and drops down the whole list; it never keeps a selection, because the strip's
         entries are drawn by the page grid laid over it (HelpBar.ShowPage), as many side by side as fit. -->
    <ComboBox Name="comboHelp" IsEditable="False" FontSize="14" IsTabStop="False" Focusable="False">
        <!-- One shared-size scope for the dropdown, so every row's keys end at the same right edge (HelpRowConverter.KeysColumn).
             Not virtualized: an unrealized row would not take part in the shared width. -->
        <ComboBox.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Grid.IsSharedSizeScope="True" />
            </ItemsPanelTemplate>
        </ComboBox.ItemsPanel>
        <ComboBox.ItemTemplate>
            <DataTemplate>
                <ContentControl Focusable="False" Content="{Binding Converter={StaticResource HelpRow}}" />
            </DataTemplate>
        </ComboBox.ItemTemplate>
        <ComboBox.ItemContainerStyle>
            <Style TargetType="ComboBoxItem">
                <Style.Triggers>
                    <!-- The divider between plain-text and keyed lines cannot be picked. -->
                    <DataTrigger Binding="{Binding IsDivider}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ComboBox.ItemContainerStyle>
    </ComboBox>
    <Grid Name="page" IsHitTestVisible="False" ClipToBounds="True" Margin="6,0,24,0" VerticalAlignment="Center"
          TextElement.FontSize="14" />
    </Grid>
</UserControl>
