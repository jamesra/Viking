<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
	<LangVersion>latest</LangVersion>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows</TargetFramework>
		<!-- Force Visual Studio to use CoreCLR debugger (required for .NET Core / .NET 5+) -->
		<UseCoreDebugger>true</UseCoreDebugger>
		<RollForward>Major</RollForward>
		<RootNamespace>MonogameTestbed</RootNamespace>
		<AssemblyName>MonogameTestbed</AssemblyName>
		<Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<MonoGamePlatform>DesktopGL</MonoGamePlatform>
		<SignManifests>true</SignManifests>
		<ManifestCertificateThumbprint>2BADCE24EC984EC73C686B32B12C48B543B4441C</ManifestCertificateThumbprint>
		<UseWPF>False</UseWPF>
		<ProduceReferenceAssembly>False</ProduceReferenceAssembly>
		<PublishAot>False</PublishAot>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="MonogameTestbedTests" />
	</ItemGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
		<DefineConstants>DEBUG;TRACE;WINDOWS</DefineConstants>
		<Optimize>False</Optimize>
		<PlatformTarget>x64</PlatformTarget>
		<!-- Ensure debug symbols are produced so breakpoints bind in MSVC -->
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<EmbedAllSources>true</EmbedAllSources>
		<!-- Using standard output path so native DLLs are deployed correctly -->
		<!-- <OutputPath>bin\Windows\x64\Debug\</OutputPath> -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
		<DefineConstants>WINDOWS</DefineConstants>
		<Optimize>True</Optimize>
		<PlatformTarget>x64</PlatformTarget>
		<!-- Using standard output path so native DLLs are deployed correctly -->
		<!-- <OutputPath>bin\Windows\x64\Release\</OutputPath> -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup> 
		<None Include="**\*.json" CopyToOutputDirectory="PreserveNewest" /> 
		<Compile Remove=".vs\**" /> 
		<Compile Remove="bin\**" /> 
		<Compile Remove="obj\**" /> 
		<EmbeddedResource Remove=".vs\**" /> 
		<EmbeddedResource Remove="bin\**" /> 
		<EmbeddedResource Remove="obj\**" /> 
		<None Remove=".vs\**" /> 
		<None Remove="bin\**" /> 
		<None Remove="obj\**" />
		<None Include="Properties\Settings.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5-preview.3" />
		<PackageReference Include="MonoGame.Framework.Native" Version="3.8.5-preview.3" />
		<PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5-preview.3" />
		<Reference Include="System.Drawing" />
		<PackageReference Include="CommandLineParser" Version="2.9.1" />
		<PackageReference Include="EntityFramework" Version="6.5.1" />
		<PackageReference Include="FsCheck" Version="2.16.3" />
		<PackageReference Include="FSharp.Core" Version="5.0.2" />
		<PackageReference Include="MathNet.Numerics" Version="5.0.0" />
		<PackageReference Include="MIConvexHull" Version="1.1.19.1019" />
		<PackageReference Include="Microsoft.Net.Http" Version="2.2.29" />
		<PackageReference Include="Microsoft.OData.Client" Version="8.1.0" />
		<PackageReference Include="Microsoft.OData.Core" Version="8.1.0" />
		<PackageReference Include="Microsoft.OData.Edm" Version="8.1.0" />
		<PackageReference Include="Microsoft.Spatial" Version="8.1.0" />
		<PackageReference Include="Microsoft.SqlServer.Types" Version="160.1000.6" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="System.Collections.Immutable" Version="9.0.8" />
		<PackageReference Include="System.Security.Cryptography.X509Certificates" Version="4.3.2" />
		<PackageReference Include="System.Text.Json" Version="9.0.8" />
		<PackageReference Include="System.Drawing.Common" Version="9.0.8" />
		<PackageReference Include="System.Diagnostics.Debug" Version="4.3.0" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.8" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
	</ItemGroup>
	<ItemGroup>
		<MonoGameContentReference Include="Content\Content.mgcb" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\AnnotationInterfaces\AnnotationInterfaces.csproj" />
		<ProjectReference Include="..\..\AnnotationVizLibODataClient\AnnotationVizLibODataClient.csproj" />
		<ProjectReference Include="..\..\AnnotationVizLib\AnnotationVizLib.csproj" />
		<ProjectReference Include="..\..\ColladaIO\ColladaIO.csproj" />
		<ProjectReference Include="..\..\GeometryTests\GeometryTests.csproj" />
		<ProjectReference Include="..\..\Geometry\Geometry.csproj" />
		<ProjectReference Include="..\..\GraphLib\GraphLib.csproj" />
		<ProjectReference Include="..\..\MIConvexHullExtensions\MIConvexHullExtensions.csproj" />
		<ProjectReference Include="..\..\MorphologyMesh\MorphologyMesh.csproj" />
		<ProjectReference Include="..\..\RTree\RTree.csproj" />
		<ProjectReference Include="..\..\Triangle.NET\Triangle\Triangle.csproj" />
		<ProjectReference Include="..\..\TriangleNetGeometryExtensions\TriangleNetGeometryExtensions.csproj" />
		<ProjectReference Include="..\..\UnitsAndScale\UnitsAndScale.csproj" />
		<ProjectReference Include="..\MonogameMathNetExtensions.cs\MonogameMathNetExtensions.csproj" />
		<ProjectReference Include="..\Monographics\Monographics.csproj" />
		<ProjectReference Include="..\..\ODataClient\ODataClient.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="SqlServerTypes\x64\msvcr120.dll" CopyToOutputDirectory="Always" />
		<Content Include="SqlServerTypes\x64\SqlServerSpatial140.dll" CopyToOutputDirectory="Always" />
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	  </EmbeddedResource>
	</ItemGroup>

	<!-- Ensure content is built for DesktopGL (must match MonoGamePlatform and runtime) -->
	<PropertyGroup>
		<MonoGameMGCBAdditionalArguments Condition="'$(MonoGameMGCBAdditionalArguments)' != ''">$(MonoGameMGCBAdditionalArguments) /platform:DesktopGL</MonoGameMGCBAdditionalArguments>
		<MonoGameMGCBAdditionalArguments Condition="'$(MonoGameMGCBAdditionalArguments)' == ''">/quiet /platform:DesktopGL</MonoGameMGCBAdditionalArguments>
	</PropertyGroup>

	<!-- Copy built content to output so ContentManager loads DesktopGL .xnb from Content\ next to executable.
	     Pipeline writes to Content\bin\DesktopGL (project) and the task copies to $(TargetDir)bin\DesktopGL.
	     We copy from both into $(TargetDir)Content so Load&lt;T&gt;("RoundLine") finds the correct .xnb. -->
	<Target Name="CopyMonogameContentBin" AfterTargets="Build">
		<ItemGroup>
			<!-- Pipeline output in project: bin\DesktopGL, bin\Monographics, bin\MonogameXNAGraphicsShared, etc. -->
			<MonogameContentFiles Include="$(ProjectDir)Content\bin\**\*.*" />
		</ItemGroup>
		<ItemGroup Condition="Exists('$(TargetDir)bin\DesktopGL')">
			<!-- Task copies to TargetDir\bin\DesktopGL when building -->
			<MonogameContentFilesFromTarget Include="$(TargetDir)bin\DesktopGL\**\*.*" />
		</ItemGroup>
		<MakeDir Directories="$(TargetDir)Content" />
		<Copy SourceFiles="@(MonogameContentFiles)" DestinationFiles="@(MonogameContentFiles->'$(TargetDir)Content\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
		<!-- Prefer task output (DesktopGL) in bin\DesktopGL so it overwrites any project copy -->
		<Copy SourceFiles="@(MonogameContentFilesFromTarget)" DestinationFiles="@(MonogameContentFilesFromTarget->'$(TargetDir)Content\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
		
		<!-- Copy MonoGame native DLLs to output directory for both command line and Visual Studio debugging -->
		<Copy SourceFiles="$(NuGetPackageRoot)monogame.library.sdl\2.32.2.1\runtimes\win-x64\native\SDL2.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('$(NuGetPackageRoot)monogame.library.sdl\2.32.2.1\runtimes\win-x64\native\SDL2.dll')" />
		<Copy SourceFiles="$(NuGetPackageRoot)monogame.library.openal\1.23.1.1\runtimes\win-x64\native\openal.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('$(NuGetPackageRoot)monogame.library.openal\1.23.1.1\runtimes\win-x64\native\openal.dll')" />
	</Target>
	
</Project>
