<Window x:Class="MonogameTestbed.HotkeyHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonogameTestbed — Help"
        Width="640"
        Height="520"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#FF2B2B2B"
        Foreground="White">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Close" Width="96" Height="28" IsDefault="True" IsCancel="True" Click="Close_Click"/>
    </StackPanel>
    <TextBlock x:Name="SubtitleText"
               DockPanel.Dock="Top"
               Margin="0,0,0,8"
               FontSize="14"
               TextWrapping="Wrap"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="SectionsList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <DataGrid ItemsSource="{Binding Bindings}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        Background="#FF333333"
                        Foreground="White"
                        RowBackground="#FF333333"
                        AlternatingRowBackground="#FF3A3A3A"
                        BorderBrush="#FF555555"
                        BorderThickness="1">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Key" Binding="{Binding Keys}" Width="180"/>
                  <DataGridTextColumn Header="Action" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
