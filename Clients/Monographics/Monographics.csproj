<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
	<LangVersion>latest</LangVersion>
		<OutputType>Library</OutputType>
		<TargetFramework>net9.0-windows</TargetFramework>
		<RootNamespace>VikingXNAGraphics</RootNamespace>
		<AssemblyName>Monographics</AssemblyName>
		<MonoGamePlatform>DesktopGL</MonoGamePlatform>
		<SignManifests>true</SignManifests>
		<SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
		<GenerateDocumentationFile>False</GenerateDocumentationFile>
	</PropertyGroup>
	
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<Optimize>false</Optimize>
		<OutputPath>bin\MonoGame\Debug\</OutputPath>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<UseVSHostingProcess>true</UseVSHostingProcess>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants></DefineConstants>
		<Optimize>true</Optimize>
		<OutputPath>bin\MonoGame\Release\</OutputPath>
		<DebugType>pdbonly</DebugType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.5-preview.3" />
		<PackageReference Include="System.Collections.Immutable" Version="9.0.8" />
		<PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5-preview.3" />
	</ItemGroup>
	<ItemGroup>
		<MonoGameContentReference Include="Content\Content.mgcb" />
		<None Include="app.config" />
		<Compile Include="..\MonogameXNAGraphicsShared\**\*.cs" Exclude="..\MonogameXNAGraphicsShared\obj\**;..\MonogameXNAGraphicsShared\bin\**" />
	</ItemGroup>
	<ItemGroup Label="Content">
		<None Include=".config\**\*" />
		<None Include="Content\**\*.fx" />
		<None Include="Content\**\*.png" />
	</ItemGroup> 
	<ItemGroup>
		<ProjectReference Include="..\..\AnnotationVizLib\AnnotationVizLib.csproj" />
		<ProjectReference Include="..\..\Geometry\Geometry.csproj" />
		<ProjectReference Include="..\..\Triangle.NET\Triangle\Triangle.csproj" />
		<ProjectReference Include="..\..\TriangleNetGeometryExtensions\TriangleNetGeometryExtensions.csproj" />
	</ItemGroup>
	<ItemGroup>
		<None Include="app.config" />
	</ItemGroup>
	<Target Name="RestoreDotnetTools" BeforeTargets="Restore">
		<Message Text="Restoring dotnet tools" Importance="High" />
		<Exec Command="dotnet tool restore" />
	</Target>
	
	<!-- Override MGCB command to use direct path to mgcb.dll from NuGet packages -->
	<Target Name="OverrideMGCBCommand" BeforeTargets="RunContentBuilder">
		<PropertyGroup>
			<_MGCBDllPath>$(NuGetPackageRoot)dotnet-mgcb\3.8.5-preview.3\tools\net8.0\any\mgcb.dll</_MGCBDllPath>
			<_Command Condition="Exists('$(_MGCBDllPath)')">&quot;$(DotnetCommand)&quot; &quot;$(_MGCBDllPath)&quot;</_Command>
		</PropertyGroup>
	</Target>
</Project>
