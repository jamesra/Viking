<Window x:Class="WebAnnotation.WPF.Forms.AnnotationPreferencesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:WebAnnotation.WPF.Forms"
        xmlns:controls="clr-namespace:WebAnnotation.WPF.Controls"
        Title="Annotation Preferences" 
        Height="750" 
        Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="500"
        MinWidth="480">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="5,5,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="xctk:IntegerUpDown">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="25"/>
        </Style>
        <Style TargetType="xctk:DoubleUpDown">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="25"/>
        </Style>
        <Style x:Key="VisualsHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Margin" Value="10"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Basic Settings -->
                <Expander Header="Basic Settings" IsExpanded="True" Margin="10">
                    <StackPanel Margin="10">
                        <!-- Num Sections In Memory -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Label Grid.Row="0" Grid.Column="0" Content="Sections in Memory:"/>
                            <xctk:IntegerUpDown Grid.Row="0" Grid.Column="1" 
                                              Value="{Binding NumSectionsInMemory}" 
                                              Minimum="1" 
                                              Maximum="100"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Number of sections to keep in memory. Minimum of 3 recommended for smooth navigation."/>
                        </Grid>

                        <!-- Num Sections Loading -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Label Grid.Row="0" Grid.Column="0" Content="Concurrent Section Loads:"/>
                            <xctk:IntegerUpDown Grid.Row="0" Grid.Column="1" 
                                              Value="{Binding NumSectionsLoading}" 
                                              Minimum="1" 
                                              Maximum="50"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Maximum number of sections to load simultaneously. Higher values load faster but use more bandwidth."/>
                        </Grid>

                        <!-- Default Closed Line Width -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Label Grid.Row="0" Grid.Column="0" Content="Default Line Width:"/>
                            <xctk:DoubleUpDown Grid.Row="0" Grid.Column="1" 
                                             Value="{Binding DefaultClosedLineWidth}" 
                                             Minimum="1.0" 
                                             Maximum="100.0"
                                             Increment="1.0"
                                             FormatString="F1"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Default width in pixels for newly created closed curve annotations."/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Visuals: settings that change only how the view looks -->
                <Expander Header="Visuals" IsExpanded="False" Margin="10">
                    <StackPanel Margin="10">
                        <TextBlock Style="{StaticResource VisualsHeading}" Text="Text"/>
                        <!-- Location Text Scale Factor -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Label Grid.Row="0" Grid.Column="0" Content="Location Text Scale:"/>
                            <xctk:DoubleUpDown Grid.Row="0" Grid.Column="1" 
                                             Value="{Binding LocationTextScaleFactor}" 
                                             Minimum="0.1" 
                                             Maximum="50.0"
                                             Increment="0.5"
                                             FormatString="F1"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Size multiplier for annotation labels. Increase for better readability on high-resolution displays."/>
                        </Grid>

                        <!-- Reference Location Text Scale Factor -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Label Grid.Row="0" Grid.Column="0" Content="Reference Text Scale:"/>
                            <xctk:DoubleUpDown Grid.Row="0" Grid.Column="1" 
                                             Value="{Binding ReferenceLocationTextScaleFactor}" 
                                             Minimum="0.1" 
                                             Maximum="50.0"
                                             Increment="0.5"
                                             FormatString="F1"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Size multiplier for reference location text on adjacent sections."/>
                        </Grid>

                        <TextBlock Style="{StaticResource VisualsHeading}" Text="Annotations"/>
                        <!-- Polygon Opacity Parentless -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Label Grid.Row="0" Grid.Column="0" Content="Polygon Opacity (Parentless):"/>
                            <Slider Grid.Row="0" Grid.Column="1"
                                    Value="{Binding PolygonOpacityParentless, Mode=TwoWay}"
                                    Minimum="0"
                                    Maximum="1"
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="True"
                                    Margin="5"/>
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Text="{Binding PolygonOpacityParentless, StringFormat='F2'}"
                                     IsReadOnly="True"
                                     Margin="5,0,0,0"
                                     VerticalAlignment="Center"
                                     Width="50"
                                     HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Opacity for polygons without a parent structure. Range: 0.0 (transparent) to 1.0 (opaque)."/>
                        </Grid>

                        <!-- Polygon Opacity With Parent -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Label Grid.Row="0" Grid.Column="0" Content="Polygon Opacity (With Parent):"/>
                            <Slider Grid.Row="0" Grid.Column="1"
                                    Value="{Binding PolygonOpacityWithParent, Mode=TwoWay}"
                                    Minimum="0"
                                    Maximum="1"
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="True"
                                    Margin="5"/>
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Text="{Binding PolygonOpacityWithParent, StringFormat='F2'}"
                                     IsReadOnly="True"
                                     Margin="5,0,0,0"
                                     VerticalAlignment="Center"
                                     Width="50"
                                     HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Opacity for polygons with a parent structure. Range: 0.0 (transparent) to 1.0 (opaque)."/>
                        </Grid>

                        <!-- Circle Opacity Parentless -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Label Grid.Row="0" Grid.Column="0" Content="Circle Opacity (Parentless):"/>
                            <Slider Grid.Row="0" Grid.Column="1"
                                    Value="{Binding CircleOpacityParentless, Mode=TwoWay}"
                                    Minimum="0"
                                    Maximum="1"
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="True"
                                    Margin="5"/>
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Text="{Binding CircleOpacityParentless, StringFormat='F2'}"
                                     IsReadOnly="True"
                                     Margin="5,0,0,0"
                                     VerticalAlignment="Center"
                                     Width="50"
                                     HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Opacity for circles without a parent structure. Range: 0.0 (transparent) to 1.0 (opaque)."/>
                        </Grid>

                        <!-- Circle Opacity With Parent -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Label Grid.Row="0" Grid.Column="0" Content="Circle Opacity (With Parent):"/>
                            <Slider Grid.Row="0" Grid.Column="1"
                                    Value="{Binding CircleOpacityWithParent, Mode=TwoWay}"
                                    Minimum="0"
                                    Maximum="1"
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="True"
                                    Margin="5"/>
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Text="{Binding CircleOpacityWithParent, StringFormat='F2'}"
                                     IsReadOnly="True"
                                     Margin="5,0,0,0"
                                     VerticalAlignment="Center"
                                     Width="50"
                                     HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Opacity for circles with a parent structure. Range: 0.0 (transparent) to 1.0 (opaque)."/>
                        </Grid>

                        <!-- Adjacent Location Radius Scalar -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Label Grid.Row="0" Grid.Column="0" Content="Adjacent Section Radius:"/>
                            <xctk:DoubleUpDown Grid.Row="0" Grid.Column="1" 
                                             Value="{Binding AdjacentLocationRadiusScalar}" 
                                             Minimum="0.1" 
                                             Maximum="2.0"
                                             Increment="0.1"
                                             FormatString="F2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Size multiplier for annotations displayed on adjacent sections. Default 0.5 shows them at half size."/>
                        </Grid>

                        <controls:CircleSizePreviewSlider
                            Header="Smallest Rendered Size:"
                            Description="Minimum on-screen circle diameter before an annotation is hidden. The circle below shows the cutoff; the slider max is the width of this page."
                            Value="{Binding SmallestRenderedSize, Mode=TwoWay}"
                            Minimum="0.5"
                            TickFrequency="0.1"
                            PreviewMode="PixelDiameter"/>

                        <!-- Num Curve Interpolation Points -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Label Grid.Row="0" Grid.Column="0" Content="Curve Display Points:"/>
                            <xctk:IntegerUpDown Grid.Row="0" Grid.Column="1" 
                                              Value="{Binding NumClosedCurveInterpolationPointsForDisplay}" 
                                              Minimum="2" 
                                              Maximum="20"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Controls visual smoothness of curves. Higher values produce smoother curves but slower rendering, loading, and manipulation."/>
                        </Grid>

                        <TextBlock Style="{StaticResource VisualsHeading}" Text="Control points"/>
                        <!-- Polygon vertex point display diameter info -->
                        <TextBlock Margin="10,0,10,5" FontSize="10" Foreground="Gray"
                                   Text="{Binding PolygonVertexDisplayDiameterPx, StringFormat='Current display diameter: {0} px (at current viewport)'}"/>

                        <!-- Polygon Point Diameter -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Label Grid.Row="0" Grid.Column="0" Content="Polygon Point Diameter:"/>
                            <Slider Grid.Row="0" Grid.Column="1"
                                    Value="{Binding PolygonPointDiameter, Mode=TwoWay}"
                                    Minimum="2"
                                    Maximum="100"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Margin="5"/>
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Text="{Binding PolygonPointDiameter, StringFormat='F0'}"
                                     IsReadOnly="True"
                                     Margin="5,0,0,0"
                                     VerticalAlignment="Center"
                                     Width="50"
                                     HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Diameter in world units for control points on polygon annotations. Range: 2 to 100."/>
                        </Grid>

                        <!-- Vertex points visibility range (RangeSlider) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Content="Vertex points visible/hidden at width:"/>
                            <xctk:RangeSlider Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                    Minimum="0.00005"
                                    Maximum="0.02"
                                    LowerValue="{Binding PolygonVertexPointsHiddenAtWidthFraction, Mode=TwoWay}"
                                    HigherValue="{Binding PolygonVertexPointsVisibleAtWidthFraction, Mode=TwoWay}"
                                    Step="0.00005"
                                    Margin="5"/>
                            <TextBlock Grid.Row="1" Grid.Column="3"
                                     Text="{Binding VertexVisibilityRangeDisplay}"
                                     Margin="5,0,0,0"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Left"
                                     TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Left thumb: hidden below this width fraction. Right thumb: fully visible above this fraction. Pixel values at current viewport width."/>
                        </Grid>

                        <!-- Polygon Point Opacity -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Polygon Point Opacity:"/>
                            <Slider Grid.Row="0" Grid.Column="1"
                                    Value="{Binding PolygonPointOpacity, Mode=TwoWay}"
                                    Minimum="0"
                                    Maximum="1"
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="True"
                                    Margin="5"/>
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Text="{Binding PolygonPointOpacity, StringFormat='F2', Mode=OneWay}"
                                     IsReadOnly="True"
                                     Margin="5,0,0,0"
                                     VerticalAlignment="Center"
                                     Width="50"
                                     HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Opacity of the control points on polygon annotations. Range: 0.0 (transparent) to 1.0 (opaque)."/>
                        </Grid>

                        <!-- Hide Polygon Points In Pen Mode -->
                        <CheckBox Content="Hide polygon points in pen mode"
                                  IsChecked="{Binding HidePolygonPointsInPenMode, Mode=TwoWay}"
                                  Margin="5,5,5,10"/>

                        <controls:CircleSizePreviewSlider
                            Header="Segmentation Point Radius:"
                            Description="Radius in pixels for segmentation prompt points on the image. The circle below is the on-screen size."
                            Value="{Binding SegmentationPointRadius, Mode=TwoWay}"
                            Minimum="1"
                            TickFrequency="0.1"
                            PreviewMode="PixelRadius"/>

                        <TextBlock Style="{StaticResource VisualsHeading}" Text="Location links"/>
                        <!-- Location Link Waist Width -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Link waist width (pixels):"/>
                            <Slider Grid.Row="0" Grid.Column="1"
                                    Value="{Binding LocationLinkWaistPixels, Mode=TwoWay}"
                                    Minimum="2"
                                    Maximum="32"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Margin="5"/>
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Text="{Binding LocationLinkWaistPixels, StringFormat='F0'}"
                                     IsReadOnly="True"
                                     Margin="5,0,0,0"
                                     VerticalAlignment="Center"
                                     Width="50"
                                     HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Screen width of the narrowest part of a link line between locations on different sections."/>
                        </Grid>

                        <!-- Location Link Under Markers -->
                        <CheckBox IsChecked="{Binding LocationLinkDrawUnderMarkers, Mode=TwoWay}"
                                  Content="Draw links under location markers"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock Margin="10,0,10,10"
                                   FontSize="10"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Text="Also draws each link under its two location markers as a round end the size of each marker. Off draws nothing under the markers."/>

                        <!-- Location Link Visibility -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Link visibility (%):"/>
                            <Slider Grid.Row="0" Grid.Column="1"
                                    Value="{Binding LocationLinkVisibilityPercent, Mode=TwoWay}"
                                    Minimum="10"
                                    Maximum="100"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    Margin="5"/>
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Text="{Binding LocationLinkVisibilityPercent, StringFormat='F0'}"
                                     IsReadOnly="True"
                                     Margin="5,0,0,0"
                                     VerticalAlignment="Center"
                                     Width="50"
                                     HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="How strongly links between locations on different sections are drawn when the mouse is not over them: their opacity next to the linked locations and the strength of the contrasting shadow around them. The middle of a link fades to nothing; move the mouse over a link to see all of it."/>
                        </Grid>

                        <!-- Location Link Labels -->
                        <CheckBox IsChecked="{Binding LocationLinkLabels, Mode=TwoWay}"
                                  Content="Label link ends with the linked location ID"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock Margin="10,0,10,10"
                                   FontSize="10"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Text="While the mouse is over a link, shows next to each end the ID of the location at the other end. At the end on the viewed section, an up or down arrow shows whether that location is on a higher or lower section. Sized from the location, so they zoom with the image; left out when too small to read or when the link is too short for both."/>

                        <TextBlock Style="{StaticResource VisualsHeading}" Text="Auto-segmentation"/>
                        <CheckBox Margin="0,10,0,0"
                                  IsChecked="{Binding AutoPolygonizeShimmerEnabled, Mode=TwoWay}"
                                  Content="Shimmer new auto-segmentations"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock Margin="10,0,10,10"
                                   FontSize="10"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Text="Sweeps a band of white lines across each auto-polygonize result once when it first appears."/>
                        <Grid IsEnabled="{Binding AutoPolygonizeShimmerEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Shimmer brightness:"/>
                            <Slider Grid.Row="0" Grid.Column="1"
                                    Value="{Binding AutoPolygonizeShimmerBrightness, Mode=TwoWay}"
                                    Minimum="0.1"
                                    Maximum="1"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    Margin="5"/>
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Text="{Binding AutoPolygonizeShimmerBrightness, StringFormat='F2'}"
                                     IsReadOnly="True"
                                     Margin="5,0,0,0"
                                     VerticalAlignment="Center"
                                     Width="50"
                                     HorizontalAlignment="Left"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="Shimmer duration (ms):"/>
                            <Slider Grid.Row="1" Grid.Column="1"
                                    Value="{Binding AutoPolygonizeShimmerDurationMs, Mode=TwoWay}"
                                    Minimum="250"
                                    Maximum="1000"
                                    TickFrequency="50"
                                    IsSnapToTickEnabled="True"
                                    Margin="5"/>
                            <TextBox Grid.Row="1" Grid.Column="3"
                                     Text="{Binding AutoPolygonizeShimmerDurationMs, StringFormat='F0'}"
                                     IsReadOnly="True"
                                     Margin="5,0,0,0"
                                     VerticalAlignment="Center"
                                     Width="50"
                                     HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Section Corrections -->
                <Expander Header="Section Corrections" IsExpanded="False" Margin="10">
                    <StackPanel Margin="10">
                        <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" Foreground="Gray" FontSize="11"
                                   Text="When the open annotation context has a correction service, each section's image is shifted to line up with its neighbors. The shift is not accurate when zoomed out, so it fades in as you zoom in: none at or above the start downsample, full at or below the end downsample. Annotations move with the image and are always saved at their true position. The status bar shows whether a correction service is present and lets you turn it on or off."/>
                        <CheckBox Margin="0,0,0,10"
                                  IsChecked="{Binding CorrectionShimEnabled, Mode=TwoWay}"
                                  Content="Apply section corrections"
                                  VerticalContentAlignment="Center"/>
                        <CheckBox Margin="0,0,0,10"
                                  IsChecked="{Binding CorrectionShimShowOffset, Mode=TwoWay}"
                                  Content="Show the correction offset (nm) in the status bar"
                                  VerticalContentAlignment="Center"/>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Start fading in at downsample:"/>
                            <xctk:DoubleUpDown Grid.Column="1"
                                               Value="{Binding CorrectionShimFadeStartDownsample}"
                                               Minimum="0.25"
                                               Maximum="256"
                                               Increment="1.0"
                                               FormatString="F1"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Fully applied at downsample:"/>
                            <xctk:DoubleUpDown Grid.Column="1"
                                               Value="{Binding CorrectionShimFadeEndDownsample}"
                                               Minimum="0.25"
                                               Maximum="256"
                                               Increment="1.0"
                                               FormatString="F1"/>
                        </Grid>
                        <TextBlock Margin="10,0,10,0" FontSize="10" Foreground="Gray" TextWrapping="Wrap"
                                   Text="The start must be larger than the end. Defaults: 8 and 4."/>
                    </StackPanel>
                </Expander>

                <Expander Header="Advanced Settings" IsExpanded="False" Margin="10">
                    <StackPanel Margin="10">
                        <!-- General -->
                        <TextBlock Text="General" FontWeight="Bold" Margin="5,5,5,2"/>
                        <!-- Default Location Jump Downsample -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Label Grid.Row="0" Grid.Column="0" Content="Jump Zoom Downsample:"/>
                            <xctk:DoubleUpDown Grid.Row="0" Grid.Column="1" 
                                             Value="{Binding DefaultLocationJumpDownsample}" 
                                             Minimum="1.0" 
                                             Maximum="64.0"
                                             Increment="1.0"
                                             FormatString="F1"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Controls zoom level when jumping to locations. Higher values zoom out more (location occupies 1/8 screen width ÷ this value)."/>
                        </Grid>

                        <!-- Hide Annotation Seconds -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Hide annotation time (seconds):"/>
                            <xctk:IntegerUpDown Grid.Row="0" Grid.Column="1"
                                              Value="{Binding HideAnnotationSeconds}"
                                              Minimum="1"
                                              Maximum="600"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Del hides what a click under the mouse would pick (an annotation, link or auto-segmentation ring) for this long, so one beneath it can be reached; it fades back in at the end. Insert brings it back early."/>
                        </Grid>

                        <!-- Polygon Annotations -->
                        <TextBlock Text="Polygon Annotations" FontWeight="Bold" Margin="5,15,5,2"/>
                        <!-- Pen Simplify Threshold -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Label Grid.Row="0" Grid.Column="0" Content="Pen Simplify Threshold:"/>
                            <xctk:IntegerUpDown Grid.Row="0" Grid.Column="1" 
                                              Value="{Binding PenSimplifyThreshold}" 
                                              Minimum="1" 
                                              Maximum="100"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="How far, in volume pixels, a pen outline may drift from the stroke, whatever the zoom. Pen strokes never use more than 2, so a stroke drawn zoomed out stays on the membrane. Smaller numbers follow the stroke more closely with more points."/>
                        </Grid>

                        <!-- Circle Annotations -->
                        <TextBlock Text="Circle Annotations" FontWeight="Bold" Margin="5,15,5,2"/>
                        <!-- Min Radius -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Label Grid.Row="0" Grid.Column="0" Content="Minimum Radius:"/>
                            <xctk:DoubleUpDown Grid.Row="0" Grid.Column="1" 
                                             Value="{Binding MinRadius}" 
                                             Minimum="0.1" 
                                             Maximum="10.0"
                                             Increment="0.1"
                                             FormatString="F2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Smallest allowed radius for circle annotations."/>
                        </Grid>

                        <!-- Segmentation -->
                        <TextBlock Text="Segmentation" FontWeight="Bold" Margin="5,15,5,2"/>
                        <!-- Segmentation Minimum Feature Width -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Segmentation Minimum Width (nm):"/>
                            <Slider Grid.Row="0" Grid.Column="1"
                                    Value="{Binding SegmentationMinFeatureNanometers, Mode=TwoWay}"
                                    Minimum="0"
                                    Maximum="100"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Margin="5"/>
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Text="{Binding SegmentationMinFeatureNanometers, StringFormat='F0'}"
                                     IsReadOnly="True"
                                     Margin="5,0,0,0"
                                     VerticalAlignment="Center"
                                     Width="50"
                                     HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Parts of a SAM2 mask narrower than this are cut before the outline is traced, so a thin bridge no longer joins the cell to a neighbor. Edges of wider parts do not move. A cell membrane is at least 7 to 10 nm thick, so nothing narrower is cytoplasm. 0 keeps everything. Changing it retraces the current view."/>
                        </Grid>

                        <!-- Segmentation Smoothing -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Segmentation Smoothing:"/>
                            <Slider Grid.Row="0" Grid.Column="1"
                                    Value="{Binding SegmentationSmoothingSigma, Mode=TwoWay}"
                                    Minimum="0"
                                    Maximum="2"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    Margin="5"/>
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Text="{Binding SegmentationSmoothingSigma, StringFormat='F2'}"
                                     IsReadOnly="True"
                                     Margin="5,0,0,0"
                                     VerticalAlignment="Center"
                                     Width="50"
                                     HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Blur, in SAM2 logit samples (4 pixels each), applied before the outline is traced. 0 traces the logits as sent; 0.5 is the default. Higher values remove tiny holes and zigzags but push the line outward and can merge thin necks. Applies to the next segmentation. The mask overlay always shows the server's mask."/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Segmentation Settings -->
                <Expander Header="Segmentation" IsExpanded="False" Margin="10">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Drop Holes Smaller Than:"/>
                            <Slider Grid.Row="0" Grid.Column="1"
                                    Value="{Binding SegmentationHoleDropFraction, Mode=TwoWay}"
                                    Minimum="0"
                                    Maximum="0.25"
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="True"
                                    Margin="5"/>
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Text="{Binding SegmentationHoleDropFraction, StringFormat='P0'}"
                                     IsReadOnly="True"
                                     Margin="5,0,0,0"
                                     VerticalAlignment="Center"
                                     Width="50"
                                     HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Holes smaller than this percentage of the segmented area are filled. Set to 0% to preserve every detected hole."/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Edge Cleanup Radius:"/>
                            <Slider Grid.Row="0" Grid.Column="1"
                                    Value="{Binding SegmentationEdgeCleanupRadius, Mode=TwoWay}"
                                    Minimum="0"
                                    Maximum="32"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Margin="5"/>
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Text="{Binding SegmentationEdgeCleanupRadius}"
                                     IsReadOnly="True"
                                     Margin="5,0,0,0"
                                     VerticalAlignment="Center"
                                     Width="50"
                                     HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Screen-pixel radius for closing the mask (dilate, then erode) before tracing. Fills thin inward notches and does not shrink the outer boundary. Apply retraces masks already on screen from the original server result. Set to 0 to show that result with no cleanup."/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="SAM2 Mask Threshold:"/>
                            <Slider Grid.Row="0" Grid.Column="1"
                                    Value="{Binding SegmentationMaskThreshold, Mode=TwoWay}"
                                    Minimum="-5"
                                    Maximum="5"
                                    TickFrequency="0.1"
                                    IsSnapToTickEnabled="True"
                                    Margin="5"/>
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Text="{Binding SegmentationMaskThreshold, StringFormat='F1'}"
                                     IsReadOnly="True"
                                     Margin="5,0,0,0"
                                     VerticalAlignment="Center"
                                     Width="50"
                                     HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Logit a pixel must exceed for SAM2 to call it object. 0 is SAM2's default. Raise it to shrink every returned mask, lower it to grow them. Changing it re-segments the current view."/>
                        </Grid>

                        <CheckBox Margin="10,0,0,0"
                                  IsChecked="{Binding SegmentationUseMaskInput, Mode=TwoWay}"
                                  Content="Refine with mask_input (second SAM2 pass)"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock Margin="20,0,10,10"
                                   FontSize="10"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Text="Feeds each cell's first prediction back to SAM2 as mask_input and predicts again with the same prompts. Off by default. Changing it re-segments the current view."/>

                        <CheckBox Margin="10,0,0,0"
                                  IsChecked="{Binding SegmentLinkedAnnotations, Mode=TwoWay}"
                                  Content="Segment linked annotations"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock Margin="20,0,10,10"
                                   FontSize="10"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Text="After you drag a linked annotation onto the next section, SAM2 refines its outline. Pen buttons let you accept it, cancel the new annotation, or skip the refinement and place the dragged polygon as it is. When off, the dragged polygon is placed as soon as you release it."/>

                        <CheckBox Margin="10,0,0,0"
                                  IsChecked="{Binding SegmentationEdgeSnapEnabled, Mode=TwoWay}"
                                  Content="Snap contours to image edges"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock Margin="20,0,10,10"
                                   FontSize="10"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Text="Moves the traced line onto the nearest strong bright-to-dark edge of the image, so it sits on the membrane instead of where SAM2's logits cross the threshold. Where the image has no clear edge the line stays where SAM2 put it. On by default. Changing it retraces the current view without re-segmenting."/>

                        <controls:CircleSizePreviewSlider
                            Header="Auto Polygonize Min Size:"
                            Description="Circles smaller than this radius are not auto-segmented. The value is in nanometers. The preview is that size on the current Viking view. 0 submits every eligible circle."
                            Value="{Binding AutoPolygonizeMinRadiusNanometers, Mode=TwoWay}"
                            NanometersPerPixel="{Binding NanometersPerPixel}"
                            Minimum="0"
                            Maximum="2000"
                            TickFrequency="5"
                            PreviewMode="NanometerRadius"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Max Auto-Segment Downsample:"/>
                            <Slider Grid.Row="0" Grid.Column="1"
                                    Value="{Binding AutoPolygonizeMaxDownsample, Mode=TwoWay}"
                                    Minimum="1"
                                    Maximum="4"
                                    TickFrequency="0.25"
                                    IsSnapToTickEnabled="True"
                                    SmallChange="0.25"
                                    LargeChange="0.25"
                                    Margin="5"/>
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Text="{Binding AutoPolygonizeMaxDownsample, StringFormat=0.##}"
                                     IsReadOnly="True"
                                     Margin="5,0,0,0"
                                     VerticalAlignment="Center"
                                     Width="50"
                                     HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                     Margin="10,0,10,10"
                                     FontSize="10"
                                     Foreground="Gray"
                                     TextWrapping="Wrap"
                                     Text="Auto-segment does not run when the view is zoomed out past this downsample. The value itself still runs, so at 2, DS 2 runs and DS 3 does not. The maximum is 4."/>
                        </Grid>

                        <CheckBox Margin="0,10,0,0"
                                  IsChecked="{Binding AutoPolygonizeCircles, Mode=TwoWay}"
                                  Content="Auto polygonize circles in view"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock Margin="10,0,10,10"
                                   FontSize="10"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Text="When enabled, idle views automatically send each circle whose center is at least 5% from the edges and whose disk is fully on screen to the segmentation service. Double-click a result polyline to accept; double-right-click to dismiss."/>
                        <CheckBox Margin="0,10,0,0"
                                  IsChecked="{Binding AutoPolygonizeOverlayMasks, Mode=TwoWay}"
                                  Content="Overlay returned masks (debug)"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock Margin="10,0,10,10"
                                   FontSize="10"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Text="Shows the raw SAM2 mask under each auto-polygonize outline so you can compare the service response to the traced polygon. Uses extra GPU memory. Debug builds start with this on; turn it off for normal tracing."/>
                        <CheckBox Margin="28,0,0,0"
                                  IsChecked="{Binding AutoPolygonizeHideSegmentationRings, Mode=TwoWay}"
                                  IsEnabled="{Binding AutoPolygonizeOverlayMasks}"
                                  Content="Hide segmentation rings"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock Margin="38,0,10,10"
                                   FontSize="10"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Text="Hides the auto-polygonize outline while the returned mask is shown. Available only when masks are on. Rings stay visible whenever masks are off."/>
                        <CheckBox Margin="0,10,0,0"
                                  IsChecked="{Binding AutoPolygonizeOverlayPrompts, Mode=TwoWay}"
                                  Content="Show foreground and background points (debug)"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock Margin="10,0,10,10"
                                   FontSize="10"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Text="Draws the green foreground and red background clicks sent with each auto-polygonize request. Debug builds start with this on; turn it off for normal tracing."/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="Reset to Defaults" 
                    Width="120" 
                    Height="30" 
                    Margin="5"
                    Click="ResetToDefaultsButton_Click"/>
            <Button Content="Apply" 
                    Width="80" 
                    Height="30" 
                    Margin="5"
                    Click="ApplyButton_Click"/>
            <Button Content="OK" 
                    Width="80" 
                    Height="30" 
                    Margin="5"
                    Click="OkButton_Click"/>
            <Button Content="Cancel" 
                    Width="80" 
                    Height="30" 
                    Margin="5"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

