<UserControl x:Class="WebAnnotation.UI.Controls.StructureTypeTree"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:WebAnnotation.WPF.Converters"
             xmlns:local="clr-namespace:WebAnnotation.UI.Controls"
             xmlns:mock="clr-namespace:WebAnnotation.WPF.MockData"
             xmlns:model="clr-namespace:WebAnnotationModel;assembly=WebAnnotationModel"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="300"
             Name="_this"
             d:DataContext="{d:DesignData /SampleData/MockStructureTypeCollection.xaml}"
             >
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="ItemsPanelForHorizontalItems">
                <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
        <conv:StructureTypeIDsToStructureTypeObjsConverter x:Key="StructureIDsToStructureObjsConverter"/>
        <conv:IntToBrushConverter x:Key="IntToBrushConverter"/>
        <conv:SortStructureTypesByCodeConverter x:Key="SortStructureTypesByCodeConverter"/>
        <HierarchicalDataTemplate x:Key="StructureTypeTemplate"
                              ItemsSource="{Binding Children, Converter={StaticResource SortStructureTypesByCodeConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="TypeCode"/>
                    <ColumnDefinition Width="16" SharedSizeGroup="TypeColor"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Code}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Border Grid.Column="1" Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                        BorderBrush="Gray" BorderThickness="1"
                        Background="{Binding Color, Converter={StaticResource IntToBrushConverter}}"/>
                <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid>
        <TreeView Name="tree_view" ItemTemplate="{StaticResource StructureTypeTemplate}"
                  ItemsSource="{Binding RootStructureTypes, ElementName=_this}"
                  Grid.IsSharedSizeScope="True"
                  HorizontalContentAlignment="Stretch">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
    </Grid>
</UserControl>
