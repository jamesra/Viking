<UserControl x:Class="WebAnnotation.WPF.Controls.CircleSizePreviewSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vc="clr-namespace:Viking.UI.WPF.Controls;assembly=Viking.UI.WPF"
             xmlns:local="clr-namespace:WebAnnotation.WPF.Controls"
             mc:Ignorable="d"
             d:DesignHeight="160"
             d:DesignWidth="460"
             SizeChanged="OnControlSizeChanged">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0"
                   Content="{Binding Header, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   VerticalAlignment="Center"/>
            <vc:SliderWithValueBox x:Name="ValueEditor"
                                   Grid.Column="1"
                                   Minimum="{Binding Minimum, RelativeSource={RelativeSource AncestorType=local:CircleSizePreviewSlider}}"
                                   Maximum="{Binding Maximum, RelativeSource={RelativeSource AncestorType=local:CircleSizePreviewSlider}}"
                                   TickFrequency="{Binding TickFrequency, RelativeSource={RelativeSource AncestorType=local:CircleSizePreviewSlider}}"
                                   IsSnapToTickEnabled="True"
                                   ValueFormat="{Binding ValueFormat, RelativeSource={RelativeSource AncestorType=local:CircleSizePreviewSlider}}"
                                   Value="{Binding Value, RelativeSource={RelativeSource AncestorType=local:CircleSizePreviewSlider}, Mode=TwoWay}"/>
            <TextBlock Grid.Column="2"
                       Text="{Binding UnitText, RelativeSource={RelativeSource AncestorType=local:CircleSizePreviewSlider}}"
                       Margin="4,0,0,0"
                       VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Margin="10,0,10,10"
                   FontSize="10"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <Grid x:Name="PreviewHost"
              HorizontalAlignment="Center"
              MinHeight="8">
            <Border x:Name="PreviewScreen"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="#FF888888"
                    BorderThickness="1"
                    Background="#11000000"
                    Visibility="Collapsed"/>
            <Ellipse x:Name="PreviewCircle"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Stroke="#FF4A4A4A"
                     StrokeThickness="1"
                     Fill="#554A90D9"/>
        </Grid>
    </StackPanel>
</UserControl>
