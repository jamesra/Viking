<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CA1014</NoWarn>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'  or '$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.SqlServer.Types" Version="160.1000.6" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0' or '$(TargetFramework)' == 'net9.0-windows'">
    <PackageReference Include="Microsoft.SqlServer.Types" Version="160.1000.6" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="System.Net.Http.WinHttpHandler" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Geometry\Geometry.csproj" />
    <ProjectReference Include="..\..\Clients\VolumeModel\VolumeModel.csproj" />
    <ProjectReference Include="..\..\Clients\WebAnnotationModel\WebAnnotationModel.csproj" />
    <ProjectReference Include="..\..\Clients\WebAnnotationModel.gRPC\WebAnnotationModel.gRPC.csproj" />
    <ProjectReference Include="..\..\Clients\Common\Common.csproj" />
    <ProjectReference Include="..\..\Clients\WCFTokenInjector\WCFTokenInjector.csproj" />
    <ProjectReference Include="..\..\SqlGeometryAnnotationExtensions\SqlGeometryAnnotationExtensions.csproj" />
    <ProjectReference Include="..\..\SqlGeometryUtils\SqlGeometryUtils.csproj" /> 
	<ProjectReference Include="..\..\SqlServerTypesLoader\SqlServerTypesLoader.csproj" />
	  
  </ItemGroup>
</Project>