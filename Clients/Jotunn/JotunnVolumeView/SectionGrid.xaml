<UserControl x:Class="Viking.VolumeView.SectionGridControl" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:VolumeView="clr-namespace:Viking.VolumeView"
             xmlns:Viking="clr-namespace:Jotunn.Controls;assembly=JotunnUIControls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
             Name="Sections">
    <Grid>
        <VolumeView:SectionSceneHost x:Name="SceneHost"/>
        <!-- HwndHost child HWND often never delivers WPF mouse; this overlay owns pan/zoom. -->
        <Border Background="Transparent"
                Focusable="True"
                KeyDown="OnViewKeyDown"
                MouseLeftButtonDown="OnViewMouseLeftButtonDown"
                MouseRightButtonDown="OnViewMouseRightButtonDown"
                MouseDown="OnViewMouseDown"
                MouseMove="OnViewMouseMove"
                MouseLeftButtonUp="OnViewMouseLeftButtonUp"
                MouseRightButtonUp="OnViewMouseRightButtonUp"
                MouseWheel="OnViewMouseWheel"/>
        <ItemsControl x:Name="SectionsGrid"
                 Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 HorizontalContentAlignment="Stretch"
                 VerticalContentAlignment="Stretch"
                 IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Viking:VirtualizingGrid IsItemsHost="True" Name="ItemsPanel"
                                             CenterNumber="{Binding CenterIndex, Mode=TwoWay}"
                                             VisibleRegion="{Binding VisibleRegion, Mode=TwoWay}">
                    </Viking:VirtualizingGrid>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="16"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="{Binding Path=Name}"
                                   SnapsToDevicePixels="True"
                                   TextAlignment="Center"
                                   Foreground="LimeGreen"
                                   HorizontalAlignment="Stretch">
                            <TextBlock.Background>
                                <LinearGradientBrush StartPoint="0, 0.5" EndPoint="1, 0.5" >
                                    <GradientStop Offset="0" Color="Transparent"/>
                                    <GradientStop Offset="0.33" Color="#00000000"/>
                                    <GradientStop Offset="0.5" Color="#FF000000"/>
                                    <GradientStop Offset="0.66" Color="#00000000"/>
                                    <GradientStop Offset="1" Color="Transparent"/>
                                </LinearGradientBrush>
                            </TextBlock.Background>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
