<UserControl x:Class="Viking.VolumeView.MousePositionStatus"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             MinHeight="24"
             d:DesignHeight="24" d:DesignWidth="800">
    <StatusBar MinHeight="24">
        <StatusBarItem>
            <TextBlock x:Name="SectionText" Text="Section: —"/>
        </StatusBarItem>
        <Separator/>
        <StatusBarItem>
            <TextBlock x:Name="PositionText" Text="X: —  Y: —"/>
        </StatusBarItem>
        <Separator/>
        <StatusBarItem>
            <TextBlock x:Name="ZoomText" Text="Zoom: —"/>
        </StatusBarItem>
        <Separator/>
        <StatusBarItem>
            <TextBlock x:Name="MessageText" Text=""/>
        </StatusBarItem>
    </StatusBar>
</UserControl>
