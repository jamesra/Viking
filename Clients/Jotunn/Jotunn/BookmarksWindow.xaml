<Window x:Class="Jotunn.BookmarksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bookmarks"
        Width="420" Height="480"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Go" Width="80" Click="OnGo" Margin="0,0,8,0"/>
            <Button Content="Add current" Width="100" Click="OnAdd" Margin="0,0,8,0"/>
            <Button Content="Delete" Width="80" Click="OnDelete" Margin="0,0,8,0"/>
            <Button Content="Close" Width="80" IsCancel="True"/>
        </StackPanel>
        <ListBox x:Name="BookmarkList" MouseDoubleClick="OnGo">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding Name}"/>
                        <Run Text="  §"/>
                        <Run Text="{Binding Section}"/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
