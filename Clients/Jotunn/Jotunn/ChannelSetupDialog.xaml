<Window x:Class="Jotunn.ChannelSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Viking.UI.WPF.Controls;assembly=Viking.UI.WPF"
        Title="Setup Channels"
        Width="640" Height="480"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="88" IsDefault="True" Click="OnOk" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="88" IsCancel="True"/>
        </StackPanel>
        <wpf:ChannelSetupControl x:Name="ChannelSetup"/>
    </DockPanel>
</Window>
