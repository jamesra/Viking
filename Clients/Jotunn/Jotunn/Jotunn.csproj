<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Jotunn</RootNamespace>
    <AssemblyName>Jotunn</AssemblyName>
    <ApplicationIcon>Viking.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.0.1298</Version>
    <StartupObject>Jotunn.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Viking.ico" />
    <Resource Include="Viking.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Utils\Utils.csproj" />
    <ProjectReference Include="..\..\Common\Common.csproj" />
    <ProjectReference Include="..\..\..\Geometry\Geometry.csproj" />
    <ProjectReference Include="..\JotunnCommon\JotunnUICommon.csproj" />
    <ProjectReference Include="..\JotunnUIControls\JotunnUIControls.csproj" />
    <ProjectReference Include="..\VolumeViewModel\VolumeViewModel.csproj" />
    <ProjectReference Include="..\JotunnVolumeView\VolumeView.csproj" />
    <ProjectReference Include="..\..\VolumeModel\VolumeModel.csproj" />
    <ProjectReference Include="..\..\Viking.Tokens\Viking.Tokens.csproj" />
    <ProjectReference Include="..\..\Viking.UI.WPF\Viking.UI.WPF.csproj" />
    <ProjectReference Include="..\..\Viking.Scene\Viking.Scene.csproj" />
    <ProjectReference Include="..\..\Viking\WebAnnotation\WebAnnotation.csproj" />
    <ProjectReference Include="..\..\WebAnnotationWPFControls\WebAnnotationWPFControls.csproj" />
    <ProjectReference Include="..\..\..\SqlServerTypesLoader\SqlServerTypesLoader.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="BootStrapper.cs" />
    <Compile Remove="VisibleRegionInfo.cs" />
    <Compile Remove="RegionNames.cs" />
    <Compile Remove="IShellParameters.cs" />
    <Compile Remove="SqlServerTypes\Loader.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Viking\Viking\SqlServerTypes\**\*.*" LinkBase="SqlServerTypes" CopyToOutputDirectory="PreserveNewest" />
    <None Include="SqlServerTypes\x64\*.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('SqlServerTypes\x64')" />
    <None Include="SqlServerTypes\x86\*.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('SqlServerTypes\x86')" />
  </ItemGroup>

  <!-- SDK DefaultItemExcludes drops **\bin\**, so None Include of Content\bin\...\*.xnb never copies.
       Viking uses the same AfterBuild copy. Prefer 3.8 WindowsDX xnb from Monographics. -->
  <Target Name="CopyGraphicsContent" AfterTargets="Build" BeforeTargets="PrepareForRun" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_MgContentDir>$(MSBuildThisFileDirectory)..\..\Monographics\Content\bin\Windows\Content\</_MgContentDir>
      <_LegacyContentDir>$(MSBuildThisFileDirectory)..\..\VikingXNAGraphics\Content\bin\Windows\</_LegacyContentDir>
      <_DestContentDir>$(TargetDir)Content\</_DestContentDir>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(_MgContentDir)TileLayout.xnb')">
      <GraphicsContent Include="$(_MgContentDir)*.xnb" />
    </ItemGroup>
    <ItemGroup Condition="'@(GraphicsContent)' == '' and Exists('$(_LegacyContentDir)TileLayout.xnb')">
      <GraphicsContent Include="$(_LegacyContentDir)*.xnb" />
    </ItemGroup>
    <MakeDir Directories="$(_DestContentDir)" />
    <Copy SourceFiles="@(GraphicsContent)" DestinationFolder="$(_DestContentDir)" SkipUnchangedFiles="true" />
    <Error Text="No graphics content (.xnb) was copied to Jotunn output. Build Clients\Monographics so Content\bin\Windows\Content\TileLayout.xnb exists." Condition="'@(GraphicsContent)' == ''" />
    <Message Text="Copied @(GraphicsContent-&gt;Count()) graphics content file(s) to $(_DestContentDir)" Importance="high" />
  </Target>

</Project>
