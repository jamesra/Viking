<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Viking.AnnotationServiceTypes.gRPC.V1</RootNamespace>
    <AssemblyName>AnnotationServiceTypes.gRPC</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.19.1" />
    <PackageReference Include="Grpc.Core" Version="2.43.0" />
    <PackageReference Include="Grpc.Tools" Version="2.43.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.11.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AnnotationInterfaces\AnnotationInterfaces.csproj" />
    <ProjectReference Include="..\Geometry\Geometry.csproj" />
    <ProjectReference Include="..\GeometrySqlTypeMapper\GeometryOGCMapper.csproj" />
    <ProjectReference Include="..\gRPCGeometryTypes\GeometryTypes.gRPC.csproj" />
    <ProjectReference Include="..\UnitsAndScale\UnitsAndScale.csproj" />
  </ItemGroup>

  <!-- The annotation protos live in gRPC_Protos/Annotation. Common/geometry.proto is imported through ProtoRoot and
       compiled by GeometryTypes.gRPC, not here. -->
  <ItemGroup>
    <Protobuf Include="..\gRPC_Protos\Annotation\AnnotationMetaData.proto" ProtoRoot="..\gRPC_Protos" GrpcServices="Both" />
    <Protobuf Include="..\gRPC_Protos\Annotation\AnnotationTypes.proto" ProtoRoot="..\gRPC_Protos" GrpcServices="Both" />
    <Protobuf Include="..\gRPC_Protos\Annotation\Location.proto" ProtoRoot="..\gRPC_Protos" GrpcServices="Both" />
    <Protobuf Include="..\gRPC_Protos\Annotation\PermittedStructureLinks.proto" ProtoRoot="..\gRPC_Protos" GrpcServices="Both" />
    <Protobuf Include="..\gRPC_Protos\Annotation\Structure.proto" ProtoRoot="..\gRPC_Protos" GrpcServices="Both" />
    <Protobuf Include="..\gRPC_Protos\Annotation\StructureType.proto" ProtoRoot="..\gRPC_Protos" GrpcServices="Both" />
  </ItemGroup>

</Project>
