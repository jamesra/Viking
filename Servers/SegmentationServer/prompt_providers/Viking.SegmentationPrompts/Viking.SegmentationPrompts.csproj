<Project Sdk="Microsoft.NET.Sdk">

  <!-- The segmentation server's first prompt provider: it builds the SegmentTilesRequest for annotation locations
       (SegmentLocation), so every client gets the same request for the same location. The server loads it through
       Viking.SegmentationPrompts.Native. It depends on Google.Protobuf alone, so the server's Docker build stage
       builds it without the rest of this solution. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Viking.SegmentationPrompts</RootNamespace>
    <AssemblyName>Viking.SegmentationPrompts</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The generated protocol types are internal and carry no XML docs. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ProtosRoot Condition="'$(ProtosRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\gRPC_Protos</ProtosRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.17.2" />
    <PackageReference Include="Grpc.Tools" Version="2.38.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Compiled internal: the server exchanges serialized bytes with this library, not types. -->
  <ItemGroup>
    <Protobuf Include="$(ProtosRoot)\Common\geometry.proto" ProtoRoot="$(ProtosRoot)" GrpcServices="None" Access="Internal" />
    <Protobuf Include="$(ProtosRoot)\Segmentation\SAM2\segmentation.proto" ProtoRoot="$(ProtosRoot)" GrpcServices="None" Access="Internal" />
    <Protobuf Include="$(ProtosRoot)\Segmentation\SAM2\prompt_input.proto" ProtoRoot="$(ProtosRoot)" GrpcServices="None" Access="Internal" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Viking.SegmentationPrompts.Tests" />
  </ItemGroup>

  <Target Name="CheckProtosRoot" BeforeTargets="BeforeBuild" Condition="!Exists('$(ProtosRoot)\Segmentation\SAM2\prompt_input.proto')">
    <Error Text="Viking.SegmentationPrompts needs gRPC_Protos (with Segmentation/SAM2/prompt_input.proto) at $(ProtosRoot): the repository's gRPC_Protos, four levels above this project (or pass -p:ProtosRoot=...)." />
  </Target>

</Project>
