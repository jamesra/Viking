{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Python Debugger: Remote Attach",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/home/user"
                }
            ]
        },
        {
            "name": "Python Debugger: Segmentation Server",
            "type": "debugpy",
            "request": "launch",
            "module": "segmentation_server",
            "justMyCode": false,
            "cwd": "${workspaceFolder}/Servers/SegmentationServer/segmentation_server"
        }
    ]
}