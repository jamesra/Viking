<?xml version="1.0" encoding="utf-8"?>

<!-- For more information on using web.config transformation visit http://go.microsoft.com/fwlink/?LinkId=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!-- 
    Release Configuration Transform
    This transform is applied when building in Release mode.
    Update the connection string for your production environment.
  -->
  
  <connectionStrings>
    <!-- 
      IMPORTANT: Update this connection string for your production database.
      The transform will replace the connection string in Web.config with this one.
      
      Consider using environment variables or Azure Key Vault for sensitive connection strings:
      connectionString="metadata=res://*/;provider=System.Data.SqlClient;provider connection string=&quot;data source=ProductionServer;initial catalog=ConnectomeDB;User ID=AppUser;Password=%DB_PASSWORD%;Connection Timeout=60;multipleactiveresultsets=True;Type System Version=SQL Server 2012;application name=EntityFramework&quot;"
    -->
    <add name="ConnectomeEntities" 
         connectionString="metadata=res://*/;provider=System.Data.SqlClient;provider connection string=&quot;data source=ProductionServer;initial catalog=ConnectomeDB;integrated security=True;Connection Timeout=60;multipleactiveresultsets=True;Type System Version=SQL Server 2012;application name=EntityFramework&quot;"
         providerName="System.Data.EntityClient"
         xdt:Transform="SetAttributes" 
         xdt:Locator="Match(name)"/>
  </connectionStrings>
  
  <system.web>
    <!-- Remove debug attribute for production -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    
    <!-- Enable custom error pages for production -->
    <customErrors mode="RemoteOnly" xdt:Transform="Replace">
      <error statusCode="500" redirect="~/Error/500" />
      <error statusCode="404" redirect="~/Error/404" />
    </customErrors>
  </system.web>
</configuration>