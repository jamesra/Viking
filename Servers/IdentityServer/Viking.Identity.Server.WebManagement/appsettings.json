{
  "ConnectionStrings": {
    "IdentityConnection": "Server=${SQL_SERVER_HOST},${SQL_SERVER_PORT};Database=IdentityViking;Trusted_Connection=False;User ID=${SQL_SERVER_USER};Password=${SQL_SERVER_PASSWORD};MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "VikingIdentityServerOptions": {
    "Authority": "https://identity.codepharm.net:5001/",
    "Secret": "${IDENTITY_SERVER_SECRET}",
    "ApiSecret": "${IDENTITY_SERVER_API_SECRET}",
    "MvcSecret": "${IDENTITY_SERVER_MVC_SECRET}",
    "RoVikingSecret": "${IDENTITY_SERVER_RO_VIKING_SECRET}",
    "ApiScopes": [
      {
        "Name": "Viking.Annotation",
        "Description": "Access to Annotate a volume"
      }
    ]
  },
  "WebApiOptions": {
    "BaseUrl": "https://identity.codepharm.net:6001/"
  },
  "JwtBearerOptions": {
    "Authority": "https://identity.codepharm.net:5001/",
    "RequireHttpsMetadata": true,
    "SaveToken": true,
    "TokenValidationParameters": {
      "ValidateAudience": true,
      "ValidateLifetime": true,
      "ValidateIssuer": true,
      "ValidateTokenReplay": true,
      "ValidateIssuerSigningKey": true,
      "NameClaimType": "name",
      "ValidAudience": "Viking.Annotation.API",
      "ValidTypes": [ "at+jwt" ]
    }
  },
  "OAuth2IntrospectionOptions": {
    "ClientId": "mvc",
    "ClientSecret": "${IDENTITY_SERVER_MVC_SECRET}",
    "Authority": "https://identity.codepharm.net:5001/",
    "EnableCaching": true,
    "SaveToken": true
  }, 
  "Logging": {
    "IncludeScopes": false,
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    }
  }
}
