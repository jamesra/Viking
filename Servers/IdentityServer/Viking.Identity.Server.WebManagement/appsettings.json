{
  "ConnectionStrings": {
    "IdentityConnection": "Server=${SQL_SERVER_HOST},${SQL_SERVER_PORT};Database=IdentityViking;Trusted_Connection=False;User ID=${SQL_SERVER_USER};Password=${SQL_SERVER_PASSWORD};MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "VikingIdentityServerOptions": {
    "Authority": "https://identity.codepharm.net:5001/",
    "Secret": "${IDENTITY_SERVER_SECRET}",
    "ApiScopes": [
      {
        "Name": "Viking.Annotation",
        "Description": "Access to Annotate a volume"
      }
    ]
  },
  "WebApiOptions": {
    "BaseUrl": "https://identity.codepharm.net:6001/"
  },
  "JwtBearerOptions": {
    "Authority": "https://identity.codepharm.net:5001/",
    "RequireHttpsMetadata": true,
    "SaveToken": true,
    "TokenValidationParameters": {
      "ValidateAudience": true,
      "ValidateLifetime": true,
      "ValidateIssuer": true,
      "ValidateTokenReplay": true,
      "ValidateIssuerSigningKey": true,
      "NameClaimType": "name",
      "ValidAudience": "Viking.Annotation.API",
      "ValidTypes": [ "at+jwt" ]
    }
  },
  "OAuth2IntrospectionOptions": {
    "ClientId": "mvc",
    "ClientSecret": "${IDENTITY_SERVER_SECRET}",
    "Authority": "https://identity.codepharm.net:5001/",
    "EnableCaching": true,
    "SaveToken": true
  }, 
  "Logging": {
    "IncludeScopes": false,
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    }
  }, 
  "Email": {
    "Server": "smtp.office365.com",
    "Port": 587,
    "FromEmail": "jander42@hotmail.com",
    "FromName": "Viking Registration",
    "EnableSsl": true,
    "UseHtml": true,
    "Username": "jander42@hotmail.com",
    "Timeout": 10,
    "EnableSending": true
  }
}
