@using Viking.Identity.Server.Authorization
@model IEnumerable<Viking.Identity.Models.CorrectionService>

@{
    ViewData["Title"] = "Correction Services";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-rulers"></i> Correction Services</h2>
    <a asp-action="Create" class="btn btn-light btn-sm">
        <i class="bi bi-plus-circle"></i> New Correction Service
    </a>
</div>

<p class="text-muted">
    A correction service computes section corrections for the annotation contexts assigned to it. Assign contexts on the
    annotation context's Edit page; Viking receives the service endpoint when it opens an assigned context.
</p>

<table class="table table-modern" id="correctionServicesTable">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Organization</th>
            <th>Endpoint</th>
            <th>Contexts</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderBy(s => s.Parent?.Name ?? "").ThenBy(s => s.Name))
        {
            <tr>
                <td>
                    <i class="bi bi-rulers"></i>
                    <a asp-action="Details" asp-route-id="@item.Id">@item.Name</a>
                </td>
                <td>@(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)</td>
                <td>
                    @if (item.Parent != null)
                    {
                        <i class="bi bi-building text-org"></i>
                        <a asp-controller="OrganizationalUnits" asp-action="Details" asp-route-id="@item.Parent.Id">@item.Parent.Name</a>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
                <td>@(item.Endpoint?.ToString() ?? "-")</td>
                <td>@item.AnnotationContexts.Count</td>
                <td>
                    <div class="btn-group btn-group-sm" role="group">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Details" aria-label="Details">
                            <i class="bi bi-info-circle"></i>
                        </a>
                        @if ((await AuthorizationService.IsParentOrgUnitAdminAsync(User, item)))
                        {
                            <a asp-action="Edit" asp-controller="GrantedPermissions" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Permissions" aria-label="Permissions">
                                <i class="bi bi-shield-check"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Edit" aria-label="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Delete" aria-label="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
