@{
    ViewData["Title"] = "Help";

    // (term, controller for its management page or null, what it is for, how it connects to the others)
    var people = new (string Term, string Controller, string Purpose, string Relations)[]
    {
        ("Site Administrator", "UserRoles",
            "A user holding the Administrator application role. Has full access to every resource and every management page.",
            "Assigned under Users & Access → Assign Roles. Not tied to any organizational unit."),
        ("User", "ApplicationUsers",
            "A person who signs in. Receives permissions directly, through the groups they belong to, or through an administrator role.",
            "Member of zero or more groups. Permissions are granted on resources, never on other users."),
        ("Group", "Groups",
            "A named set of users (and other groups) that can be given permissions together, so access is granted once rather than per person.",
            "Groups can contain groups; members inherit everything the parent group is granted. The Access Manager permission on a group lets someone manage its membership."),
        ("Permission and grant", null,
            "A permission is a named right defined for a resource type, such as Read, Annotate, Review, User or Access Manager. A grant gives a permission on one resource to one user or group.",
            "The permissions available for each type are listed under Administration → Resource Types. Effective access is the union of direct grants and grants through group membership.")
    };

    var structure = new (string Term, string Controller, string Purpose, string Relations)[]
    {
        ("Organizational Unit", "OrganizationalUnits",
            "A folder-like owner of resources, arranged in a hierarchy. Administering an organizational unit means managing the resources inside it.",
            "Every other resource has an organizational unit as its parent. The Administrator permission on a unit lets someone create, edit and delete the resources under it and manage who can access them. It does not by itself give anyone annotation rights in Viking."),
        ("Connectome", "Connectomes",
            "A project-level grouping of everything that belongs to one dataset: its annotation contexts, annotation servers and volumes.",
            "Names one default annotation context. Not a permission-bearing resource itself, so a connectome can share a name with its default context without clashing.")
    };

    var data = new (string Term, string Controller, string Purpose, string Relations)[]
    {
        ("Volume", null,
            "The set of images and slice-to-slice transforms, described by a VikingXML file. A new build of the images is a new volume.",
            "A plain record, not a grantable resource. Belongs to a connectome and is shown by annotation contexts."),
        ("Volume Mirror", null,
            "An exact clone of a volume at another URL, typically in another region. Clients may spread load across enabled mirrors, preferring the lowest priority number.",
            "Belongs to one volume. Never differs in content from its volume."),
        ("Annotation Server", "AnnotationServers",
            "One annotation SQL database exposed at a service URL, with its annotation, OData and export endpoints derived from that URL.",
            "The only place Read, Annotate and Review are granted. Every annotation context linked to the server uses those rights. Servers are normally created by the Volume Catalog Sync from each volume's VikingXML; choosing one by hand on a context pins it so the sync leaves it alone."),
        ("Annotation Context", "AnnotationContexts",
            "The thing a user opens in Viking: one volume bound to one or more annotation servers, plus its registration and optional correction service.",
            "Lives in a connectome. Its default annotation server supplies the annotation, OData and export URLs; alternates are offered at login. Its only permission is Access, which decides whether a user sees it when launching Viking. What the user can do inside it comes from the Read, Annotate and Review grants on its annotation server."),
        ("Registration (StosGroup)", null,
            "The slice-to-slice transform group that aligns the volume's images with the annotation database. Set per annotation context.",
            "Empty uses the VikingXML default; None means the images are already in volume space. Together with the annotation database it identifies a published set of section corrections.")
    };

    var services = new (string Term, string Controller, string Purpose, string Relations)[]
    {
        ("Correction Service", "CorrectionServices",
            "A section-correction container. It computes how much each section's image should be shifted to line up with its neighbors, from the annotations of the contexts assigned to it.",
            "Contexts are assigned on the annotation context's Edit page. Viking receives the service URL when it opens an assigned context, and shifts the view slightly as you zoom in. The container signs in as the Identity client named correction (secret set on the server) and asks for the contexts assigned to the service whose name it is configured with. Contexts that share an annotation database and registration are corrected once."),
        ("Segmentation Service", "SegmentationServices",
            "A backend that segments images on request. Users pick one when they sign in to Viking.",
            "Owned by an organizational unit. Granted to users with the User permission; Access Manager lets someone manage who may use it. Independent of annotation contexts.")
    };

    var sections = new (string Heading, string Id, (string Term, string Controller, string Purpose, string Relations)[] Items)[]
    {
        ("People and access", "people", people),
        ("Organization", "structure", structure),
        ("Images and annotations", "data", data),
        ("Services", "services", services)
    };
}

<style>
    .rel-diagram { width: 100%; height: auto; max-width: 1000px; }
    .rel-diagram text { fill: var(--bs-body-color); font-family: inherit; font-size: 13px; }
    .rel-diagram .dg-title { font-weight: 600; font-size: 14px; }
    .rel-diagram .dg-sub { font-size: 11px; fill: var(--bs-secondary-color); }
    .rel-diagram .dg-box { fill: var(--bs-body-bg); stroke-width: 2; }
    .rel-diagram .dg-org { stroke: var(--bs-info); }
    .rel-diagram .dg-people { stroke: var(--bs-secondary); }
    .rel-diagram .dg-data { stroke: var(--bs-primary); }
    .rel-diagram .dg-service { stroke: var(--bs-success); }
    .rel-diagram .dg-frame { fill: none; stroke: var(--bs-border-color); stroke-width: 2; stroke-dasharray: 2 4; }
    .rel-diagram .dg-line { fill: none; stroke: var(--bs-body-color); stroke-width: 1.5; }
    .rel-diagram .dg-own { fill: none; stroke: var(--bs-info); stroke-width: 1.5; stroke-dasharray: 6 4; }
    .rel-diagram .dg-head { fill: var(--bs-body-color); }
    .rel-diagram .dg-head-own { fill: var(--bs-info); }
    .glossary-term { scroll-margin-top: 5rem; }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-question-circle"></i> Help for administrators</h2>
</div>

<p class="text-muted">
    This page is shown to site administrators and to administrators of an organizational unit. It explains how the
    things you manage here fit together and what each one is for.
</p>

<div class="card card-modern mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-diagram-2"></i> How resources relate</h5>
    </div>
    <div class="card-body">
        <svg class="rel-diagram" viewBox="0 0 1000 520" role="img" aria-labelledby="relTitle relDesc" xmlns="http://www.w3.org/2000/svg">
            <title id="relTitle">Relationships between Identity resources</title>
            <desc id="relDesc">
                Organizational units own connectomes and services. A connectome groups annotation contexts, annotation servers
                and volumes. An annotation context shows one volume, reads and writes one or more annotation servers, and may be
                corrected by a correction service. Users belong to groups; users and groups are granted permissions on annotation
                servers and services.
            </desc>
            <defs>
                <marker id="arr" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0,0 L9,4.5 L0,9 z" class="dg-head"/></marker>
                <marker id="arrOwn" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0,0 L9,4.5 L0,9 z" class="dg-head-own"/></marker>
            </defs>

            <!-- Organizational unit and ownership -->
            <rect class="dg-box dg-org" x="380" y="16" width="240" height="54" rx="8"/>
            <text class="dg-title" x="500" y="39" text-anchor="middle">Organizational Unit</text>
            <text class="dg-sub" x="500" y="57" text-anchor="middle">owns resources · Administrator</text>
            <path class="dg-own" d="M500 70 V116" marker-end="url(#arrOwn)"/>
            <text class="dg-sub" x="508" y="98">owns</text>
            <path class="dg-own" d="M620 43 H985 V420 H962" marker-end="url(#arrOwn)"/>
            <path class="dg-own" d="M985 220 H962" marker-end="url(#arrOwn)"/>
            <text class="dg-sub" x="800" y="36">owns services</text>

            <!-- People -->
            <rect class="dg-box dg-people" x="20" y="140" width="150" height="50" rx="8"/>
            <text class="dg-title" x="95" y="170" text-anchor="middle">User</text>
            <rect class="dg-box dg-people" x="20" y="270" width="150" height="50" rx="8"/>
            <text class="dg-title" x="95" y="300" text-anchor="middle">Group</text>
            <text class="dg-sub" x="95" y="338" text-anchor="middle">groups can contain groups</text>
            <path class="dg-line" d="M95 190 V268" marker-end="url(#arr)"/>
            <text class="dg-sub" x="103" y="234">member of</text>

            <!-- Grants from users and groups -->
            <path class="dg-line" d="M170 165 H205 V350"/>
            <path class="dg-line" d="M170 295 H205 V350 H448" marker-end="url(#arr)"/>
            <text class="dg-sub" x="214" y="368">grants: Read / Annotate / Review</text>

            <!-- Connectome -->
            <rect class="dg-frame" x="230" y="118" width="540" height="300" rx="10"/>
            <text class="dg-title" x="246" y="142">Connectome</text>
            <text class="dg-sub" x="246" y="404">groups its contexts, servers and volumes and names one default context</text>

            <rect class="dg-box dg-data" x="250" y="190" width="150" height="60" rx="8"/>
            <text class="dg-title" x="325" y="217" text-anchor="middle">Volume</text>
            <text class="dg-sub" x="325" y="235" text-anchor="middle">images + transforms</text>

            <rect class="dg-box dg-data" x="250" y="300" width="150" height="40" rx="8"/>
            <text class="dg-title" x="325" y="325" text-anchor="middle">Volume Mirror</text>
            <path class="dg-line" d="M325 250 V298" marker-end="url(#arr)"/>
            <text class="dg-sub" x="333" y="278">clones</text>

            <rect class="dg-box dg-data" x="450" y="190" width="200" height="60" rx="8"/>
            <text class="dg-title" x="550" y="217" text-anchor="middle">Annotation Context</text>
            <text class="dg-sub" x="550" y="235" text-anchor="middle">what a user opens in Viking</text>
            <path class="dg-line" d="M450 220 H402" marker-end="url(#arr)"/>
            <text class="dg-sub" x="426" y="212" text-anchor="middle">shows</text>

            <rect class="dg-box dg-data" x="450" y="320" width="200" height="60" rx="8"/>
            <text class="dg-title" x="550" y="347" text-anchor="middle">Annotation Server</text>
            <text class="dg-sub" x="550" y="365" text-anchor="middle">SQL annotation database</text>
            <path class="dg-line" d="M550 250 V318" marker-end="url(#arr)"/>
            <text class="dg-sub" x="558" y="278">reads and writes</text>
            <text class="dg-sub" x="558" y="294">default + alternates</text>

            <!-- Services -->
            <rect class="dg-box dg-service" x="800" y="190" width="160" height="60" rx="8"/>
            <text class="dg-title" x="880" y="217" text-anchor="middle">Correction Service</text>
            <text class="dg-sub" x="880" y="235" text-anchor="middle">section corrections</text>
            <path class="dg-line" d="M650 220 H798" marker-end="url(#arr)"/>
            <text class="dg-sub" x="724" y="212" text-anchor="middle">corrected by</text>

            <rect class="dg-box dg-service" x="800" y="392" width="160" height="56" rx="8"/>
            <text class="dg-title" x="880" y="417" text-anchor="middle">Segmentation Service</text>
            <text class="dg-sub" x="880" y="435" text-anchor="middle">chosen at sign-in</text>
            <text class="dg-sub" x="800" y="468">services are granted User / Access Manager</text>

            <!-- Legend -->
            <path class="dg-line" d="M20 496 H60" marker-end="url(#arr)"/>
            <text class="dg-sub" x="68" y="500">refers to / uses</text>
            <path class="dg-own" d="M200 496 H240" marker-end="url(#arrOwn)"/>
            <text class="dg-sub" x="248" y="500">is owned by (parent organizational unit)</text>
        </svg>
        <p class="small text-muted mt-3 mb-0">
            Effective access to an annotation context is the grants on the context plus the grants on its annotation server,
            from the user directly and from every group they belong to. Put new grants on the annotation server.
            The glossary below describes every box.
        </p>
    </div>
</div>

<div class="card card-modern mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-journal-text"></i> Glossary</h5>
    </div>
    <div class="card-body">
        <nav class="mb-3" aria-label="Glossary sections">
            @foreach (var group in sections)
            {
                <a class="btn btn-outline-secondary btn-sm me-1" href="#@group.Id">@group.Heading</a>
            }
        </nav>

        @foreach (var group in sections)
        {
            <h5 id="@group.Id" class="mt-4">@group.Heading</h5>
            <dl class="row">
                @foreach (var item in group.Items)
                {
                    <dt class="col-md-3 glossary-term">
                        @item.Term
                        @if (item.Controller != null)
                        {
                            <div><a class="small" asp-controller="@item.Controller" asp-action="Index">Open <i class="bi bi-box-arrow-up-right"></i></a></div>
                        }
                    </dt>
                    <dd class="col-md-9">
                        <p class="mb-1">@item.Purpose</p>
                        <p class="mb-3 text-muted">@item.Relations</p>
                    </dd>
                }
            </dl>
        }
    </div>
</div>
