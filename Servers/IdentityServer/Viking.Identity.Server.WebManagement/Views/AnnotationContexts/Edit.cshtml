@model Viking.Identity.Models.AnnotationContext
@using Viking.Identity.Models
@using Viking.Identity.Server.Extensions.Services

@{
    ViewData["Title"] = "Edit Volume";
    ViewData["Breadcrumbs"] = new List<(string Text, string Url)>
    {
        ("Dashboard", Url.Action("Index", "Home")),
        ("Annotation Contexts", Url.Action("Index", "AnnotationContexts")),
        (Model.Name, Url.Action("Details", "AnnotationContexts", new { id = Model.Id })),
        ("Edit", null)
    };
    var allServers = (IEnumerable<AnnotationServer>)(ViewBag.AvailableAnnotationServers ?? Array.Empty<AnnotationServer>());
    var linkedIds = new HashSet<long>(
        (Model.AnnotationServerLinks ?? new List<AnnotationContextServer>())
            .Select(l => l.AnnotationServerId)
            .Concat(Model.AnnotationServerId.HasValue ? new[] { Model.AnnotationServerId.Value } : Array.Empty<long>()));
    var selectedServerId = Model.AnnotationServerPinned ? Model.AnnotationServerId : null;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-hdd-stack"></i> Edit Volume: @Model.Name</h2>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Details
    </a>
</div>

<div class="card card-modern">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Volume Information</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" id="editVolumeForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ResourceTypeId" />
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Endpoint" class="form-label"></label>
                <input asp-for="Endpoint" class="form-control" placeholder="https://example.com/volume" />
                <span asp-validation-for="Endpoint" class="text-danger"></span>
                <small class="form-text text-muted">
                    VikingXML URL of the preferred mirror. Changing it re-reads the VikingXML and adds the URL as the
                    preferred mirror. Manage other hosts under Image Set and Mirrors.
                </small>
            </div>
            <div class="mb-3">
                <label asp-for="AnnotationServerId" class="form-label">Annotation Server</label>
                <select asp-for="AnnotationServerId" class="form-select">
                    <option value="" selected="@(selectedServerId == null)">
                        Use VikingXML@(Model.AnnotationServer != null && !Model.AnnotationServerPinned ? $" ({Model.AnnotationServer.Name})" : "")
                    </option>
                    @foreach (var server in allServers.OrderBy(s => s.Name))
                    {
                        <option value="@server.Id" selected="@(selectedServerId == server.Id)">@server.Name - @server.BaseUrl</option>
                    }
                </select>
                <span asp-validation-for="AnnotationServerId" class="text-danger"></span>
                <small class="form-text text-muted">
                    Choose a server to override the one named by <code>VolumeToEndpoint</code> in the VikingXML. The choice is
                    kept when the catalog syncs. Select "Use VikingXML" to return to the automatic link; images-only contexts
                    then have no annotation server.
                    @if (Model.AnnotationServer != null)
                    {
                        <span>Currently: <a asp-controller="AnnotationServers" asp-action="Details" asp-route-id="@Model.AnnotationServer.Id">@Model.AnnotationServer.Name</a>@(Model.AnnotationServerPinned ? " (manual)" : " (from VikingXML)").</span>
                    }
                </small>
                @if (allServers.Any())
                {
                    <div class="border rounded p-3 mt-2">
                        <p class="small text-muted mb-2">
                            Also offer these servers: when more than one is linked, the user can pick another at login.
                        </p>
                        @foreach (var server in allServers.OrderBy(s => s.Name))
                        {
                            <div class="form-check">
                                <input type="checkbox" name="linkedAnnotationServerIds" value="@server.Id"
                                       id="link-@server.Id" class="form-check-input"
                                       @(linkedIds.Contains(server.Id) ? "checked" : null) />
                                <label class="form-check-label" for="link-@server.Id">
                                    <a asp-controller="AnnotationServers" asp-action="Details" asp-route-id="@server.Id">@server.Name</a>
                                    <code class="small">@server.BaseUrl</code>
                                </label>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="mb-3">
                <label asp-for="RegistrationName" class="form-label"></label>
                <input asp-for="RegistrationName" class="form-control" placeholder="VikingXML default" />
                <span asp-validation-for="RegistrationName" class="text-danger"></span>
                <small class="form-text text-muted">
                    StosGroup that aligns these images with the annotation database. Leave empty for the VikingXML
                    default; use <code>None</code> when the images are already in volume space.
                </small>
            </div>
            <div class="mb-3">
                <label asp-for="Parent" class="form-label"></label>
                <select asp-for="ParentID" asp-items="@ViewBag.AvailableParents" class="form-select">
                    <option value="">None</option>
                </select>
                <span asp-validation-for="ParentID" class="text-danger"></span>
            </div>
            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-save"></i> Save Changes
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-lg ms-2">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            $('#editVolumeForm').on('submit', function() {
                var $submitBtn = $(this).find('button[type="submit"]');
                $submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Saving...');
            });
        });
    </script>
}
