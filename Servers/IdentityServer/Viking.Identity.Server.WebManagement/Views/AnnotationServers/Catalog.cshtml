@using Viking.Identity.Server.Extensions.Services
@model CatalogReport

@{
    ViewData["Title"] = "Volume Catalog Sync";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-arrow-repeat"></i> Volume Catalog Sync</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-database"></i> Annotation Servers
    </a>
</div>

<div class="card card-modern mb-4">
    <div class="card-body">
        <p>
            The sync reads each volume's VikingXML. The annotation endpoint in <code>VolumeToEndpoint</code> picks
            (or creates) the volume's annotation server, and the VikingXML URL becomes the first mirror of the
            volume's image set. Volumes are never merged.
        </p>
        <p class="text-muted small">
            Run it only after every Identity service (IdentityServerStandalone, WebApi, WebManagement) is on the
            release that knows the AnnotationServer type. Older services cannot read annotation server rows.
        </p>
        <div class="d-flex gap-2">
            <form asp-action="SyncAll" method="post" onsubmit="return confirm('Read the VikingXML of every volume now? This can take a few minutes.');">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-arrow-repeat"></i> 1. Sync all volumes
                </button>
            </form>
            <form asp-action="CopyGrants" method="post" onsubmit="return confirm('Copy every volume grant to its annotation server? Volume grants are kept.');">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-shield-check"></i> 2. Copy volume grants to annotation servers
                </button>
            </form>
        </div>
    </div>
</div>

<h4>Volumes without an annotation server (@Model.UnlinkedAnnotationContexts.Count)</h4>
@if (!Model.UnlinkedAnnotationContexts.Any())
{
    <p class="text-muted">Every volume is linked.</p>
}
else
{
    <p class="text-muted small">
        These keep using their own volume grants. Image-only volumes are expected here; fetch failures usually mean
        the host is unreachable from the server or is on a private network that is not listed in
        <code>VikingXmlCatalog:AllowedInternalHosts</code>.
    </p>
    <table class="table table-modern">
        <thead>
            <tr>
                <th>Volume</th>
                <th>Organization</th>
                <th>VikingXML</th>
                <th>Last sync</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var volume in Model.UnlinkedAnnotationContexts)
            {
                <tr>
                    <td><a asp-controller="AnnotationContexts" asp-action="Details" asp-route-id="@volume.Id">@volume.Name</a></td>
                    <td>@(volume.Parent?.Name ?? "-")</td>
                    <td class="small"><code>@volume.Endpoint</code></td>
                    <td class="small">@(volume.CatalogSyncedUtc?.ToString("u") ?? "never")</td>
                    <td class="small">@volume.CatalogSyncMessage</td>
                </tr>
            }
        </tbody>
    </table>
}

<h4 class="mt-4">Possible clones (@Model.CloneSuggestions.Count)</h4>
@if (!Model.CloneSuggestions.Any())
{
    <p class="text-muted">No two image sets have the same VikingXML content.</p>
}
else
{
    <p class="text-muted small">
        These image sets have identical VikingXML apart from the host path. If they serve the same files, add the
        other hosts as mirrors of one set (AnnotationContext &rarr; Mirrors) so clients can load-balance between them.
    </p>
    @foreach (var suggestion in Model.CloneSuggestions)
    {
        <div class="card card-modern mb-2">
            <div class="card-body">
                <div class="small text-muted mb-1">Hash <code>@suggestion.ContentHash.Substring(0, 12)</code></div>
                <ul class="mb-0">
                    @foreach (var imageSet in suggestion.Volumes)
                    {
                        <li>
                            <strong>@imageSet.Name</strong>
                            (@imageSet.Mirrors.Count mirror(s); volumes:
                            @foreach (var volume in imageSet.AnnotationContexts)
                            {
                                <a asp-controller="AnnotationContexts" asp-action="Mirrors" asp-route-id="@volume.Id" class="me-1">@volume.Name</a>
                            })
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
}
