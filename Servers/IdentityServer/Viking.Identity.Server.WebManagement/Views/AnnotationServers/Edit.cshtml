@model Viking.Identity.Models.AnnotationServer
@using Viking.Identity.Server.Extensions.Services

@{
    ViewData["Title"] = "Edit Annotation Server";
    ViewData["Breadcrumbs"] = new List<(string Text, string Url)>
    {
        ("Dashboard", Url.Action("Index", "Home")),
        ("Annotation Servers", Url.Action("Index", "AnnotationServers")),
        (Model.Name, Url.Action("Details", "AnnotationServers", new { id = Model.Id })),
        ("Edit", null)
    };
    var annotationUrl = AnnotationServiceUrls.AnnotationUrl(Model);
    var odataUrl = AnnotationServiceUrls.ODataUrl(Model);
    var exportUrl = AnnotationServiceUrls.ExportUrl(Model);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-database"></i> Edit Annotation Server</h2>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Details
    </a>
</div>

<div class="card card-modern">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-pencil-square"></i> Update Details</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" id="editAnnotationServerForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            @Html.HiddenFor(model => model.Id)

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
                <small class="form-text text-muted">
                    The name is the token scope prefix (<code>Name.Annotate</code>). Renaming changes the scopes
                    clients request by this name; volume names keep working.
                </small>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Organizational Unit</label>
                <select asp-for="ParentID" class="form-select" asp-items="ViewBag.AvailableParents">
                    <option value="">No Organization</option>
                </select>
                <span asp-validation-for="ParentID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BaseUrl" class="form-label"></label>
                <input asp-for="BaseUrl" class="form-control" placeholder="https://websvc.example/RC1" />
                <span asp-validation-for="BaseUrl" class="text-danger"></span>
                <small class="form-text text-muted">
                    Service root. Annotation, OData, and Export URLs are derived from this unless Export is overridden below.
                </small>
            </div>

            <div class="mb-3">
                <label class="form-label">Derived URLs</label>
                <dl class="row small mb-0">
                    <dt class="col-sm-3">Annotation</dt>
                    <dd class="col-sm-9"><code>@(annotationUrl ?? "—")</code></dd>
                    <dt class="col-sm-3">OData</dt>
                    <dd class="col-sm-9"><code>@(odataUrl ?? "—")</code></dd>
                    <dt class="col-sm-3">Export (effective)</dt>
                    <dd class="col-sm-9"><code>@(exportUrl ?? "—")</code></dd>
                </dl>
            </div>

            <div class="mb-3">
                <label asp-for="ExportUrl" class="form-label"></label>
                <input asp-for="ExportUrl" class="form-control" placeholder="Leave empty for BaseUrl/Export/" />
                <span asp-validation-for="ExportUrl" class="text-danger"></span>
                <small class="form-text text-muted">Optional override when Export is hosted outside the Base URL.</small>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-save"></i> Save Changes
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-lg ms-2">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
