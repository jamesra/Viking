@using Viking.Identity.Server.Extensions.Services
@model GrantCopyReport

@{
    ViewData["Title"] = "Volume grants copied to annotation servers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-shield-check"></i> @ViewData["Title"]</h2>
    <a asp-action="Catalog" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Catalog Report
    </a>
</div>

<div class="alert alert-info">
    Added @Model.UserGrantsAdded user grant(s) and @Model.GroupGrantsAdded group grant(s) to annotation servers.
    Volume grants were left in place, so effective access is the union of both.
    @if (Model.VolumesWithoutAnnotationServer > 0)
    {
        <span>@Model.VolumesWithoutAnnotationServer volume(s) have no annotation server and keep their own grants.</span>
    }
</div>

<h4>Widened access</h4>
@if (!Model.WidenedAccess.Any())
{
    <p class="text-muted">No user or group reaches a volume it was not already granted.</p>
}
else
{
    <p class="text-muted">
        These users and groups were granted a permission on one volume and now hold it on the annotation database,
        so they also reach the other volumes that share it. Review each row; remove the annotation server grant
        under Manage Permissions if it should not apply.
    </p>
    <table class="table table-modern">
        <thead>
            <tr>
                <th>Annotation Server</th>
                <th>Grantee</th>
                <th>Permission</th>
                <th>Granted on</th>
                <th>Now also reaches</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Model.WidenedAccess)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@entry.AnnotationServerId">@entry.AnnotationServerName</a></td>
                    <td>
                        <i class="bi @(entry.PrincipalType == "User" ? "bi-person" : "bi-people-fill")"></i>
                        @entry.PrincipalName
                    </td>
                    <td>@entry.Permission</td>
                    <td>@string.Join(", ", entry.SourceVolumes)</td>
                    <td>@string.Join(", ", entry.NewlyReachableVolumes)</td>
                </tr>
            }
        </tbody>
    </table>
}
