@using Viking.Identity.Server.Authorization
@model Viking.Identity.Models.Volume

@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-hdd entity-icon-volume"></i> @Model.Name</h2>
    <div class="btn-group" role="group">
        @if ((await AuthorizationService.IsParentOrgUnitAdminAsync(User, Model)))
        {
            <a asp-controller="GrantedPermissions" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-shield-check"></i> Manage Permissions
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card card-modern card-volume mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> Volume Information</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@Model.Name</dd>
                    
                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">
                        @if (string.IsNullOrEmpty(Model.Description))
                        {
                            <em class="text-muted">No description</em>
                        }
                        else
                        {
                            @Model.Description
                        }
                    </dd>
                    
                    @if (Model.Parent != null)
                    {
                        <dt class="col-sm-3">Organization</dt>
                        <dd class="col-sm-9">
                            <i class="bi bi-building text-org"></i>
                            <a asp-controller="OrganizationalUnits" asp-action="Details" asp-route-id="@Model.Parent.Id">@Model.Parent.Name</a>
                        </dd>
                    }
                    
                    <dt class="col-sm-3">Resource Type</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-info">@Model.ResourceTypeId</span>
                    </dd>
                    
                    @if (!string.IsNullOrEmpty(Model.Endpoint?.ToString()))
                    {
                        <dt class="col-sm-3">Endpoint</dt>
                        <dd class="col-sm-9">
                            <a href="@Model.Endpoint" target="_blank" class="btn btn-success btn-sm">
                                <i class="bi bi-box-arrow-up-right"></i> Open Volume
                            </a>
                            <a asp-controller="VikingLaunch" asp-action="CreateCode" asp-route-volume="@(Model.Endpoint?.ToString())" class="btn btn-primary btn-sm">
                                <i class="bi bi-box-arrow-up-right"></i> Open in Viking
                            </a>
                            <a href="https://websvc.codepharm.net/Software/Viking/Viking-win-Setup.exe" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm" title="Download Viking if not installed">
                                <i class="bi bi-download"></i> Install Viking
                            </a>
                            <small class="text-muted ms-2">@Model.Endpoint</small>
                        </dd>
                    }
                </dl>
            </div>
        </div>

        @if ((await AuthorizationService.IsParentOrgUnitAdminAsync(User, Model)))
        {
            <div class="card card-modern">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-shield-check"></i> Permission Management</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Manage which users and groups have access to this volume and what permissions they have.</p>
                    <a asp-controller="GrantedPermissions" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-shield-check"></i> Manage Permissions
                    </a>
                </div>
            </div>
        }
    </div>
    
    <div class="col-md-4">
        <div class="card card-modern">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="bi bi-shield-check"></i> Quick Actions</h5>
            </div>
            <div class="list-group list-group-flush">
                @if (!string.IsNullOrEmpty(Model.Endpoint?.ToString()))
                {
                    <a href="@Model.Endpoint" target="_blank" class="list-group-item list-group-item-action">
                        <i class="bi bi-box-arrow-up-right"></i> Open Volume
                    </a>
                    <a asp-controller="VikingLaunch" asp-action="CreateCode" asp-route-volume="@(Model.Endpoint?.ToString())" class="list-group-item list-group-item-action">
                        <i class="bi bi-box-arrow-up-right"></i> Open in Viking
                    </a>
                    <a href="https://websvc.codepharm.net/Software/Viking/Viking-win-Setup.exe" target="_blank" rel="noopener noreferrer" class="list-group-item list-group-item-action" title="Download Viking if not installed">
                        <i class="bi bi-download"></i> Install Viking
                    </a>
                }
                @if (Model.Parent != null)
                {
                    <a asp-controller="OrganizationalUnits" asp-action="Details" asp-route-id="@Model.Parent.Id" class="list-group-item list-group-item-action">
                        <i class="bi bi-building text-org"></i> View Organization
                    </a>
                }
                @if ((await AuthorizationService.IsParentOrgUnitAdminAsync(User, Model)))
                {
                    <a asp-controller="GrantedPermissions" asp-action="Edit" asp-route-id="@Model.Id" class="list-group-item list-group-item-action">
                        <i class="bi bi-shield-check"></i> Manage Permissions
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="list-group-item list-group-item-action">
                        <i class="bi bi-pencil"></i> Edit Volume
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="list-group-item list-group-item-action text-danger">
                        <i class="bi bi-trash"></i> Delete Volume
                    </a>
                }
            </div>
        </div>
    </div>
</div>
