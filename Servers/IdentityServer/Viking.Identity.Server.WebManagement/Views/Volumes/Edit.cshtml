@model Viking.Identity.Models.Volume
@using Viking.Identity.Models
@using Viking.Identity.Server.Extensions.Services

@{
    ViewData["Title"] = "Edit Volume";
    ViewData["Breadcrumbs"] = new List<(string Text, string Url)>
    {
        ("Dashboard", Url.Action("Index", "Home")),
        ("Volumes", Url.Action("Index", "Volumes")),
        (Model.Name, Url.Action("Details", "Volumes", new { id = Model.Id })),
        ("Edit", null)
    };
    var allServers = (IEnumerable<AnnotationServer>)(ViewBag.AvailableAnnotationServers ?? Array.Empty<AnnotationServer>());
    var linkedIds = new HashSet<long>(
        (Model.AnnotationServerLinks ?? new List<VolumeAnnotationServer>())
            .Select(l => l.AnnotationServerId)
            .Concat(Model.AnnotationServerId.HasValue ? new[] { Model.AnnotationServerId.Value } : Array.Empty<long>()));
    var defaultId = Model.AnnotationServerLinks?.FirstOrDefault(l => l.IsDefault)?.AnnotationServerId
        ?? Model.AnnotationServerId;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-hdd-stack"></i> Edit Volume: @Model.Name</h2>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Details
    </a>
</div>

<div class="card card-modern">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Volume Information</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" id="editVolumeForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ResourceTypeId" />
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Endpoint" class="form-label"></label>
                <input asp-for="Endpoint" class="form-control" placeholder="https://example.com/volume" />
                <span asp-validation-for="Endpoint" class="text-danger"></span>
                <small class="form-text text-muted">
                    VikingXML URL of the preferred mirror. Changing it re-reads the VikingXML and adds the URL as the
                    preferred mirror. Manage other hosts under Image Set and Mirrors.
                </small>
            </div>
            <div class="mb-3">
                <label class="form-label">Annotation Servers</label>
                <div class="border rounded p-3">
                    @if (!allServers.Any())
                    {
                        <em class="text-muted">No annotation servers exist yet. Create one under Annotation Servers, or sync a volume whose VikingXML has VolumeToEndpoint.</em>
                    }
                    else
                    {
                        <p class="small text-muted mb-2">
                            Select one or more servers. The default is used when Viking opens this volume; if more than one
                            is linked, the user can pick another at login. With none selected, Viking uses VikingXML
                            <code>VolumeToEndpoint</code>.
                        </p>
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th style="width:3rem">Link</th>
                                    <th style="width:5rem">Default</th>
                                    <th>Server</th>
                                    <th>Base URL</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var server in allServers.OrderBy(s => s.Name))
                            {
                                var isLinked = linkedIds.Contains(server.Id);
                                var isDefault = defaultId == server.Id;
                                <tr>
                                    <td>
                                        <input type="checkbox" name="linkedAnnotationServerIds" value="@server.Id"
                                               class="form-check-input annotation-server-link"
                                               @(isLinked ? "checked" : null) />
                                    </td>
                                    <td>
                                        <input type="radio" name="defaultAnnotationServerId" value="@server.Id"
                                               class="form-check-input"
                                               @(isDefault ? "checked" : null) />
                                    </td>
                                    <td>
                                        <a asp-controller="AnnotationServers" asp-action="Details" asp-route-id="@server.Id">@server.Name</a>
                                    </td>
                                    <td class="small"><code>@server.BaseUrl</code></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="RegistrationName" class="form-label"></label>
                <input asp-for="RegistrationName" class="form-control" placeholder="VikingXML default" />
                <span asp-validation-for="RegistrationName" class="text-danger"></span>
                <small class="form-text text-muted">
                    StosGroup that aligns these images with the annotation database. Leave empty for the VikingXML
                    default; use <code>None</code> when the images are already in volume space.
                </small>
            </div>
            <div class="mb-3">
                <label asp-for="Parent" class="form-label"></label>
                <select asp-for="ParentID" asp-items="@ViewBag.AvailableParents" class="form-select">
                    <option value="">None</option>
                </select>
                <span asp-validation-for="ParentID" class="text-danger"></span>
            </div>
            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-save"></i> Save Changes
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-lg ms-2">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            $('#editVolumeForm').on('submit', function() {
                var $submitBtn = $(this).find('button[type="submit"]');
                $submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Saving...');
            });
        });
    </script>
}
