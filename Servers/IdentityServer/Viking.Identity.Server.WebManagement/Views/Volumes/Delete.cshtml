@model Viking.Identity.Models.Volume

@{
    ViewData["Title"] = "Delete Volume";
    ViewData["Breadcrumbs"] = new List<(string Text, string Url)>
    {
        ("Dashboard", Url.Action("Index", "Home")),
        ("Volumes", Url.Action("Index", "Volumes")),
        (Model.Name, Url.Action("Details", "Volumes", new { id = Model.Id })),
        ("Delete", null)
    };
}

<div class="alert alert-warning" role="alert">
    <h4 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Warning!</h4>
    <p>Are you sure you want to delete this volume? This action cannot be undone and will remove all associated permissions.</p>
</div>

<div class="card card-modern">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0"><i class="bi bi-trash"></i> Delete Volume: @Model.Name</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>
            
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Description)</dt>
            <dd class="col-sm-9">
                @if (string.IsNullOrEmpty(Model.Description))
                {
                    <em class="text-muted">No description</em>
                }
                else
                {
                    @Html.DisplayFor(model => model.Description)
                }
            </dd>
            
            @if (Model.Endpoint != null && !string.IsNullOrEmpty(Model.Endpoint.ToString()))
            {
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Endpoint)</dt>
                <dd class="col-sm-9">
                    <a href="@Model.Endpoint" target="_blank">@Html.DisplayFor(model => model.Endpoint)</a>
                </dd>
            }
            
            @if (Model.Parent != null)
            {
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Parent)</dt>
                <dd class="col-sm-9">
                    <i class="bi bi-building text-org"></i>
                    <a asp-controller="OrganizationalUnits" asp-action="Details" asp-route-id="@Model.Parent.Id">@Html.DisplayFor(model => model.Parent.Name)</a>
                </dd>
            }
            
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ResourceType)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.ResourceType.Id)</dd>
        </dl>
        
        <form asp-action="Delete" id="deleteForm">
            <input type="hidden" asp-for="Id" />
            <div class="form-group mt-4">
                <button type="submit" class="btn btn-danger btn-lg">
                    <i class="bi bi-trash"></i> Delete Volume
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-lg ms-2">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#deleteForm').on('submit', function(e) {
                if (!confirm('Are you absolutely sure you want to delete this volume? This action cannot be undone.')) {
                    e.preventDefault();
                    return false;
                }
                var $submitBtn = $(this).find('button[type="submit"]');
                $submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Deleting...');
            });
        });
    </script>
}
