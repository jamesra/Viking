@model Viking.Identity.Server.WebManagement.Models.UserViewModels.MyRightsViewModel

@{
    ViewData["Title"] = "My Rights";
}

<h2>My Rights</h2>

<div class="row">
    <div class="col-md-12">
        @if (Model.IsAuthenticated)
        {
            <p>Welcome, <strong>@Model.Username</strong>! Below are the volumes you have access to and your permissions for each.</p>
        }
        else
        {
            <p>Welcome, <strong>Guest</strong>! You are viewing this page without authentication. No volume access rights are available.</p>
        }
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        @if (Model.AccessibleVolumes.Any())
        {
            <h3>Accessible Volumes</h3>
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Volume Name</th>
                        <th>Description</th>
                        <th>Endpoint</th>
                        <th>Permissions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var volume in Model.AccessibleVolumes)
                    {
                        <tr>
                            <td>@volume.Name</td>
                            <td>@(string.IsNullOrEmpty(volume.Description) ? "No description available" : volume.Description)</td>
                            <td>
                                @if (!string.IsNullOrEmpty(volume.Endpoint))
                                {
                                    <a href="@volume.Endpoint" target="_blank" class="btn btn-sm btn-primary">
                                        <span class="glyphicon glyphicon-link" aria-hidden="true"></span> Access Volume
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">No endpoint available</span>
                                }
                            </td>
                            <td>
                                @if (volume.Permissions.Any())
                                {
                                    <span class="badge badge-info">@string.Join(", ", volume.Permissions)</span>
                                }
                                else
                                {
                                    <span class="text-muted">No specific permissions</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">
                <h4>No Accessible Volumes</h4>
                @if (Model.IsAuthenticated)
                {
                    <p>You don't currently have access to any volumes, or there may be an issue retrieving your permissions. Please contact your administrator if you believe this is an error.</p>
                }
                else
                {
                    <p>As a guest user, you don't have access to any volumes. Please <a asp-area="" asp-controller="Account" asp-action="Login">log in</a> to see your volume access rights.</p>
                }
            </div>
        }
    </div>
</div>

@if (Model.IsAuthenticated)
{
    <div class="row">
        <div class="col-md-12">
            <div class="alert alert-info">
                <h4>About Your Rights</h4>
                <p>This page shows the volumes you have been granted access to and the specific permissions you have for each volume. If you need additional access or have questions about your permissions, please contact your administrator.</p>
            </div>
        </div>
    </div>
}



