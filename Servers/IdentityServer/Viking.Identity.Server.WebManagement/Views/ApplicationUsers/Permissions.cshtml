@model Viking.Identity.Server.WebManagement.Models.UserViewModels.UserAllPermissionsViewModel

@{
    ViewData["Title"] = $"Permissions: {Model.UserName}";
    ViewData["Breadcrumbs"] = new List<(string Text, string Url)>
    {
        ("Dashboard", Url.Action("Index", "Home")),
        ("Users", Url.Action("Index", "ApplicationUsers")),
        (Model.UserName, Url.Action("Details", "ApplicationUsers", new { id = Model.UserId })),
        ("Permissions", null)
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-shield-check"></i> Permissions for @Model.UserName</h2>
    <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Profile
    </a>
</div>

@await Html.PartialAsync("~/Views/Manage/_StatusMessage.cshtml", TempData["StatusMessage"] as string)

<div class="card card-modern mb-4">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="bi bi-person-check"></i> Direct grants <span class="badge bg-light text-dark">@Model.Direct.Count</span></h5>
    </div>
    <div class="card-body">
        <p class="text-muted">Granted to this user personally. Revoking removes the grant immediately; the next token the user requests reflects it.</p>
        @if (!Model.Direct.Any())
        {
            <p class="text-muted mb-0">No direct grants.</p>
        }
        else
        {
            <table class="table table-sm align-middle">
                <thead><tr><th>Resource</th><th>Type</th><th>Permissions (click to revoke one)</th><th class="text-end">All</th></tr></thead>
                <tbody>
                @foreach (var row in Model.Direct)
                {
                    <tr>
                        <td>@row.ResourceName</td>
                        <td><span class="badge bg-secondary">@row.ResourceType</span></td>
                        <td>
                            @foreach (var permission in row.Permissions)
                            {
                                <form asp-action="RevokePermission" method="post" class="d-inline revoke-form"
                                      data-confirm="Revoke @permission on @row.ResourceName from @Model.UserName?">
                                    <input type="hidden" name="id" value="@Model.UserId" />
                                    <input type="hidden" name="resourceId" value="@row.ResourceId" />
                                    <input type="hidden" name="permissionId" value="@permission" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger mb-1" title="Revoke @permission">
                                        @permission <i class="bi bi-x-circle"></i>
                                    </button>
                                </form>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="RevokePermission" method="post" class="d-inline revoke-form"
                                  data-confirm="Revoke ALL permissions on @row.ResourceName from @Model.UserName?">
                                <input type="hidden" name="id" value="@Model.UserId" />
                                <input type="hidden" name="resourceId" value="@row.ResourceId" />
                                <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> Revoke all</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="card card-modern">
    <div class="card-header bg-group text-white">
        <h5 class="mb-0"><i class="bi bi-people-fill"></i> Inherited through groups <span class="badge bg-light text-dark">@Model.Inherited.Count</span></h5>
    </div>
    <div class="card-body">
        <p class="text-muted">Held because the user belongs to these groups, directly or through nested groups. To revoke, remove the user from the group or edit the group's grants.</p>
        @if (!Model.Inherited.Any())
        {
            <p class="text-muted mb-0">No inherited grants.</p>
        }
        else
        {
            <table class="table table-sm align-middle">
                <thead><tr><th>Resource</th><th>Type</th><th>Permission</th><th>Via group</th></tr></thead>
                <tbody>
                @foreach (var row in Model.Inherited)
                {
                    <tr>
                        <td>@row.ResourceName</td>
                        <td><span class="badge bg-secondary">@row.ResourceType</span></td>
                        <td><span class="badge bg-permission">@row.PermissionId</span></td>
                        <td><a asp-controller="Groups" asp-action="Details" asp-route-id="@row.GroupId">@row.GroupName</a></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.revoke-form').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                if (!window.confirm(form.dataset.confirm)) { e.preventDefault(); }
            });
        });
    </script>
}
