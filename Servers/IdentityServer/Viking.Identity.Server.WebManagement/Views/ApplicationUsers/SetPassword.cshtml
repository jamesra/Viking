@model Viking.Identity.Server.WebManagement.Models.UserViewModels.AdminSetPasswordViewModel

@{
    ViewData["Title"] = "Set Password";
    ViewData["Breadcrumbs"] = new List<(string Text, string Url)>
    {
        ("Dashboard", Url.Action("Index", "Home")),
        ("Users", Url.Action("Index", "ApplicationUsers")),
        (Model.UserName, Url.Action("Details", "ApplicationUsers", new { id = Model.UserId })),
        ("Set Password", null)
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-key"></i> Set Password: @Model.UserName</h2>
    <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to User Details
    </a>
</div>

<div class="card card-modern">
    <div class="card-header bg-warning text-dark">
        <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Administrator Password Override</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <i class="bi bi-shield-lock"></i>
            You are setting a new password for <strong>@Model.UserName</strong>. The user's current password is not required.
        </div>

        <form asp-action="SetPassword" asp-route-id="@Model.UserId" method="post">
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="UserName" />

            <div class="mb-3">
                <label asp-for="UserName" class="form-label"></label>
                <input asp-for="UserName" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-key"></i> Set Password
                </button>
                <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-outline-secondary btn-lg ms-2">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
