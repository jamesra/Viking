@model Viking.Identity.Server.WebManagement.Models.UserViewModels.UserGroupsViewModel

@{
    ViewData["Title"] = "Edit Group Memberships";
    ViewData["Breadcrumbs"] = new List<(string Text, string Url)>
    {
        ("Dashboard", Url.Action("Index", "Home")),
        ("Users", Url.Action("Index", "ApplicationUsers")),
        (Model.Name, Url.Action("Details", "ApplicationUsers", new { id = Model.Id })),
        ("Edit Group Memberships", null)
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-person-check"></i> Edit Group Memberships: @Model.Name</h2>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to User Details
    </a>
</div>

<div class="card card-modern">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-people-fill"></i> Group Memberships</h5>
    </div>
    <div class="card-body">
        <form asp-action="EditOrganizations" id="editOrganizationsForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Name" />
            
            @if (Model.Organizations != null && Model.Organizations.Any())
            {
                <div class="mb-3">
                    <label class="form-label fw-bold">Search Groups:</label>
                    <input type="text" 
                           id="groupSearch" 
                           class="form-control" 
                           placeholder="Type to search groups..." 
                           autocomplete="off">
                    <small class="form-text text-muted">Filter groups by name</small>
                </div>
                
                <div class="mb-3">
                    <div class="btn-group btn-group-sm mb-2" role="group" aria-label="Quick actions">
                        <button type="button" class="btn btn-outline-primary" id="selectAllBtn">
                            <i class="bi bi-check-square"></i> Select All
                        </button>
                        <button type="button" class="btn btn-outline-secondary" id="deselectAllBtn">
                            <i class="bi bi-square"></i> Deselect All
                        </button>
                        <button type="button" class="btn btn-outline-info" id="showSelectedBtn">
                            <i class="bi bi-eye"></i> Show Selected Only
                        </button>
                    </div>
                </div>

                <div class="group-checklist-container border rounded p-3" style="max-height: 500px; overflow-y: auto;">
                    @await Html.PartialAsync("~/Views/Shared/GroupSelectedChecklist", Model.Organizations)
                </div>

                <div class="mt-3">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> 
                        <strong>@Model.Organizations.Count(x => x.Selected)</strong> of <strong>@Model.Organizations.Count</strong> groups selected.
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i> No groups are available in the system.
                </div>
            }

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-save"></i> Save Group Memberships
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-lg ms-2">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            var $container = $('.group-checklist-container');
            var $items = $('.group-checklist-item');
            var showSelectedOnly = false;

            // Search functionality
            $('#groupSearch').on('keyup', function() {
                var searchText = $(this).val().toLowerCase();
                $items.each(function() {
                    var groupName = $(this).data('group-name');
                    if (groupName && groupName.includes(searchText)) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            });

            // Select all button
            $('#selectAllBtn').on('click', function() {
                $items.filter(':visible').find('input[type="checkbox"]').prop('checked', true).trigger('change');
                updateSelectionCount();
            });

            // Deselect all button
            $('#deselectAllBtn').on('click', function() {
                $items.filter(':visible').find('input[type="checkbox"]').prop('checked', false).trigger('change');
                updateSelectionCount();
            });

            // Show selected only toggle
            $('#showSelectedBtn').on('click', function() {
                showSelectedOnly = !showSelectedOnly;
                if (showSelectedOnly) {
                    $(this).html('<i class="bi bi-eye-slash"></i> Show All');
                    $items.each(function() {
                        var isChecked = $(this).find('input[type="checkbox"]').is(':checked');
                        $(this).toggle(isChecked);
                    });
                } else {
                    $(this).html('<i class="bi bi-eye"></i> Show Selected Only');
                    $('#groupSearch').trigger('keyup'); // Reapply search filter
                }
            });

            // Update selection count on checkbox change
            $items.find('input[type="checkbox"]').on('change', function() {
                updateSelectionCount();
            });

            function updateSelectionCount() {
                var selected = $items.find('input[type="checkbox"]:checked').length;
                var total = $items.length;
                $('.alert-info strong').first().text(selected);
                $('.alert-info strong').last().text(total);
            }

            // Form submission with loading state
            $('#editOrganizationsForm').on('submit', function() {
                var $submitBtn = $(this).find('button[type="submit"]');
                $submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Saving...');
            });

            // Initial count update
            updateSelectionCount();
        });
    </script>
}
