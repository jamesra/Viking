@using Viking.Identity.Server.Authorization
@model Viking.Identity.Models.OrganizationalUnit

@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var volumes = ViewData["Volumes"] as List<Viking.Identity.Models.Volume> ?? new List<Viking.Identity.Models.Volume>();
    var childOrgs = ViewData["ChildOrganizations"] as List<Viking.Identity.Models.OrganizationalUnit> ?? new List<Viking.Identity.Models.OrganizationalUnit>();
    var groups = ViewData["Groups"] as List<Viking.Identity.Models.Group> ?? new List<Viking.Identity.Models.Group>();
    var canEdit = (await AuthorizationService.AuthorizeAsync(User, Model, Operations.OrgUnitAdmin)).Succeeded;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-building text-org"></i> @Model.Name</h2>
    <div class="btn-group" role="group">
        @if (canEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<!-- Tab Navigation -->
<ul class="nav nav-tabs mb-4" id="orgTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview" type="button" role="tab" aria-controls="overview" aria-selected="true">
            <i class="bi bi-info-circle"></i> Overview
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="volumes-tab" data-bs-toggle="tab" data-bs-target="#volumes" type="button" role="tab" aria-controls="volumes" aria-selected="false">
            <i class="bi bi-hdd-stack"></i> Volumes
            @if (volumes.Any())
            {
                <span class="badge bg-success ms-1">@volumes.Count</span>
            }
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="children-tab" data-bs-toggle="tab" data-bs-target="#children" type="button" role="tab" aria-controls="children" aria-selected="false">
            <i class="bi bi-diagram-3"></i> Child Organizations
            @if (childOrgs.Any())
            {
                <span class="badge bg-primary ms-1">@childOrgs.Count</span>
            }
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="groups-tab" data-bs-toggle="tab" data-bs-target="#groups" type="button" role="tab" aria-controls="groups" aria-selected="false">
            <i class="bi bi-people-fill"></i> Groups
            @if (groups.Any())
            {
                <span class="badge bg-info ms-1">@groups.Count</span>
            }
        </button>
    </li>
    @if (canEdit)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="permissions-tab" data-bs-toggle="tab" data-bs-target="#permissions" type="button" role="tab" aria-controls="permissions" aria-selected="false">
                <i class="bi bi-shield-check"></i> Permissions
            </button>
        </li>
    }
</ul>

<!-- Tab Content -->
<div class="tab-content" id="orgTabContent">
    <!-- Overview Tab -->
    <div class="tab-pane fade show active" id="overview" role="tabpanel" aria-labelledby="overview-tab">
        <div class="card card-modern">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@Model.Name</dd>
                    
                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">
                        @if (string.IsNullOrEmpty(Model.Description))
                        {
                            <em class="text-muted">No description</em>
                        }
                        else
                        {
                            @Model.Description
                        }
                    </dd>
                    
                    @if (Model.Parent != null)
                    {
                        <dt class="col-sm-3">Parent Organization</dt>
                        <dd class="col-sm-9">
                            <i class="bi bi-building text-org"></i>
                            <a asp-action="Details" asp-route-id="@Model.Parent.Id">@Model.Parent.Name</a>
                        </dd>
                    }
                    
                    <dt class="col-sm-3">Resource Type</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-info">@Model.ResourceTypeId</span>
                    </dd>
                    
                    <dt class="col-sm-3">Child Organizations</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-primary">@childOrgs.Count</span>
                    </dd>
                    
                    <dt class="col-sm-3">Volumes</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-success">@volumes.Count</span>
                    </dd>
                    
                    <dt class="col-sm-3">Groups</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-info">@groups.Count</span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Volumes Tab -->
    <div class="tab-pane fade" id="volumes" role="tabpanel" aria-labelledby="volumes-tab">
        @if (canEdit)
        {
            <div class="mb-3">
                <a asp-controller="Volumes" asp-action="Create" asp-route-parentOrgId="@Model.Id" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Create Volume
                </a>
            </div>
        }
        @if (volumes.Any())
        {
            <div class="row">
                @foreach (var volume in volumes.OrderBy(v => v.Name))
                {
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="card card-modern card-volume h-100">
                            <div class="card-body">
                                <h6 class="card-title">
                                    <i class="bi bi-hdd entity-icon-volume"></i> @volume.Name
                                </h6>
                                <p class="card-text text-muted small">
                                    @(string.IsNullOrEmpty(volume.Description) ? "No description" : volume.Description)
                                </p>
                                
                                @{
                                    var uniqueUserCount = volume.UsersWithPermissions?.Select(p => p.UserId).Distinct().Count() ?? 0;
                                }
                                @if (uniqueUserCount > 0)
                                {
                                    <div class="mb-2">
                                        <span class="badge bg-info">
                                            <i class="bi bi-person"></i> @uniqueUserCount unique user(s)
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div class="mb-2">
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-exclamation-triangle"></i> No users with permissions
                                        </span>
                                    </div>
                                }
                                
                                @if (!string.IsNullOrEmpty(volume.Endpoint?.ToString()))
                                {
                                    <div class="card-text mb-2">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <input type="text" class="form-control form-control-sm" id="volumeUrl_@volume.Id" value="@volume.Endpoint" readonly style="font-size: 0.875rem;">
                                            <button type="button" class="btn btn-sm btn-outline-secondary copy-url-btn" data-url="@volume.Endpoint" title="Copy to clipboard">
                                                <i class="bi bi-clipboard"></i>
                                            </button>
                                        </div>
                                        <a href="@volume.Endpoint" target="_blank" class="btn btn-sm btn-success">
                                            <i class="bi bi-box-arrow-up-right"></i> Access Volume
                                        </a>
                                    </div>
                                }
                                
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-controller="Volumes" asp-action="Details" asp-route-id="@volume.Id" class="btn btn-outline-info">
                                        <i class="bi bi-info-circle"></i> Details
                                    </a>
                                    @if ((await AuthorizationService.IsParentOrgUnitAdminAsync(User, volume)))
                                    {
                                        <a asp-controller="GrantedPermissions" asp-action="Edit" asp-route-id="@volume.Id" class="btn btn-outline-primary">
                                            <i class="bi bi-shield-check"></i> Permissions
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> This organization doesn't have any volumes yet.
                @if (canEdit)
                {
                    <a asp-controller="Volumes" asp-action="Create" class="alert-link">Create a new volume</a>
                }
            </div>
        }
    </div>

    <!-- Child Organizations Tab -->
    <div class="tab-pane fade" id="children" role="tabpanel" aria-labelledby="children-tab">
        @if (canEdit)
        {
            <div class="mb-3">
                <a asp-action="Create" asp-route-parentOrgId="@Model.Id" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Create Child Organization
                </a>
            </div>
        }
        @if (childOrgs.Any())
        {
            <div class="row">
                @foreach (var childOrg in childOrgs.OrderBy(o => o.Name))
                {
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="card card-modern card-org h-100">
                            <div class="card-body">
                                <h6 class="card-title">
                                    <i class="bi bi-building entity-icon-org"></i> @childOrg.Name
                                </h6>
                                <p class="card-text text-muted small">
                                    @(string.IsNullOrEmpty(childOrg.Description) ? "No description" : childOrg.Description)
                                </p>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@childOrg.Id" class="btn btn-outline-info">
                                        <i class="bi bi-info-circle"></i> Details
                                    </a>
                                    @if ((await AuthorizationService.AuthorizeAsync(User, childOrg, Operations.OrgUnitAdmin)).Succeeded)
                                    {
                                        <a asp-action="Edit" asp-route-id="@childOrg.Id" class="btn btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> This organization doesn't have any child organizations.
                @if (canEdit)
                {
                    <a asp-action="Create" asp-route-parentOrgId="@Model.Id" class="alert-link">Create a child organization</a>
                }
            </div>
        }
    </div>

    <!-- Groups Tab -->
    <div class="tab-pane fade" id="groups" role="tabpanel" aria-labelledby="groups-tab">
        @if (canEdit)
        {
            <div class="mb-3">
                <a asp-controller="Groups" asp-action="Create" asp-route-parentOrgId="@Model.Id" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Create Group
                </a>
            </div>
        }
        @if (groups.Any())
        {
            <div class="row">
                @foreach (var group in groups.OrderBy(g => g.Name))
                {
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="card card-modern card-group h-100">
                            <div class="card-body">
                                <h6 class="card-title">
                                    <i class="bi bi-people-fill entity-icon-group"></i> @group.Name
                                </h6>
                                <p class="card-text text-muted small">
                                    @if (string.IsNullOrEmpty(group.Description))
                                    {
                                        <em class="text-muted">No description</em>
                                    }
                                    else
                                    {
                                        @group.Description
                                    }
                                </p>
                                
                                @{
                                    var numUsers = group.MemberUsers?.Count ?? 0;
                                    var numGroups = group.MemberGroups?.Count ?? 0;
                                }
                                
                                <div class="mb-2">
                                    @if (numUsers > 0)
                                    {
                                        <span class="badge bg-success me-1">
                                            <i class="bi bi-person"></i> @numUsers user(s)
                                        </span>
                                    }
                                    @if (numGroups > 0)
                                    {
                                        <span class="badge bg-info">
                                            <i class="bi bi-people"></i> @numGroups group(s)
                                        </span>
                                    }
                                    @if (numUsers == 0 && numGroups == 0)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-exclamation-triangle"></i> No members
                                        </span>
                                    }
                                </div>
                                
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-controller="Groups" asp-action="Details" asp-route-id="@group.Id" class="btn btn-outline-info">
                                        <i class="bi bi-info-circle"></i> Details
                                    </a>
                                    @if ((await AuthorizationService.AuthorizeAsync(User, group, Operations.GroupAccessManager)).Succeeded ||
                                         (await AuthorizationService.IsParentOrgUnitAdminAsync(User, group)))
                                    {
                                        @if (group.Id != Special.Groups.Everyone.Id)
                                        {
                                            <a asp-controller="Groups" asp-action="Edit" asp-route-id="@group.Id" class="btn btn-outline-primary">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>
                                        }
                                    }
                                    @if (group.Id == Special.Groups.Everyone.Id)
                                    {
                                        <span class="badge bg-warning text-dark ms-1" title="Special system group - cannot be edited">
                                            <i class="bi bi-shield-lock"></i> System
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> This organization doesn't have any groups yet.
                @if (canEdit)
                {
                    <a asp-controller="Groups" asp-action="Create" asp-route-parentOrgId="@Model.Id" class="alert-link">Create a new group</a>
                }
            </div>
        }
    </div>

    <!-- Permissions Tab -->
    @if (canEdit)
    {
        <div class="tab-pane fade" id="permissions" role="tabpanel" aria-labelledby="permissions-tab">
            <div class="card card-modern">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-shield-check"></i> Organization Permissions</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Manage who can administer this organization and its resources.</p>
                    <a asp-controller="GrantedPermissions" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-shield-check"></i> Manage Permissions
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Copy URL to clipboard functionality
            $('.copy-url-btn').on('click', function() {
                var url = $(this).data('url');
                var $input = $(this).siblings('input');
                
                // Use the Clipboard API
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(url).then(function() {
                        var $btn = $(this);
                        var originalHtml = $btn.html();
                        $btn.html('<i class="bi bi-check"></i>').removeClass('btn-outline-secondary').addClass('btn-success');
                        setTimeout(function() {
                            $btn.html(originalHtml).removeClass('btn-success').addClass('btn-outline-secondary');
                        }, 2000);
                    }.bind(this)).catch(function(err) {
                        console.error('Failed to copy:', err);
                        // Fallback: select and copy
                        $input.select();
                        document.execCommand('copy');
                        alert('URL copied to clipboard');
                    });
                } else {
                    // Fallback for older browsers
                    $input.select();
                    document.execCommand('copy');
                    var $btn = $(this);
                    var originalHtml = $btn.html();
                    $btn.html('<i class="bi bi-check"></i>').removeClass('btn-outline-secondary').addClass('btn-success');
                    setTimeout(function() {
                        $btn.html(originalHtml).removeClass('btn-success').addClass('btn-outline-secondary');
                    }, 2000);
                }
            });
        });
    </script>
}
