@model Viking.Identity.Server.WebManagement.Models.UserViewModels.EditUserRolesViewModel
 
@using (Html.BeginForm("Edit", "UserRoles", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div hidden="hidden">
        @Html.EditorForModel()
        @Html.EditorFor(model => model.Username)
    </div>

    <td>
        @Html.DisplayFor(model => model.Username)
    </td>

    @foreach (var role in Model.AvailableRoles)
    {
        <td class="text-center">
            <div class="form-check form-switch d-flex justify-content-center">
                @Html.CheckBox(@role.Id, Model.Roles.Contains(role.Id), new { 
                    @class = "form-check-input", 
                    @disabled = "disabled",
                    role = "switch"
                })
                <label class="form-check-label visually-hidden" for="@role.Id">@role.Name</label>
            </div>
        </td>
    }
} 