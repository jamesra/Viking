@model Viking.Identity.Server.WebManagement.Models.UserViewModels.GroupMembershipViewModel

<div class="row">
    <div class="col-md-6 mb-3">
        <div class="card card-modern h-100">
            <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-person"></i> @Html.DisplayNameFor(model => Model.UserList)</h6>
            </div>
            <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                <partial name="~/Views/Shared/_UserChecklistPartialView.cshtml" for="@Model.UserList" />
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card card-modern h-100">
            <div class="card-header bg-group text-white">
                <h6 class="mb-0"><i class="bi bi-people-fill"></i> @Html.DisplayNameFor(model => Model.GroupList)</h6>
            </div>
            <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                <partial name="~/Views/Shared/_GroupChecklistPartialView.cshtml" for="@Model.GroupList" />
            </div>
        </div>
    </div>
</div>