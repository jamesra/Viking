@model Viking.Identity.Server.WebManagement.Models.UserViewModels.ResourcePermissionsEditGridViewModel

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@if (Model.GroupPermissions != null && Model.GroupPermissions.Any())
{
<div class="card card-modern mb-4">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0"><i class="bi bi-people-fill"></i> Group Permissions</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-modern permission-grid">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(x => Model.GroupPermissions[0].Name)
                </th>

                @for (int i = 0; i < Model.AvailablePermissions.Count(); i++)
                {
                    <th>
                        @Html.DisplayFor(x => Model.AvailablePermissions[i])
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.GroupPermissions.Count(); i++)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(x => Model.GroupPermissions[i].Name)
                        @Html.HiddenFor(x => Model.GroupPermissions[i].Name)
                        @Html.HiddenFor(x => Model.GroupPermissions[i].GranteeId)
                    </td>

                    @for (int iPermission = 0; iPermission < Model.GroupPermissions[i].Permissions.Count(); iPermission++)
                    {
                        <td class="text-center">
                            <div class="form-check form-check-inline d-flex justify-content-center">
                                <partial name="~/Views/Shared/_Checkbox_StringKey.cshtml" for="@Model.GroupPermissions[i].Permissions[iPermission]" />
                            </div>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
        </div>
    </div>
</div>
}
@if (Model.UserPermissions != null && Model.UserPermissions.Any())
{
<div class="card card-modern mb-4">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="bi bi-person"></i> User Permissions</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-modern permission-grid">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(x => Model.UserPermissions[0].Name)
                </th>

                @for (int i = 0; i < Model.AvailablePermissions.Count(); i++)
                {
                    <th>
                        @Html.DisplayFor(x => Model.AvailablePermissions[i])
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.UserPermissions.Count(); i++)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(x => Model.UserPermissions[i].Name)
                        @Html.HiddenFor(x => Model.UserPermissions[i].Name)
                        @Html.HiddenFor(x => Model.UserPermissions[i].GranteeId)
                    </td>

                    @for (int iPermission = 0; iPermission < Model.UserPermissions[i].Permissions.Count(); iPermission++)
                    {
                        <td class="text-center">
                            <div class="form-check form-check-inline d-flex justify-content-center">
                                <partial name="~/Views/Shared/_Checkbox_StringKey.cshtml" for="@Model.UserPermissions[i].Permissions[iPermission]" />
                            </div>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
        </div>
    </div>
</div>
}
@if ((Model.GroupPermissions == null || !Model.GroupPermissions.Any()) && (Model.UserPermissions == null || !Model.UserPermissions.Any()))
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No users or groups have been granted permissions yet.
    </div>
}