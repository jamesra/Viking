@model IList<Viking.Identity.Server.WebManagement.Models.UserViewModels.UserSelectedViewModel>

@if (Model != null && Model.Any())
{
    <div class="user-checklist">
        @for (var i = 0; i < Model.Count(); i++)
        {
            <div class="form-check mb-2">
                <partial name="~/Views/Shared/_UserCheckbox.cshtml" for="@Model[i]" />
            </div>
        }
    </div>
}
else
{
    <p class="text-muted">No users available.</p>
}