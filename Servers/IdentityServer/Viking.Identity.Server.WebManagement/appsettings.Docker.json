{
  "ConnectionStrings": {
     },
  "VikingIdentityServerOptions": {
    "Authority": "https://identity.codepharm.net:5001/",
    "ManagementPublicUrl": "https://identity.codepharm.net:${IDENTITY_MANAGEMENT_HTTPS_PORT}/",
    "Secret": "${IDENTITY_SERVER_SECRET}",
    "ApiSecret": "${IDENTITY_SERVER_API_SECRET}",
    "MvcSecret": "${IDENTITY_SERVER_MVC_SECRET}",
    "RoVikingSecret": "${IDENTITY_SERVER_RO_VIKING_SECRET}"
  },
  "WebApiOptions": {
    "BaseUrl": "https://identity.codepharm.net:6001/"
  },
  "JwtBearerOptions": {
    "Authority": "https://identity.codepharm.net:5001/",
    "RequireHttpsMetadata": false
  },
  "DataContext": {
    "ConnectionStrings": {
      "IdentityConnection": "Server=OpR-Marc-DB2;Database=IdentityViking;Trusted_Connection=True;integrated security=True;MultipleActiveResultSets=true"
    }
  },
  "OAuth2IntrospectionOptions": {
    "Authority": "https://identity.codepharm.net:5001/",
    "ClientId": "mvc",
    "ClientSecret": "${IDENTITY_SERVER_MVC_SECRET}",
    "EnableCaching": true,
    "SaveToken": true
  },
  "Logging": {
    "IncludeScopes": false,
    "LogLevel": {
      "Default": "Information",
      "System": "Information",
      "Microsoft": "Information"
    }
  }, 
  "SSL": {  
    "CertificatePath": "/run/secrets/ssl_cert",
    "KeyPath": "/run/secrets/ssl_key",
    "Password": ""
  },
  "Acme": {
    "ChallengePath": "/app/acme-challenge/.well-known/acme-challenge"
  },
  "SMTP": {
    "Server": "smtp.utah.edu",
    "Port": 25,
    "SourceEmail": "james.r.anderson@utah.edu",
    "SourceDisplayName": "Viking Registration",
    "EnableSSL": true,
    "UseHTML": true,
    "Username": null,
    "Password": null,
    "Timeout": 10
  }
}
