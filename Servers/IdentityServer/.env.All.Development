# Docker compose overlay used by restart_omni_debug.cmd. No secrets.
# Loaded after .env.All so debug flags override defaults without embedding credentials.

ASPNETCORE_ENVIRONMENT=Development
IDENTITY_ENABLE_REMOTE_DEBUG=true
REMOTE_DEBUG_PORT=4024
REMOTE_DEBUG_CONTAINER_PORT=4024
BUILD_CONFIGURATION=Debug

# Container ports, match application ports so they are unique on the development host
IDENTITY_MANAGEMENT_CONTAINER_HTTP_PORT=4000
IDENTITY_MANAGEMENT_CONTAINER_HTTPS_PORT=4001
IDENTITY_STANDALONE_CONTAINER_HTTP_PORT=5000
IDENTITY_STANDALONE_CONTAINER_HTTPS_PORT=5001
IDENTITY_WEBAPI_CONTAINER_HTTP_PORT=6000
IDENTITY_WEBAPI_CONTAINER_HTTPS_PORT=6001
