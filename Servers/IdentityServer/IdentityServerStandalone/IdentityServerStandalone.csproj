<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <UserSecretsId>330c09e3-6f93-4770-9ebc-69a8329329a3</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <AssemblyName>Viking.Identity.Server.Standalone</AssemblyName>
    <RootNamespace>Viking.Identity.Server</RootNamespace>
    <ApplicationIcon />
    <OutputType>Exe</OutputType>
    <StartupObject>Viking.Identity.Server.Standalone.Program</StartupObject>
    <!-- Docker Build Automation -->
    <DockerfileContext Condition="'$(DOTNET_RUNNING_IN_CONTAINER)' != 'true'">..\..</DockerfileContext>
    <DockerImageName>identityserver-standalone</DockerImageName>
    <DockerImageTag>latest</DockerImageTag>
    <DockerContainerName>identityserver-standalone-container</DockerContainerName>
    <DockerfileBuildArguments></DockerfileBuildArguments>
    <DockerfileRunArguments>-p 5000:5000 -p 5001:5001</DockerfileRunArguments>
    <!-- Enable automatic Docker rebuilds -->
    <DockerAutoGenerate>true</DockerAutoGenerate>
    <DockerDevelopmentMode>Fast</DockerDevelopmentMode>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="ConfigurationSubstitutor" Version="1.5.1" />
	<PackageReference Include="DotNetEnv" Version="3.1.1" />
	<PackageReference Include="Duende.IdentityServer" Version="7.3.1" />
    <PackageReference Include="Duende.AspNetCore.Authentication.OAuth2Introspection" Version="6.3.0" />
    <PackageReference Include="Duende.IdentityServer.EntityFramework.Storage" Version="7.3.1" />
	<PackageReference Include="Duende.IdentityServer.AspNetIdentity" Version="7.3.1" />
	<PackageReference Include="Duende.IdentityServer.EntityFramework" Version="7.3.1" />
    <PackageReference Include="MailKit" Version="4.13.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.19.5" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" /> 
	<PackageReference Include="IdentityModel.AspNetCore" Version="4.3.0" />
    <PackageReference Include="IdentityModel.AspNetCore.AccessTokenValidation" Version="1.0.0-preview.0" />
    <PackageReference Include="IdentityModel.AspNetCore.OAuth2Introspection" Version="6.2.0" />
    <PackageReference Include="log4net" Version="2.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="9.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <DotNetCliToolReference Include="Microsoft.EntityFrameworkCore.Tools.DotNet" Version="2.0.1" />
    <DotNetCliToolReference Include="Microsoft.Extensions.SecretManager.Tools" Version="2.0.1" />
    <DotNetCliToolReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Tools" Version="2.0.3" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="../../Identity.DataContext/Identity.DataContext.csproj" />
    <ProjectReference Include="../../Identity.Models/Identity.Models.csproj" />
    <ProjectReference Include="../Identity.Configuration/Identity.Configuration.csproj" />
  </ItemGroup>

	<!-- Debug configuration -->
	<ItemGroup>
		<Content Include="../.env" Condition="Exists('../.env')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

    <!-- Debug configuration -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
	    <Content Include="../.env.Development" Condition="Exists('../.env.Development')">
		    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    </Content>
    </ItemGroup>

    <!-- Release configuration -->
    <ItemGroup Condition="'$(Configuration)' == 'Release'">
	    <Content Include="../.env.Production" Condition="Exists('../.env.Production')">
		    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    </Content>
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Properties\" />
    </ItemGroup>

	<Target Name="CheckEnvFile" BeforeTargets="Build">
		<Warning Text="WARNING: .env file not found at ../.env.&#xA;This file is optional for Docker Deployments.&#xA;If you need environment-specific configuration, create this file." Condition="!Exists('../.env')" />
	</Target>

	<Target Name="CheckDevelopmentEnvFile" BeforeTargets="Build" Condition="'$(Configuration)' == 'Debug'">
		<Warning Text="WARNING: .env.Development file not found at ../.env.Development.&#xA;This file is optional for Docker Deployments.&#xA;If you need environment-specific configuration, create this file." Condition="!Exists('../.env.Development')" />
	</Target>

	<Target Name="CheckProductionEnvFile" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
		<Warning Text="WARNING: .env.Production file not found at ../.env.Production.&#xA;This file is optional for Docker Deployments.&#xA;If you need environment-specific configuration, create this file." Condition="!Exists('../.env.Production')" />
	</Target>

</Project>
