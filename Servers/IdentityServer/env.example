# Identity all-in-one TLS auto-renew example (Identity-only stack)
# Copy values into your deployed .env.All / .env.All.Docker files.

# Required by certbot renewer
LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_PRIMARY_DOMAIN=identity.example.com

# Optional SANs (comma-separated)
LETSENCRYPT_ADDITIONAL_DOMAINS=api.identity.example.com,management.identity.example.com

# Certbot renew loop cadence (hours)
CERTBOT_RENEW_INTERVAL_HOURS=12

# Certbot validation method:
# - dns-cloudflare (recommended)
# - webroot (legacy HTTP-01)
CERTBOT_AUTH_METHOD=dns-cloudflare

# Cloudflare DNS-01 credentials (host + container paths)
CF_DNS_API_CREDENTIALS_HOST_PATH=D:/Docker/Builds/IdentityServer/cloudflare.ini
CF_DNS_API_CREDENTIALS_FILE=/run/secrets/cloudflare.ini
CF_DNS_PROPAGATION_SECONDS=60

# Used only when CERTBOT_AUTH_METHOD=webroot.
CERTBOT_WEBROOT_PATH=/var/www/certbot

# Set true for Let's Encrypt staging while testing to avoid production rate limits.
CERTBOT_STAGING=false

# Certificate key type for newly issued certificates (rsa or ecdsa)
CERTBOT_KEY_TYPE=rsa

# Name of the Identity container restarted after successful renewal
IDENTITY_CONTAINER_NAME=identity-all-services

# Identity container certificate paths (inside container)
IDENTITY_SSL_CERT_CONTAINER_PATH=/etc/letsencrypt/live/identity.example.com/fullchain.pem
IDENTITY_SSL_KEY_CONTAINER_PATH=/etc/letsencrypt/live/identity.example.com/privkey.pem

# Linux host default Docker socket path for renewer hooks
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Database Configuration (update these values as needed)
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_USER=your_db_user
SQL_SERVER_PASSWORD=your_db_password
