# SSL Certificate Configuration
# Copy this file to .env and update the paths to your actual certificate files

# Path to your PFX certificate file (must include private key)
SSL_CERT_PFX_PATH=C:\path\to\your\certificate.pfx

# Database Configuration (update these values as needed)
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_USER=your_db_user
SQL_SERVER_PASSWORD=your_db_password

# Example certificate paths (uncomment and update as needed):
# SSL_CERT_PFX_PATH=C:\certificates\identity-server.pfx
# SSL_CERT_PFX_PATH=C:\Users\YourName\Documents\certificates\viking-identity.pfx
