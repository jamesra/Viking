{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PathBase": "/dataexport",
  "AppSettings": {
    "VolumeURL": "http://localhost",
    "ODataURL": "http://localhost/odata",
    "DefaultLocationColorMapsPath": "Resources/ColorMapping/DefaultLocationColorMap.txt",
    "DefaultStructureColorsPath": "Resources/ColorMapping/DefaultStructureColors.txt",
    "DefaultStructureTypeColorsPath": "Resources/ColorMapping/DefaultStructureTypeColors.txt",
    "XScaleValue": 2.18,
    "YScaleValue": 2.18,
    "ZScaleValue": 90,
    "XScaleUnits": "nm",
    "YScaleUnits": "nm",
    "ZScaleUnits": "nm"
  }
}



