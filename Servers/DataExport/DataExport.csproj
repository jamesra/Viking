<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>DataExport</RootNamespace>
    <AssemblyName>DataExport</AssemblyName>
    <Company>Microsoft</Company>
    <Product>DataExport - Viking Network Export Service</Product>
    <Copyright>Copyright © Microsoft 2014-2025</Copyright>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.OData.Client" Version="8.1.0" />
    <PackageReference Include="Microsoft.OData.Core" Version="8.1.0" />
    <PackageReference Include="Microsoft.OData.Edm" Version="8.1.0" />
    <PackageReference Include="Microsoft.Spatial" Version="8.1.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.6" />
    <PackageReference Include="System.Text.Json" Version="9.0.8" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Dot\*.*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Content\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Scripts\**\*.*" CopyToOutputDirectory="PreserveNewest" /> 
    <Content Include="SqlServerTypes\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Utils\*.*" />
    <Content Include="Controllers\*.*" />
    <Content Include="Output\*.*" />
    <Content Include="GlobalSuppressions.cs" />
    <Content Include="DataExport.Publish.xml" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ensure native SQL Server Types DLLs are copied to output -->
    <None Include="SqlServerTypes\x64\msvcr120.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="SqlServerTypes\x64\SqlServerSpatial140.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="SqlServerTypes\x86\msvcr120.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="SqlServerTypes\x86\SqlServerSpatial140.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\AnnotationVizLib\AnnotationVizLib.csproj" />
    <ProjectReference Include="..\..\AnnotationVizLibODataClient\AnnotationVizLibODataClient.csproj" />
    <ProjectReference Include="..\..\UnitsAndScale\UnitsAndScale.csproj" />
    <ProjectReference Include="..\WebAppSettings\VikingWebAppSettings.csproj" />
  </ItemGroup>
</Project>