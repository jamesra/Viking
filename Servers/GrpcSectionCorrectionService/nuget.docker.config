<?xml version="1.0" encoding="utf-8"?>
<!--
  Container-only NuGet config. The repo-root NuGet.Config lists Windows-only
  local sources that do not exist inside the Linux build container.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
