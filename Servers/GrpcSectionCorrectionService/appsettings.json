{
  "ConnectionStrings": {
    "IdentityConnection": ""
  },
  "AnnotationConnections": {
  },
  "AnnotationConnectionTemplate": "",
  "IdentityServer": {
    "Endpoint": "",
    "ApiEndpoint": "",
    "ClientId": "correction",
    "ClientSecret": "",
    "AllowHttpMetadata": "true"
  },
  "CorrectionService": {
    "Name": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Corrections": {
    "RootDirectory": "",
    "CachePath": ""
  },
  "Rebuild": {
    "RunOnStartup": true,
    "Cron": "0 2 * * 0",
    "CheckInterval": "24:00:00",
    "QuietMinutes": 60,
    "MaxIncrementalFraction": 0.3,
    "StosGroups": null,
    "Force": false,
    "SkipQuiver": false,
    "MinLocations": 3
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  }
}
