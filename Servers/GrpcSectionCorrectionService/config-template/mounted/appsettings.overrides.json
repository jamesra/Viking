{
  "IdentityServer": {
    "Endpoint": "https://identity.codepharm.net:5001/",
    "ApiEndpoint": "https://identity.codepharm.net:6001/",
    "ClientId": "correction",
    "ClientSecret": "REPLACE_WITH_CORRECTION_SERVICE_CLIENT_SECRET"
  },
  "CorrectionService": {
    "Name": "REPLACE_WITH_CORRECTION_SERVICE_NAME"
  },
  "AnnotationConnections": {
