<?xml version="1.0" encoding="utf-8"?>
<!--
  Container only NuGet config. The repo root NuGet.Config lists local Windows only
  sources (a Visual Studio offline packages folder and a local Packages folder) that
  don't exist inside the Linux build container. This file restricts restore to
  nuget.org so dotnet restore/build/publish (via configfile) succeeds during the
  Docker build stage.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
